---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base
  title='Volunteer — Skovgard 2026'
  description='Join the Skovgard 2026 campaign. Help shape Wyoming&apos;s future.'
>
  <Nav />
  <main class='pt-24 pb-20 px-4'>
    <div class='max-w-4xl mx-auto'>
      <p class='text-wy-gold font-semibold uppercase tracking-wider text-sm mb-2'>Get Involved</p>
      <h1 class='text-5xl font-serif font-bold text-wy-navy mb-4'>Volunteer</h1>
      <p class='text-gray-600 text-lg mb-10 max-w-2xl'>
        Want to help shape Wyoming&apos;s future? We are looking for passionate folks to step up. Tell us your story.
      </p>

      <!-- What volunteers do -->
      <div class='grid sm:grid-cols-3 gap-6 mb-12'>
        {[
          { icon: '🚪', title: 'Door Knocking', desc: 'Meet neighbors, share Jimmy&apos;s story, and build real connections.' },
          { icon: '📞', title: 'Phone Banking', desc: 'Call Wyoming voters from home on your own schedule.' },
          { icon: '📣', title: 'Events', desc: 'Help set up, run, and staff campaign events across the state.' },
        ].map(item => (
          <div class='bg-wy-stone rounded-xl p-6 text-center'>
            <div class='text-4xl mb-3'>{item.icon}</div>
            <h3 class='font-serif font-bold text-wy-navy mb-2'>{item.title}</h3>
            <p class='text-gray-600 text-sm'>{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Google Form embed -->
      <div class='bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100'>
        <iframe
          src='https://docs.google.com/forms/d/e/1FAIpQLSemnMIgLkz6G6usbjFibAmjmyhua-9bVv5cNHaE2q8YFnXwvg/viewform?embedded=true'
          width='100%'
          height='2800'
          frameborder='0'
          marginheight='0'
          marginwidth='0'
          title='Volunteer Sign-Up Form'
        >
          Loading&hellip;
        </iframe>
      </div>
    </div>
  </main>
</Base>
