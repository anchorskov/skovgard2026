---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title='Privacy Policy — Skovgard 2026' description='Privacy Policy for Skovgard for Senate campaign.'>
  <Nav />
  <main class='pt-24 pb-20 px-4'>
    <div class='max-w-3xl mx-auto prose prose-headings:font-serif prose-headings:text-wy-navy prose-a:text-wy-gold'>
      <h1>Privacy Policy</h1>
      <p class='text-gray-500 text-sm'>Effective Date: September 3, 2025 &mdash; Last updated: June 28, 2026</p>
      <p>Skovgard for Senate respects your privacy. This Privacy Policy explains how we collect, use, and protect your information.</p>
      <h2>Information We Collect</h2>
      <ul>
        <li>Contact information you provide directly (name, email, phone, address).</li>
        <li>Voter registration data provided by the State of Wyoming.</li>
        <li>Communications you have with our campaign, including SMS/text messages.</li>
      </ul>
      <h2>How We Use Your Information</h2>
      <ul>
        <li>To send you campaign updates, election information, and volunteer opportunities.</li>
        <li>To respond to your questions or requests.</li>
        <li>To comply with election law and reporting requirements.</li>
      </ul>
      <h2>Sharing Your Information</h2>
      <p>We <strong>do not sell or share</strong> your personal information with third parties for commercial purposes. Information may be shared only with trusted service providers who support our campaign operations, and only for campaign-related use.</p>
      <p>Mobile opt-in data and SMS consent will not be shared with third parties for promotional or marketing purposes.</p>
      <h2>Bot Protection &mdash; Cloudflare Turnstile</h2>
      <p>
        Some pages on this site use <strong>Cloudflare Turnstile</strong>, an invisible security service that verifies
        visitors are human without displaying a visible CAPTCHA. Turnstile runs silently in the background. It does not
        use cookies for verification purposes and does not collect personal information on our behalf.
      </p>
      <p>
        By using pages on this site that are protected by Turnstile, you acknowledge that Cloudflare may process
        certain technical signals from your browser in accordance with the
        <a href='https://www.cloudflare.com/en-gb/turnstile-privacy-policy/' target='_blank' rel='noopener'>
          Cloudflare Turnstile Privacy Addendum
        </a>.
      </p>
      <h2>Your Choices</h2>
      <ul>
        <li>You may opt out of SMS/text messages at any time by replying <strong>STOP</strong>.</li>
        <li>You may request to update or delete your contact information by emailing <strong>skovgard2026@gmail.com</strong>.</li>
      </ul>
      <h2>Security</h2>
      <p>We take reasonable steps to protect your information from unauthorized access, loss, or misuse.</p>
      <h2>Contact</h2>
      <p>Skovgard for Senate &middot; 5685 Hanly Mills Wy, Casper, WY 82604 &middot; skovgard2026@gmail.com</p>
    </div>
  </main>
  <Footer />
</Base>
