---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Term Limits Pledge — Skovgard 2026"
  description="Jimmy Skovgard's signed term limits pledge. Action, not talk."
>
  <Nav />
  <main class="pt-24 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-2">Accountability</p>
      <h1 class="text-5xl font-serif font-bold text-wy-navy mb-10">Term Limits Pledge</h1>
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100 mb-10">
        <img
          src="/images/Jimmy_Term_Limit_Pledge.jpg"
          alt="Jimmy Skovgard's signed term limits pledge"
          class="w-full"
        />
      </div>
      <a href="/" class="text-wy-gold font-semibold hover:underline">← Back to Home</a>
    </div>
  </main>
  <Footer />
</Base>
