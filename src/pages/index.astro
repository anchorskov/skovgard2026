---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CANDIDATES_BASE_URL, MEDIA_BASE_URL } from '../constants';
---
<Base
  title="Jimmy Skovgard — U.S. Senate 2026"
  description="Citizens defend the Constitution. Wyoming deserves a Senator who defends it too. Jimmy Skovgard for U.S. Senate 2026."
>
  <Nav />

  <!-- HERO -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background-image: url('/images/winter-journey-to-skovgard-2026.png'); background-size: cover; background-position: center top;"
  >
    <!-- Overlay — charcoal wash lets the landscape breathe -->
    <div class="absolute inset-0 bg-wy-charcoal/60"></div>
    <!-- Bottom gradient so the horizon line reads cleanly into the page -->
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-wy-bone/80"></div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <p class="text-wy-sandstone font-semibold tracking-[0.22em] uppercase text-xs sm:text-sm mb-5">
        · Citizens Defend the Constitution ·
      </p>
      <h1 class="text-5xl sm:text-7xl font-serif font-extrabold text-wy-bone leading-[1.05] mb-6">
        Wyoming Deserves a Senator<br/>
        <span class="text-wy-ember">Who Defends the Constitution.</span>
      </h1>
      <p class="text-wy-bone/85 text-xl mb-10 max-w-2xl mx-auto">
        The oath still matters. Wyoming deserves accountability, local control, and action.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="border-2 border-wy-ember bg-wy-ember/10 text-wy-ember font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-ember/20 transition-colors">
          Support Jimmy
        </a>
        <a href="/volunteer" class="border-2 border-wy-bone bg-wy-bone/10 text-wy-bone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-bone/20 transition-colors">
          Volunteer
        </a>
        <a href={CANDIDATES_BASE_URL} data-candidates-link target="_blank" rel="noopener" class="border-2 border-wy-sandstone bg-wy-sandstone/10 text-wy-sandstone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-sandstone/20 transition-colors">
          My Ballot
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-wy-bone/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Topographic divider — frontier accent between hero and about strip -->
  <div class="bg-wy-bone py-6 px-4">
    <div class="max-w-5xl mx-auto">
      <hr class="topo-rule" />
    </div>
  </div>

  <!-- ABOUT STRIP -->
  <section class="bg-wy-bone py-20 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-wy-sandstone font-semibold uppercase tracking-[0.18em] text-sm mb-3">About Jimmy</p>
        <h2 class="text-4xl font-serif font-extrabold text-wy-charcoal mb-6">In Service to Wyoming</h2>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I'm Jimmy Skovgard, a small businessman, citizen soldier, and neighbor. I know Wyoming because this is home.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I took an oath to support and defend the Constitution, and I am ready to elevate your voice and help guide Wyoming back to its true conservative center.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I carry forward a family legacy of service to Wyoming, a legacy that now calls all of us to stand together for our Constitution and our way of life.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-6">
          I'm running to bring integrity, accountability, and a clear Wyoming voice to the United States Senate.
        </p>
        <a href="/about" class="text-wy-ember font-semibold hover:text-wy-ember-dark hover:underline">Read Jimmy's Story →</a>
      </div>
      <div class="rounded-sm overflow-hidden shadow-2xl shadow-wy-charcoal/20 border-4 border-wy-dust">
        <img src="/images/jimmy.png" alt="Jimmy Skovgard" class="w-full h-80 object-cover object-top" />
      </div>
    </div>
  </section>

  <!-- FEATURED MESSAGE VIDEO -->
  <section class="bg-wy-navy py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-wy-sandstone font-semibold uppercase tracking-wider text-sm mb-3">Latest Message</p>
      <h2 class="text-4xl font-serif font-bold text-white mb-4">Wyoming Is Not for Sale</h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl">
        Out-of-state PACs. Dark money. National templates. Wyoming citizens deserve to know who is paying for the message. Follow the money.
      </p>
      <!-- Video player -->
      <div class="w-full rounded-sm overflow-hidden shadow-2xl shadow-black/40 mb-10">
        <video
          controls
          preload="metadata"
          class="w-full block"
          style="max-height: 540px; background: #000;"
        >
          <source src={`${MEDIA_BASE_URL}/videos/wyoming-not-for-sale.mp4`} type="video/mp4" />
        </video>
      </div>
      <!-- Meta + context + CTA -->
      <div class="flex flex-col md:flex-row gap-10 items-start">
        <div class="flex-1">
          <p class="text-wy-sandstone font-bold text-sm uppercase tracking-[0.18em] mb-2">June 2026 · Video</p>
          <h3 class="text-2xl font-serif font-extrabold text-wy-bone mb-3">Wyoming Is Not for Sale</h3>
          <p class="text-wy-bone/70 text-lg leading-relaxed mb-8">
            When outside money buys the megaphone, Wyoming citizens deserve to know who is speaking, who is paying, and who benefits.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/share/wyoming-not-for-sale" class="inline-block bg-wy-ember text-wy-bone font-bold px-6 py-3 rounded-sm tracking-wide hover:bg-wy-ember-dark transition-colors shadow-sm">
              Watch &amp; Share →
            </a>
            <a href="/share" class="inline-block border-2 border-wy-bone/40 text-wy-bone font-bold px-6 py-3 rounded-sm hover:border-wy-bone transition-colors">
              Choose another message
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST PODCAST — populated client-side from /api/podcast-feed -->
  <section class="bg-wy-stone py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-3">On the Record</p>
      <h2 class="text-4xl font-serif font-bold text-wy-navy mb-10">Listen to Jimmy</h2>
      <div id="otr-grid" class="grid md:grid-cols-2 gap-6">
        <!-- skeleton cards while feed loads -->
        <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust animate-pulse">
          <div class="h-3 bg-wy-dust/50 rounded w-1/3 mb-3"></div>
          <div class="h-5 bg-wy-dust/50 rounded w-3/4 mb-2"></div>
          <div class="h-4 bg-wy-dust/30 rounded w-full mb-1"></div>
          <div class="h-4 bg-wy-dust/30 rounded w-5/6"></div>
        </div>
        <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust animate-pulse">
          <div class="h-3 bg-wy-dust/50 rounded w-1/3 mb-3"></div>
          <div class="h-5 bg-wy-dust/50 rounded w-3/4 mb-2"></div>
          <div class="h-4 bg-wy-dust/30 rounded w-full mb-1"></div>
          <div class="h-4 bg-wy-dust/30 rounded w-5/6"></div>
        </div>
      </div>
      <div id="otr-older-row" class="mt-6 hidden">
        <p class="text-xs text-wy-charcoal/50 uppercase tracking-widest mb-3 font-semibold">Older Videos</p>
        <div id="otr-older-chips" class="flex flex-wrap gap-2"></div>
      </div>
      <div class="mt-8 text-center">
        <a href="/podcast" class="text-wy-charcoal font-semibold border-b-2 border-wy-ember pb-1 hover:text-wy-ember transition-colors">
          All Episodes →
        </a>
      </div>
    </div>
  </section>

  <Footer />

</Base>

<script>
(function () {
  const grid = document.getElementById('otr-grid');
  const olderRow = document.getElementById('otr-older-row');
  const olderChips = document.getElementById('otr-older-chips');
  if (!grid) return;

  function fmtDate(rfc) {
    try { return new Date(rfc).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); }
    catch (_) { return rfc || ''; }
  }

  function fmtISODate(iso) {
    try { return new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); }
    catch (_) { return iso || ''; }
  }

  function parseMeta(summary) {
    try { return typeof summary === 'string' && summary.startsWith('{') ? JSON.parse(summary) : { title: summary, slug: null, duration: null }; }
    catch (_) { return { title: summary, slug: null, duration: null }; }
  }

  function substackCard(ep) {
    const isAudio = ep.audio && !ep.audio.endsWith('.mp4');
    return `
      <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust flex flex-col justify-between">
        <div>
          <p class="text-sm text-wy-charcoal/50 mb-2">${fmtDate(ep.date)}${ep.duration ? ' · ' + ep.duration : ''}</p>
          <h3 class="font-serif font-extrabold text-wy-charcoal text-xl mb-3">
            <a href="${ep.link}" target="_blank" rel="noopener" class="hover:text-wy-ember transition-colors">${ep.title}</a>
          </h3>
          ${ep.description ? `<p class="text-wy-charcoal/70 mb-4 text-sm">${ep.description}</p>` : ''}
        </div>
        ${isAudio ? `<audio controls class="w-full rounded mt-2" preload="none"><source src="${ep.audio}" type="audio/mpeg" /></audio>` : ''}
        <a href="${ep.link}" target="_blank" rel="noopener"
           class="mt-4 inline-block text-sm font-semibold text-wy-sandstone hover:text-wy-ember hover:underline">
          Listen on Substack →
        </a>
      </div>`;
  }

  function campaignCard(ep) {
    const meta = parseMeta(ep.summary);
    const title = meta.title || ep.guest_slug;
    const slug = meta.slug;
    const dur = meta.duration;
    return `
      <div id="otr-campaign-card" class="bg-white rounded-sm shadow-md border border-wy-dust flex flex-col overflow-hidden">
        <video controls preload="none" class="w-full block bg-black" style="max-height:280px">
          <source src="${ep.url}" type="video/mp4" />
        </video>
        <div class="p-5 flex flex-col flex-1 justify-between">
          <div>
            <p class="text-xs text-wy-charcoal/50 mb-1">${fmtISODate(ep.episode_date)}${dur ? ' · ' + dur : ''} · Campaign</p>
            <h3 class="font-serif font-extrabold text-wy-charcoal text-lg mb-2 leading-snug">${title}</h3>
          </div>
          ${slug ? `<a href="/share/${slug}" class="mt-2 inline-block text-sm font-semibold text-wy-sandstone hover:text-wy-ember hover:underline">Watch &amp; Share →</a>` : ''}
        </div>
      </div>`;
  }

  function chipLabel(ep) {
    const meta = parseMeta(ep.summary);
    const title = meta.title || ep.guest_slug;
    const dur = meta.duration;
    const d = new Date(ep.episode_date + 'T12:00:00Z');
    const shortDate = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    return `${shortDate} · ${title}${dur ? ' (' + dur + ')' : ''}`;
  }

  Promise.all([
    fetch('/api/podcast-feed').then(r => r.ok ? r.json() : Promise.reject()),
    fetch('/api/podcasts').then(r => r.ok ? r.json() : Promise.reject()),
  ]).then(([feedData, podcastData]) => {
    const substackEp = (feedData.episodes || [])[0];
    const campaignVids = (podcastData.episodes || []).filter(e => e.guest_slug === 'campaign');
    // campaignVids[0] is already shown in the Featured Message Video section above — skip it
    const slotVids = campaignVids.slice(1);
    const featured = slotVids[0];
    const older = slotVids.slice(1);

    const slot1 = substackEp
      ? substackCard(substackEp)
      : '<div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust"><p class="text-wy-charcoal/50 text-sm">No recent posts.</p></div>';

    grid.innerHTML = slot1 + (featured ? campaignCard(featured) : '');

    if (older.length > 0 && olderRow && olderChips) {
      olderChips.innerHTML = older.map((v, i) =>
        `<button class="text-xs px-3 py-1.5 rounded border border-wy-dust bg-white text-wy-charcoal/70 hover:border-wy-ember hover:text-wy-ember transition-colors font-semibold whitespace-nowrap" data-idx="${i}">${chipLabel(v)}</button>`
      ).join('');
      olderRow.classList.remove('hidden');

      olderChips.addEventListener('click', function (e) {
        const btn = e.target.closest('button[data-idx]');
        if (!btn) return;
        const ep = older[parseInt(btn.dataset.idx, 10)];
        if (!ep) return;
        const card = document.getElementById('otr-campaign-card');
        if (card) {
          const tmp = document.createElement('div');
          tmp.innerHTML = campaignCard(ep);
          card.parentNode.replaceChild(tmp.firstElementChild, card);
        }
      });
    }
  }).catch(() => {
    grid.innerHTML = `
      <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust col-span-2 text-center">
        <p class="text-wy-charcoal/60 mb-3">Visit Substack for the latest episodes.</p>
        <a href="https://jimskovgard.substack.com/" target="_blank" rel="noopener"
           class="text-wy-ember font-semibold hover:underline">Open Substack →</a>
      </div>`;
  });
})();
</script>
