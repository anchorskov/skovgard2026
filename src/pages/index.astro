---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { MEDIA_BASE_URL } from '../constants';
---
<Base
  title="Jimmy Skovgard — U.S. Senate 2026"
  description="Citizens defend the Constitution. Wyoming deserves a Senator who defends it too. Jimmy Skovgard for U.S. Senate 2026."
>
  <Nav />

  <!-- HERO -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background-image: url('/images/winter-journey-to-skovgard-2026.png'); background-size: cover; background-position: center top;"
  >
    <!-- Overlay — charcoal wash lets the landscape breathe -->
    <div class="absolute inset-0 bg-wy-charcoal/60"></div>
    <!-- Bottom gradient so the horizon line reads cleanly into the page -->
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-wy-bone/80"></div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <p class="text-wy-sandstone font-semibold tracking-[0.22em] uppercase text-xs sm:text-sm mb-5">
        · Citizens Defend the Constitution ·
      </p>
      <h1 class="text-5xl sm:text-7xl font-serif font-extrabold text-wy-bone leading-[1.05] mb-6">
        Wyoming Deserves a Senator<br/>
        <span class="text-wy-ember">Who Defends the Constitution.</span>
      </h1>
      <p class="text-wy-bone/85 text-xl mb-10 max-w-2xl mx-auto">
        The oath still matters. Wyoming deserves accountability, local control, and action.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="bg-wy-ember text-wy-bone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-ember-dark transition-colors shadow-lg shadow-wy-charcoal/40">
          Support Jimmy
        </a>
        <a href="/volunteer" class="border-2 border-wy-bone text-wy-bone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-bone/10 transition-colors">
          Volunteer
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-wy-bone/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Topographic divider — frontier accent between hero and about strip -->
  <div class="bg-wy-bone py-6 px-4">
    <div class="max-w-5xl mx-auto">
      <hr class="topo-rule" />
    </div>
  </div>

  <!-- ABOUT STRIP -->
  <section class="bg-wy-bone py-20 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-wy-sandstone font-semibold uppercase tracking-[0.18em] text-sm mb-3">About Jimmy</p>
        <h2 class="text-4xl font-serif font-extrabold text-wy-charcoal mb-6">In Service to Wyoming</h2>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I'm Jimmy Skovgard, a small businessman, citizen soldier, and neighbor. I know Wyoming because this is home.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I took an oath to support and defend the Constitution, and I am ready to elevate your voice and help guide Wyoming back to its true conservative center.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I carry forward a family legacy of service to Wyoming, a legacy that now calls all of us to stand together for our Constitution and our way of life.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-6">
          I'm running to bring integrity, accountability, and a clear Wyoming voice to the United States Senate.
        </p>
        <a href="/about" class="text-wy-ember font-semibold hover:text-wy-ember-dark hover:underline">Read Jimmy's Story →</a>
      </div>
      <div class="rounded-sm overflow-hidden shadow-2xl shadow-wy-charcoal/20 border-4 border-wy-dust">
        <img src="/images/jimmy.png" alt="Jimmy Skovgard" class="w-full h-80 object-cover object-top" />
      </div>
    </div>
  </section>

  <!-- FEATURED MESSAGE VIDEO -->
  <section class="bg-wy-navy py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-wy-sandstone font-semibold uppercase tracking-wider text-sm mb-3">Featured Message</p>
      <h2 class="text-4xl font-serif font-bold text-white mb-4">Citizens Defend the Constitution</h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl">
        A short Wyoming message with Heart Mountain as the backdrop — the Golden Rule, and the three pillars of this campaign: defend the Constitution, restore accountability, and listen to Wyoming.
      </p>
      <!-- Video player -->
      <div class="w-full rounded-sm overflow-hidden shadow-2xl shadow-black/40 mb-10">
        <video
          controls
          preload="metadata"
          class="w-full block"
          style="max-height: 540px; background: #000;"
        >
          <source src={`${MEDIA_BASE_URL}/videos/Jimmy_6-14.mp4`} type="video/mp4" />
        </video>
      </div>
      <!-- Meta + context + CTA -->
      <div class="flex flex-col md:flex-row gap-10 items-start">
        <div class="flex-1">
          <p class="text-wy-sandstone font-bold text-sm uppercase tracking-[0.18em] mb-2">June 2026 · Video · 4:54</p>
          <h3 class="text-2xl font-serif font-extrabold text-wy-bone mb-3">Three Pillars of the Campaign</h3>
          <p class="text-wy-bone/70 text-lg leading-relaxed mb-8">
            Citizens defend the Constitution. Public servants swear the oath.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/volunteer" class="inline-block bg-wy-ember text-wy-bone font-bold px-6 py-3 rounded-sm tracking-wide hover:bg-wy-ember-dark transition-colors shadow-sm">
              Get Involved →
            </a>
            <a href="/podcast" class="inline-block border-2 border-wy-bone/40 text-wy-bone font-bold px-6 py-3 rounded-sm hover:border-wy-bone transition-colors">
              All Episodes
            </a>
            <button
              id="share-pillars-btn"
              class="inline-flex items-center gap-2 border-2 border-wy-bone/40 text-wy-bone font-bold px-6 py-3 rounded-sm hover:border-wy-bone transition-colors cursor-pointer bg-transparent"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span id="share-pillars-label">Share</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST PODCAST -->
  <section class="bg-wy-stone py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-3">On the Record</p>
      <h2 class="text-4xl font-serif font-bold text-wy-navy mb-10">Listen to Jimmy</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Featured episode card -->
        <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust">
          <p class="text-sm text-wy-charcoal/50 mb-2">Jan 25, 2026 · 38 min</p>
          <h3 class="font-serif font-extrabold text-wy-charcoal text-xl mb-3">Jack Daniels &amp; Jimmy: Wyoming Politics</h3>
          <p class="text-wy-charcoal/70 mb-4">An unscripted conversation about what's really going on in Cheyenne and Washington.</p>
          <audio controls class="w-full rounded" preload="none">
            <source src={`${MEDIA_BASE_URL}/jack-daniels/2026-01-25/Jack_Daniels_Jimmy_Skovgard_R2.mp3`} type="audio/mpeg" />
          </audio>
          <a
            href={`${MEDIA_BASE_URL}/jack-daniels/2026-01-25/Jack_Daniels_Jimmy_Skovgard_R2.mp3`}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-block text-sm font-semibold text-wy-sandstone hover:text-wy-ember hover:underline"
          >
            Open audio directly
          </a>
        </div>
        <div class="bg-white rounded-sm p-6 shadow-md border border-wy-dust flex flex-col justify-between">
          <div>
            <p class="text-sm text-wy-charcoal/50 mb-2">Mar 20, 2026 · YouTube</p>
            <h3 class="font-serif font-extrabold text-wy-charcoal text-xl mb-3">Jimmy &amp; Kevin: Real Wyoming Issues</h3>
            <p class="text-wy-charcoal/70 mb-4">Live conversation diving into water rights, federal land use, and rural healthcare.</p>
          </div>
          <a href="https://youtu.be/yiqVj_xtO7Q?t=156" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 text-wy-ember font-semibold hover:text-wy-ember-dark hover:underline">
            Watch on YouTube →
          </a>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/podcast" class="text-wy-charcoal font-semibold border-b-2 border-wy-ember pb-1 hover:text-wy-ember transition-colors">
          All Episodes →
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const btn = document.getElementById('share-pillars-btn');
    const label = document.getElementById('share-pillars-label');
    btn?.addEventListener('click', async () => {
      const shareData = {
        title: 'Citizens Defend the Constitution',
        text: 'Citizens defend the Constitution. Public servants swear the oath. — Jimmy Skovgard for U.S. Senate 2026',
        url: 'https://skovgard2026.org/share/citizens-defend-the-constitution/',
      };
      if (navigator.share) {
        try { await navigator.share(shareData); } catch (_) {}
      } else {
        await navigator.clipboard.writeText(shareData.url);
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Share'; }, 2000);
        }
      }
    });
  </script>
</Base>
