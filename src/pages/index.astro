---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { MEDIA_BASE_URL } from '../constants';
---
<Base
  title="Jimmy Skovgard — U.S. Senate 2026"
  description="Citizens defend the Constitution. Wyoming deserves a Senator who defends it too. Jimmy Skovgard for U.S. Senate 2026."
>
  <Nav />

  <!-- HERO -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background-image: url('/images/winter-journey-to-skovgard-2026.png'); background-size: cover; background-position: center top;"
  >
    <!-- Overlay — charcoal wash lets the landscape breathe -->
    <div class="absolute inset-0 bg-wy-charcoal/60"></div>
    <!-- Bottom gradient so the horizon line reads cleanly into the page -->
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-wy-bone/80"></div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <p class="text-wy-sandstone font-semibold tracking-[0.22em] uppercase text-xs sm:text-sm mb-5">
        · Citizens Defend the Constitution ·
      </p>
      <h1 class="text-5xl sm:text-7xl font-serif font-extrabold text-wy-bone leading-[1.05] mb-6">
        Wyoming Deserves a Senator<br/>
        <span class="text-wy-ember">Who Defends the Constitution.</span>
      </h1>
      <p class="text-wy-bone/85 text-xl mb-10 max-w-2xl mx-auto">
        The oath still matters. Wyoming deserves accountability, local control, and action.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="border-2 border-wy-ember bg-wy-ember/10 text-wy-ember font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-ember/20 transition-colors">
          Support Jimmy
        </a>
        <a href="/updates" class="border-2 border-wy-bone bg-wy-bone/10 text-wy-bone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-bone/20 transition-colors">
          Get Updates
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-wy-bone/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Topographic divider — frontier accent between hero and about strip -->
  <div class="bg-wy-bone py-6 px-4">
    <div class="max-w-5xl mx-auto">
      <hr class="topo-rule" />
    </div>
  </div>

  <!-- ABOUT STRIP -->
  <section class="bg-wy-bone py-20 px-4">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-wy-sandstone font-semibold uppercase tracking-[0.18em] text-sm mb-3">About Jimmy</p>
        <h2 class="text-4xl font-serif font-extrabold text-wy-charcoal mb-6">In Service to Wyoming</h2>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I'm Jimmy Skovgard, a small businessman, citizen soldier, and neighbor. I know Wyoming because this is home.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I took an oath to support and defend the Constitution, and I am ready to elevate your voice and help guide Wyoming back to its true conservative center.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-4">
          I carry forward a family legacy of service to Wyoming, a legacy that now calls all of us to stand together for our Constitution and our way of life.
        </p>
        <p class="text-wy-charcoal/80 text-lg leading-relaxed mb-6">
          I'm running to bring integrity, accountability, and a clear Wyoming voice to the United States Senate.
        </p>
        <a href="/about" class="text-wy-ember font-semibold hover:text-wy-ember-dark hover:underline">Read Jimmy's Story →</a>
      </div>
      <div class="rounded-sm overflow-hidden shadow-2xl shadow-wy-charcoal/20 border-4 border-wy-dust">
        <img src="/images/jimmy.png" alt="Jimmy Skovgard" class="w-full h-80 object-cover object-top" />
      </div>
    </div>
  </section>

  <!-- LATEST FROM JIMMY — featured video + more to hear, one consolidated section -->
  <section class="bg-wy-navy py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-wy-sandstone font-semibold uppercase tracking-wider text-sm mb-3">Latest From Jimmy</p>
      <h2 class="text-4xl font-serif font-bold text-white mb-4">An Oath Is Not a Loyalty Pledge</h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl">
        Public office is a public trust. An oath belongs to the Constitution and the citizens, not a political machine, powerful donor, party leader, or president.
      </p>
      <!-- Video player -->
      <div class="w-full rounded-sm overflow-hidden shadow-2xl shadow-black/40 mb-10">
        <video
          controls
          preload="metadata"
          class="w-full block"
          style="max-height: 540px; background: #000;"
        >
          <source src={`${MEDIA_BASE_URL}/videos/an-oath-is-not-a-loyalty-pledge.mp4`} type="video/mp4" />
        </video>
      </div>
      <!-- Meta + context + CTA -->
      <div class="flex flex-col md:flex-row gap-10 items-start mb-12">
        <div class="flex-1">
          <p class="text-wy-sandstone font-bold text-sm uppercase tracking-[0.18em] mb-2">July 2026 · Video</p>
          <h3 class="text-2xl font-serif font-extrabold text-wy-bone mb-3">An Oath Is Not a Loyalty Pledge</h3>
          <p class="text-wy-bone/70 text-lg leading-relaxed mb-8">
            Jimmy explains why independent judgment, honest oversight, and the courage to question power still matter.
          </p>
          <a href="/updates" class="inline-block bg-wy-ember text-wy-bone font-bold px-6 py-3 rounded-sm tracking-wide hover:bg-wy-ember-dark transition-colors shadow-sm">
            Get Updates Like This →
          </a>
        </div>
      </div>

      <!-- More to hear — populated client-side from /api/podcast-feed + /api/podcasts -->
      <div class="pt-8 border-t border-wy-bone/10">
        <p class="text-xs text-wy-bone/40 uppercase tracking-widest mb-4 font-semibold">More to hear</p>
        <div id="otr-grid" class="flex flex-wrap gap-3">
          <!-- skeleton chips while feed loads -->
          <div class="h-14 w-48 bg-wy-bone/10 rounded-sm animate-pulse"></div>
          <div class="h-14 w-48 bg-wy-bone/10 rounded-sm animate-pulse"></div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a href="/podcast" class="text-wy-bone font-semibold border-b-2 border-wy-ember pb-1 hover:text-wy-sandstone transition-colors">
          All Episodes →
        </a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="bg-wy-bone border-t border-wy-dust py-20 px-4 text-center">
    <div class="max-w-xl mx-auto">
      <p class="text-wy-sandstone font-semibold uppercase tracking-[0.18em] text-sm mb-3">Ready to help?</p>
      <h2 class="text-3xl sm:text-4xl font-serif font-extrabold text-wy-charcoal mb-4">One campaign, one Wyoming.</h2>
      <p class="text-wy-charcoal/70 text-lg mb-8">
        Every dollar and every hour goes straight to reaching voters — no machine, no mega-donors, just neighbors talking to neighbors.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/donate" class="bg-wy-ember text-wy-bone font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-ember-dark transition-colors shadow-sm">
          Support Jimmy
        </a>
        <a href="/volunteer" class="border-2 border-wy-charcoal text-wy-charcoal font-bold px-8 py-4 rounded-sm text-lg tracking-wide hover:bg-wy-charcoal hover:text-wy-bone transition-colors">
          Volunteer Instead
        </a>
      </div>
    </div>
  </section>

  <Footer />

</Base>

<script>
(function () {
  const grid = document.getElementById('otr-grid');
  if (!grid) return;

  function parseMeta(summary) {
    try { return typeof summary === 'string' && summary.startsWith('{') ? JSON.parse(summary) : { title: summary, slug: null, duration: null }; }
    catch (_) { return { title: summary, slug: null, duration: null }; }
  }

  const chipClasses = 'flex flex-col gap-0.5 bg-white rounded-sm border border-wy-dust px-4 py-3 min-w-[12rem] flex-1 hover:border-wy-ember transition-colors';

  function substackChip(ep) {
    const d = ep.date ? new Date(ep.date) : null;
    const dateLabel = d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
    return `
      <a href="${ep.link}" target="_blank" rel="noopener" class="${chipClasses}">
        <span class="text-xs text-wy-sandstone font-semibold">${dateLabel} · Substack</span>
        <span class="text-sm font-semibold text-wy-charcoal">${ep.title}</span>
      </a>`;
  }

  function campaignChip(ep) {
    const meta = parseMeta(ep.summary);
    const title = meta.title || ep.guest_slug;
    const d = new Date(ep.episode_date + 'T12:00:00Z');
    const dateLabel = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    // Links to /podcast rather than /share/<slug> — this row is pulled live from
    // the API, so we can't assume a hand-built /share page exists for every video
    // (only the featured one above is curated to guarantee a matching share page).
    return `
      <a href="/podcast" class="${chipClasses}">
        <span class="text-xs text-wy-sandstone font-semibold">${dateLabel}${meta.duration ? ' · ' + meta.duration : ''} · Campaign</span>
        <span class="text-sm font-semibold text-wy-charcoal">${title}</span>
      </a>`;
  }

  Promise.all([
    fetch('/api/podcast-feed').then(r => r.ok ? r.json() : Promise.reject()),
    fetch('/api/podcasts').then(r => r.ok ? r.json() : Promise.reject()),
  ]).then(([feedData, podcastData]) => {
    const substackEp = (feedData.episodes || [])[0];
    const campaignVids = (podcastData.episodes || []).filter(e => e.guest_slug === 'campaign');
    // campaignVids[0] is already shown in the featured video above — skip it
    const rest = campaignVids.slice(1);

    const chips = [];
    if (substackEp) chips.push(substackChip(substackEp));
    rest.forEach(ep => chips.push(campaignChip(ep)));

    grid.innerHTML = chips.length
      ? chips.join('')
      : '<p class="text-wy-bone/50 text-sm">No additional episodes yet.</p>';
  }).catch(() => {
    grid.innerHTML = `
      <a href="https://jimskovgard.substack.com/" target="_blank" rel="noopener" class="${chipClasses}">
        <span class="text-sm font-semibold text-wy-charcoal">Visit Substack for the latest episodes →</span>
      </a>`;
  });
})();
</script>
