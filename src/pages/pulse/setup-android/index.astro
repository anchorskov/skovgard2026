---
// src/pages/pulse/setup-android/index.astro
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<Base
  title="Pulse Setup – Android — Skovgard 2026"
  description="How to set up the Pulse texting circle on Android — save the number, forward campaign updates, and keep it personal."
>
  <Nav />
  <main class="pt-24 pb-20 px-4">
    <div class="max-w-2xl mx-auto">

      <!-- Header -->
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-2">Pulse Texting Circle</p>
      <h1 class="text-4xl font-serif font-bold text-wy-navy mb-4">Pulse Setup — Android</h1>
      <p class="text-gray-600 text-lg mb-8">
        Four quick steps to get your Android phone set up for the Pulse texting circle.
        Once you're set up, you'll receive campaign updates and forward them to people you trust in Wyoming.
      </p>

      <!-- Steps -->
      <ol class="space-y-8 mb-12">

        <!-- Step 1 -->
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-wy-navy text-wy-gold font-bold flex items-center justify-center text-lg mt-1">1</span>
          <div>
            <h2 class="text-xl font-serif font-bold text-wy-navy mb-2">Sign Up</h2>
            <p class="text-gray-600 mb-3">
              First, opt in to receive campaign texts. This signs you up to be a Pulse forwarder.
            </p>
            <a
              href="/pulse/signup/"
              class="inline-block bg-wy-gold text-wy-navy font-bold px-5 py-2 rounded hover:bg-amber-400 transition-colors text-sm"
            >
              Sign Up for Pulse →
            </a>
          </div>
        </li>

        <!-- Step 2 -->
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-wy-navy text-wy-gold font-bold flex items-center justify-center text-lg mt-1">2</span>
          <div>
            <h2 class="text-xl font-serif font-bold text-wy-navy mb-2">Save the Campaign Number</h2>
            <p class="text-gray-600 mb-2">
              After you sign up, you'll receive a confirmation text from the campaign number. Save that number in your contacts so you recognize it when updates arrive.
            </p>
            <div class="bg-wy-stone border border-amber-200 rounded-lg px-4 py-3 text-sm text-gray-700">
              <strong>Save as:</strong> <span class="font-mono">Pulse – Skovgard for Senate</span>
            </div>
          </div>
        </li>

        <!-- Step 3 -->
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-wy-navy text-wy-gold font-bold flex items-center justify-center text-lg mt-1">3</span>
          <div>
            <h2 class="text-xl font-serif font-bold text-wy-navy mb-2">Forward Campaign Updates</h2>
            <p class="text-gray-600 mb-3">
              When you receive an update from the campaign, forward it to people in your network — neighbors, family, friends, community members.
            </p>
            <div class="bg-white border border-gray-200 rounded-xl p-4 text-sm text-gray-700 space-y-2">
              <p class="font-semibold text-wy-navy">On Android:</p>
              <ol class="list-decimal list-inside space-y-1 text-gray-600">
                <li>Tap and hold the message from "Pulse – Skovgard for Senate"</li>
                <li>Tap <strong>Forward</strong></li>
                <li>Choose your trusted contacts to forward to</li>
              </ol>
            </div>
            <div class="mt-3 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-sm text-gray-700">
              <strong>Always include at the end of your forward:</strong><br />
              <span class="italic">"Reply STOP to opt out."</span>
            </div>
          </div>
        </li>

        <!-- Step 4 -->
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-wy-navy text-wy-gold font-bold flex items-center justify-center text-lg mt-1">4</span>
          <div>
            <h2 class="text-xl font-serif font-bold text-wy-navy mb-2">Keep It Personal</h2>
            <p class="text-gray-600">
              Before or after you forward the message, add a line in your own words. Something like:
              <em class="text-wy-navy">"Hey, thought you'd want to see this — Jimmy Skovgard is the real deal."</em>
              A personal note from someone they know is far more powerful than any ad. Use your own voice.
            </p>
          </div>
        </li>

      </ol>

      <!-- Back link -->
      <div class="pt-4 border-t border-gray-200">
        <a href="/pulse/" class="text-wy-gold hover:underline font-semibold text-sm">
          ← Back to Pulse
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Base>
