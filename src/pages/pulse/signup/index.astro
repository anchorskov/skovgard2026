---
import PulseOptInForm from '../../../components/PulseOptInForm.astro';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<Base
  title="Sign Up for Text Updates — Skovgard 2026"
  description="Opt in to receive official campaign text updates from Skovgard for Senate. Wyoming voters only."
>
  <Nav />
  <main class="pt-24 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-2">SMS Opt-In</p>
      <h1 class="text-4xl font-serif font-bold text-wy-navy mb-3">Sign Up for Text Updates</h1>
      <p class="max-w-3xl text-gray-600 mb-8">
        This route remains available as a fallback. The primary quick opt-in page is
        <a href="/pulse" class="text-wy-gold underline"> /pulse</a>.
      </p>
      <PulseOptInForm />
    </div>
  </main>
  <Footer />
</Base>
