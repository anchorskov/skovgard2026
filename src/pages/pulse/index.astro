---
import PulseOptInForm from '../../components/PulseOptInForm.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Join the Pulse & Vote in the Wyoming Citizen Poll — Skovgard 2026"
  description="Join campaign updates, verify your Wyoming voter registration, and receive the Citizen Poll ballot for your district."
  ogImage="/images/pulse/pulse-poll-social.png"
  ogImageAlt="Pulse: opt in, get campaign updates, build your ballot, receive a Citizen Poll invitation, and check your voter registration."
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <Nav />
  <main>

    <!-- Hero + opt-in form -->
    <div class="bg-wy-charcoal pt-28 pb-16 px-4">
      <div class="max-w-xl mx-auto">
        <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3 text-center">One Million Messages</p>
        <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-wy-bone text-center mb-3 leading-tight">
          Join the Pulse
        </h1>
        <p class="text-wy-bone/70 text-lg text-center mb-8 max-w-md mx-auto">
          Get Wyoming campaign updates by text and email.
        </p>
        <PulseOptInForm showPrivacyNote={false} />
        <p class="text-wy-bone/40 text-xs text-center mt-5">
          We never sell your information. Reply STOP to opt out at any time.
        </p>
      </div>
    </div>

    <!-- What you'll receive -->
    <div class="bg-wy-bone py-14 px-4">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-serif font-bold text-wy-charcoal mb-8 text-center">What you'll receive</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-xl p-5 border border-gray-200">
            <p class="font-bold text-wy-charcoal mb-1">Campaign updates</p>
            <p class="text-sm text-gray-600">Timely news from the trail — events, milestones, and moments that matter.</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-gray-200">
            <p class="font-bold text-wy-charcoal mb-1">Conversation starters</p>
            <p class="text-sm text-gray-600">Questions and ideas for the One Million Messages movement — ready to share with neighbors.</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-gray-200">
            <p class="font-bold text-wy-charcoal mb-1">Wyoming election info</p>
            <p class="text-sm text-gray-600">Key dates, ballot information, and voter resources specific to Wyoming.</p>
          </div>
          <div class="bg-white rounded-xl p-5 border border-gray-200">
            <p class="font-bold text-wy-charcoal mb-1">Low volume</p>
            <p class="text-sm text-gray-600">We send only what matters. Reply STOP anytime to opt out of texts.</p>
          </div>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</Base>
