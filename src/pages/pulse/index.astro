---
import PulseOptInForm from '../../components/PulseOptInForm.astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Pulse — Campaign Text Updates"
  description="Opt in to receive campaign text updates from Skovgard for Senate."
>
  <Nav />
  <main class="pt-24 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-wy-gold font-semibold uppercase tracking-wider text-sm mb-2">Stay Informed</p>
      <h1 class="text-5xl font-serif font-bold text-wy-navy mb-4">Campaign Text Updates</h1>

      <div class="max-w-3xl prose prose-lg text-gray-600 mb-8">
        <p>
          Opt in to receive occasional campaign text messages from <strong>Skovgard for Senate</strong>.
        </p>
        <p>
          We want to keep Wyoming informed with timely campaign updates, resources, and important election information.
        </p>
      </div>

      <PulseOptInForm />
    </div>
  </main>
  <Footer />
</Base>
