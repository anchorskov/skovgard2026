---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base title="Thank You — Skovgard 2026" description="Thank you for supporting Jimmy Skovgard for U.S. Senate 2026.">
  <Nav />
  <main class="pt-24 pb-20 px-4 min-h-screen">
    <div class="max-w-xl mx-auto text-center">
      <div class="text-6xl mb-6">🤝</div>
      <h1 class="text-4xl font-serif font-bold text-wy-navy mb-4">Thank You!</h1>
      <p class="text-gray-600 text-lg mb-4">
        Your contribution is being processed. Wyoming is stronger for it.
      </p>
      <p class="text-gray-500 mb-8">
        Questions? Email
        <a href="mailto:skovgard2026@gmail.com" class="text-wy-gold hover:underline">skovgard2026@gmail.com</a>
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-wy-gold text-wy-navy font-bold px-6 py-3 rounded hover:bg-amber-400 transition-colors">
          Back to Home
        </a>
        <a href="/volunteer/" class="border-2 border-wy-navy text-wy-navy font-bold px-6 py-3 rounded hover:bg-wy-navy hover:text-white transition-colors">
          Get Involved
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
