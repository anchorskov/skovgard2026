---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Share Jimmy's Story — Skovgard 2026"
  description="Know someone who cares about Wyoming? Share Jimmy Skovgard's campaign with friends and family."
>
  <Nav />
  <main class="pt-20">

    <!-- Hero -->
    <div class="bg-wy-charcoal py-16 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Spread the Word</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-wy-bone mb-4 leading-tight">
        Share Jimmy's Story
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto">
        Know someone who cares about Wyoming's future? Send them this message — it takes thirty seconds.
      </p>
    </div>

    <!-- Form card -->
    <section class="bg-wy-bone py-16 px-4">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">

          <!-- Your name -->
          <div class="mb-6">
            <label for="share-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input
              id="share-sender"
              type="text"
              autocomplete="given-name"
              placeholder="e.g. Sarah"
              maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember"
            />
          </div>

          <!-- Email tag input -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">
                Friends' email addresses
              </label>
              <!-- Contact picker — shown by JS when API is available -->
              <button
                id="share-contacts-btn"
                type="button"
                hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>

            <!-- Tag container + hidden input -->
            <div
              id="share-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Email address list"
            >
              <input
                id="share-email-input"
                type="email"
                inputmode="email"
                autocomplete="off"
                autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent"
              />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd class="px-1 py-0.5 bg-gray-100 rounded text-gray-500 font-mono text-xs">Enter</kbd> or
              <kbd class="px-1 py-0.5 bg-gray-100 rounded text-gray-500 font-mono text-xs">,</kbd> after each address. Paste a comma-separated list to add several at once. Up to 10 recipients.
            </p>
          </div>

          <!-- Honeypot (hidden from real users) -->
          <input id="share-trap" name="share_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <!-- Message preview -->
          <div class="mb-6 border border-gray-200 rounded-lg overflow-hidden">
            <button
              id="share-preview-toggle"
              type="button"
              class="w-full flex items-center justify-between px-4 py-3 bg-gray-50 text-sm font-semibold text-gray-600 hover:bg-gray-100 transition-colors"
              aria-expanded="false"
            >
              <span>Preview message</span>
              <svg id="share-preview-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id="share-preview-body" hidden class="px-4 py-4 text-sm text-gray-600 leading-relaxed space-y-3 border-t border-gray-200">
              <p><strong class="text-gray-800">Subject:</strong> <span id="share-preview-subject">Your neighbor wanted you to hear about Jimmy Skovgard for Wyoming</span></p>
              <hr class="border-gray-100" />
              <p id="share-preview-intro" class="italic text-gray-500">A Wyoming neighbor wanted to share this with you.</p>
              <p>
                This campaign is built around two beliefs. First, Wyoming voters deserve leadership grounded in integrity,
                accountability, and the rule of law. Second, citizens are the fourth branch of government — our
                representatives work for us, not the other way around.
              </p>
              <p>
                Jimmy Skovgard is running on three commitments: integrity in leadership, a stronger Wyoming voice,
                and a future built together.
              </p>
              <p>
                <a href="https://www.skovgard2026.org/about/" class="text-wy-ember underline">Learn more about Jimmy →</a>
              </p>
              <p class="text-xs text-gray-400 pt-1">
                This is a one-time message shared by a friend. You are not being added to any mailing list.
              </p>
            </div>
          </div>

          <!-- Status message -->
          <div id="share-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              id="share-mailto-btn"
              type="button"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3 border-2 border-wy-charcoal text-wy-charcoal font-bold rounded-lg hover:bg-wy-charcoal hover:text-wy-bone transition-colors text-sm"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Open in my email
            </button>
            <button
              id="share-send-btn"
              type="button"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span id="share-send-label">Have us send it</span>
            </button>
          </div>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            <strong>Open in my email</strong> launches your own inbox — the message comes from you personally.<br/>
            <strong>Have us send it</strong> sends a campaign-branded email through our system. Recipients are not added to our list.
          </p>
        </div>
      </div>
    </section>

    <!-- Why share -->
    <section class="bg-white py-16 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-serif font-bold text-wy-charcoal mb-4">Why it matters</h2>
        <p class="text-gray-600 leading-relaxed mb-10 max-w-xl mx-auto">
          Campaigns are built one conversation at a time. A message from someone you know carries
          more weight than any ad. If you believe Wyoming deserves better, share it.
        </p>
        <div class="grid sm:grid-cols-3 gap-6 text-left">
          {[
            { n: '1', head: 'Takes 30 seconds', body: 'Enter a few email addresses and hit send. That\'s it.' },
            { n: '2', head: 'Comes from you', body: 'Use your own inbox so it arrives as a personal note, not a campaign blast.' },
            { n: '3', head: 'No strings', body: 'People you share with are not added to our list — they choose that for themselves.' },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-wy-ember font-serif font-extrabold text-2xl leading-none mt-0.5">{item.n}.</span>
              <div>
                <h3 class="font-semibold text-wy-charcoal mb-1">{item.head}</h3>
                <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* Chip / tag styling */
  .share-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1ece1;
    border: 1px solid #c68a4a33;
    color: #2b2b2b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    max-width: 220px;
  }
  .share-chip span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .share-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: #c68a4a55;
    color: #2b2b2b;
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .share-chip button:hover { background: #b22234; color: #fff; }

  #share-send-btn:disabled,
  #share-mailto-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  #share-status.status-error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
  }
  #share-status.status-success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #166534;
  }
  #share-status.status-info {
    background: #eff6ff;
    border: 1px solid #93c5fd;
    color: #1e40af;
  }
  kbd {
    font-family: ui-monospace, monospace;
  }
</style>

<script>
(function () {
  /* ── State ─────────────────────────────────────────────── */
  const emails = [];
  const MAX = 10;

  /* ── Element refs ──────────────────────────────────────── */
  const tagBox        = document.getElementById('share-tag-box');
  const emailInput    = document.getElementById('share-email-input');
  const senderInput   = document.getElementById('share-sender');
  const contactsBtn   = document.getElementById('share-contacts-btn');
  const previewToggle = document.getElementById('share-preview-toggle');
  const previewBody   = document.getElementById('share-preview-body');
  const previewChevron= document.getElementById('share-preview-chevron');
  const previewSubject= document.getElementById('share-preview-subject');
  const previewIntro  = document.getElementById('share-preview-intro');
  const mailtoBtn     = document.getElementById('share-mailto-btn');
  const sendBtn       = document.getElementById('share-send-btn');
  const sendLabel     = document.getElementById('share-send-label');
  const statusEl      = document.getElementById('share-status');
  const trapEl        = document.getElementById('share-trap');

  /* ── Helpers ───────────────────────────────────────────── */
  function isValidEmail(e) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim());
  }

  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  function renderTags() {
    // Remove all existing chips (but keep the input)
    Array.from(tagBox.querySelectorAll('.share-chip')).forEach(c => c.remove());
    emails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'share-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">✕</button>`;
      chip.querySelector('button').addEventListener('click', () => removeEmail(i));
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons();
    updatePreview();
  }

  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (emails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (emails.length >= MAX) { setStatus(`Maximum ${MAX} recipients per send.`, 'info'); return; }
    setStatus('', '');
    emails.push(e);
    renderTags();
  }

  function removeEmail(index) {
    emails.splice(index, 1);
    setStatus('', '');
    renderTags();
  }

  function updateButtons() {
    const hasEmails = emails.length > 0;
    mailtoBtn.disabled = !hasEmails;
    sendBtn.disabled   = !hasEmails;
  }

  /* ── Preview ───────────────────────────────────────────── */
  function updatePreview() {
    const name = senderInput.value.trim();
    if (name) {
      previewSubject.textContent = `${name} wants you to hear about Jimmy Skovgard for Wyoming`;
      previewIntro.textContent   = `${name} wanted to share this with you.`;
    } else {
      previewSubject.textContent = 'Your neighbor wanted you to hear about Jimmy Skovgard for Wyoming';
      previewIntro.textContent   = 'A Wyoming neighbor wanted to share this with you.';
    }
  }

  previewToggle.addEventListener('click', () => {
    const open = previewToggle.getAttribute('aria-expanded') === 'true';
    previewToggle.setAttribute('aria-expanded', String(!open));
    previewBody.hidden = open;
    previewChevron.style.transform = open ? '' : 'rotate(180deg)';
  });

  senderInput.addEventListener('input', updatePreview);

  /* ── Tag input events ──────────────────────────────────── */
  emailInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      addEmail(emailInput.value);
      emailInput.value = '';
    } else if (e.key === 'Backspace' && emailInput.value === '' && emails.length > 0) {
      removeEmail(emails.length - 1);
    }
  });

  emailInput.addEventListener('blur', () => {
    if (emailInput.value.trim()) {
      addEmail(emailInput.value);
      emailInput.value = '';
    }
  });

  // Support pasting a comma-separated list
  emailInput.addEventListener('paste', (e) => {
    e.preventDefault();
    const pasted = (e.clipboardData || window.clipboardData).getData('text');
    pasted.split(/[,;\s\n]+/).forEach(part => {
      if (part.trim()) addEmail(part);
    });
    emailInput.value = '';
  });

  // Click anywhere in the box focuses the input
  tagBox.addEventListener('click', () => emailInput.focus());

  /* ── Contact Picker API ────────────────────────────────── */
  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try {
          const picked = await navigator.contacts.select(['name', 'email'], { multiple: true });
          picked.forEach(contact => (contact.email || []).forEach(e => addEmail(e)));
        } catch (_) { /* user cancelled */ }
      });
    } catch (_) { /* API unavailable */ }
  })();

  /* ── mailto: flow ──────────────────────────────────────── */
  function buildMailtoBody() {
    const name = senderInput.value.trim();
    const intro = name
      ? `${name} here — I wanted to share this with you.\n\n`
      : '';
    return [
      `${intro}Hi,`,
      '',
      "I came across Jimmy Skovgard's campaign for Wyoming's U.S. Senate seat and thought you'd want to know about it.",
      '',
      "This campaign is built around two beliefs:",
      '',
      "— Wyoming voters deserve leadership grounded in integrity, accountability, and the rule of law.",
      '',
      "— Citizens are the fourth branch of government. Our representatives work for us, not the other way around.",
      '',
      "Three commitments:",
      "  1. Integrity in leadership",
      "  2. A stronger Wyoming voice",
      "  3. A future built together",
      '',
      "Learn more:    https://www.skovgard2026.org/about/",
      "Volunteer:     https://www.skovgard2026.org/volunteer/",
      "Support:       https://www.skovgard2026.org/donate/",
      '',
      "Jimmy Skovgard — Preserving our legacy. Empowering our future.",
      "Paid for by Skovgard for Senate.",
    ].join('\n');
  }

  mailtoBtn.addEventListener('click', () => {
    if (emails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }
    const name    = senderInput.value.trim();
    const subject = name
      ? `${name} wants you to hear about Jimmy Skovgard for Wyoming`
      : 'Your neighbor wanted you to hear about Jimmy Skovgard for Wyoming';
    const url = `mailto:${emails.join(',')}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(buildMailtoBody())}`;
    window.location.href = url;
    setStatus('Your email app should be opening now. Add any extra personal notes before you send!', 'success');
  });

  /* ── Worker "send it for me" flow ──────────────────────── */
  sendBtn.addEventListener('click', async () => {
    if (emails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }
    if (trapEl.value.trim())  return; // bot trap

    sendBtn.disabled = true;
    mailtoBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setStatus('', '');

    try {
      const resp = await fetch('/api/share', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          sender_name: senderInput.value.trim(),
          recipients:  emails.slice(),
          _trap:       trapEl.value,
          _t:          Date.now(),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        const fallback = resp.status === 404 && isLocal
          ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev'
          : resp.status === 503
          ? 'Share feature is not enabled on this environment yet.'
          : data.error || 'Something went wrong. Please try again.';
        setStatus(fallback, 'error');
      } else {
        const n = data.sent || emails.length;
        setStatus(
          `Sent! ${n} message${n !== 1 ? 's' : ''} delivered. Thank you for spreading the word.`,
          'success'
        );
        // Clear the list after a successful send
        emails.length = 0;
        renderTags();
      }
    } catch (_) {
      const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      setStatus(
        isLocal
          ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal, then try again. "Open in my email" works without it.'
          : 'Network error — please check your connection and try again.',
        'error'
      );
    } finally {
      sendLabel.textContent = 'Have us send it';
      updateButtons();
    }
  });

  /* ── Init ──────────────────────────────────────────────── */
  updateButtons();
  updatePreview();

  // On localhost, show a notice if the Worker isn't proxied yet
  if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
    setStatus(
      'Local dev: "Have us send it" needs the Worker running. ' +
      'In a second terminal: cd worker && npx wrangler dev. ' +
      '"Open in my email" works without it.',
      'info'
    );
  }
})();
</script>
