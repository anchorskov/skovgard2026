---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { MEDIA_BASE_URL } from '../constants';
---
<Base
  title='Civ-Tech — Skovgard 2026'
  description='Harnessing secure, open-source tools to amplify Wyoming voices in Washington.'
>
  <Nav />
  <main class='pt-20'>

    <!-- Hero -->
    <div class='bg-wy-navy py-20 px-4'>
      <div class='max-w-4xl mx-auto text-center'>
        <p class='text-wy-gold font-semibold uppercase tracking-widest text-sm mb-3'>Technology for the People</p>
        <h1 class='text-5xl font-serif font-bold text-white mb-6'>Civ-Tech: Empowering Our Voices</h1>
        <p class='text-white/75 text-xl max-w-2xl mx-auto'>
          Not a slogan. A commitment. Secure, open-source tools that bring Wyoming to Washington, not the other way around.
        </p>
      </div>
    </div>

    <!-- Why -->
    <section class='bg-white py-20 px-4'>
      <div class='max-w-4xl mx-auto'>
        <h2 class='text-4xl font-serif font-bold text-wy-navy mb-4'>Why Civ-Tech</h2>
        <p class='text-gray-600 text-lg mb-6'>Congress listens to the loudest. We are leveling the playing field.</p>
        <div class='mb-10'>
          <audio controls preload='metadata' class='w-full rounded'>
            <source src={`${MEDIA_BASE_URL}/civ-tech/JimmyTools.mp3`} type='audio/mpeg' />
          </audio>
          <a
            href={`${MEDIA_BASE_URL}/civ-tech/JimmyTools.mp3`}
            target='_blank'
            rel='noopener'
            class='mt-2 inline-block text-sm font-semibold text-wy-sandstone hover:text-wy-ember hover:underline'
          >
            Open audio directly
          </a>
        </div>
        <div class='grid sm:grid-cols-2 gap-6'>
          {[
            { title: 'Open-Source', desc: 'Anyone can inspect it, audit it, and improve it. No black boxes.' },
            { title: 'Accessible', desc: 'Built for students, veterans, and seniors, not just the tech-savvy.' },
            { title: 'Real-Time', desc: 'Responsive to feedback, not quarterly town halls.' },
            { title: 'Verifiable', desc: 'Every record is transparent. Trust is built on receipts.' },
          ].map(item => (
            <a href='https://grassrootsmvt.org' target='_blank' rel='noopener'
               class='bg-wy-stone rounded-xl p-6 border-l-4 border-wy-gold hover:border-wy-sky hover:shadow-md transition-all group block'>
              <h3 class='font-serif font-bold text-wy-navy text-xl mb-2 group-hover:text-wy-sky transition-colors'>{item.title}</h3>
              <p class='text-gray-600'>{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Who benefits -->
    <section class='bg-wy-stone py-20 px-4'>
      <div class='max-w-4xl mx-auto'>
        <h2 class='text-4xl font-serif font-bold text-wy-navy mb-4'>Who Benefits</h2>
        <p class='text-gray-600 text-lg mb-8'>This is our movement. This Is Us.</p>
        <ul class='space-y-4'>
          {[
            'Voters who feel unheard',
            'Teachers seeking real-world civic examples',
            'Citizens who have written their representatives without reply',
            'Public servants committed to transparency',
            'Future generations watching how we act',
          ].map(item => (
            <li class='flex gap-3 items-center'>
              <span class='w-2 h-2 rounded-full bg-wy-gold shrink-0'></span>
              <span class='text-gray-700 text-lg'>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Active Wyoming Surveys -->
    <section class='bg-wy-bone py-20 px-4'>
      <div class='max-w-4xl mx-auto'>
        <p class='text-wy-gold font-semibold uppercase tracking-widest text-sm mb-2'>Wyoming Surveys</p>
        <h2 class='text-4xl font-serif font-bold text-wy-navy mb-4'>Take Part in Active Surveys</h2>
        <p class='text-gray-600 text-lg mb-8 max-w-2xl'>
          Verified Wyoming voters participate in structured feedback surveys on GrassrootsMVT.org.
          Your responses help measure constituent priorities against legislative action.
        </p>

        <!-- View toggle -->
        <div class='survey-toggle-bar' role='group' aria-label='Survey view'>
          <button id='toggle-dropdown' class='stoggle stoggle-active' aria-pressed='true'>
            <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M8 9l4-4 4 4m0 6l-4 4-4-4' />
            </svg>
            Quick select
          </button>
          <button id='toggle-cards' class='stoggle' aria-pressed='false'>
            <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
              <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
                d='M4 6h16M4 10h16M4 14h16M4 18h16' />
            </svg>
            Browse all
          </button>
        </div>

        <!-- Loading / error states -->
        <div id='survey-loading' class='survey-feedback'>Loading surveys&hellip;</div>
        <div id='survey-error' class='survey-feedback survey-error hidden'>
          Could not load surveys. Visit <a href='https://grassrootsmvt.org/surveys' target='_blank' rel='noopener' class='underline'>GrassrootsMVT.org</a> directly.
        </div>

        <!-- Panel: dropdown -->
        <div id='panel-dropdown' class='survey-panel hidden'>
          <div class='flex flex-col sm:flex-row gap-3 items-start sm:items-center'>
            <select id='survey-select'
              class='flex-1 px-4 py-3 border-2 border-wy-navy rounded-lg text-wy-navy font-semibold bg-white focus:outline-none focus:ring-2 focus:ring-wy-gold text-base'>
              <option value=''>Select a survey&hellip;</option>
            </select>
            <button id='survey-go-btn'
              class='survey-go-btn'
              disabled>
              Take Survey
              <svg class='w-4 h-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
                <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='M17 8l4 4m0 0l-4 4m4-4H3' />
              </svg>
            </button>
          </div>
        </div>

        <!-- Panel: cards -->
        <div id='panel-cards' class='survey-panel hidden'>
          <p id='survey-count' class='survey-count'></p>
          <div id='survey-cards-grid' class='grid sm:grid-cols-2 lg:grid-cols-3 gap-4'></div>
        </div>

        <!-- External link notice -->
        <p class='flex items-center gap-1.5 text-sm text-gray-400 mt-6'>
          <svg class='w-4 h-4 shrink-0' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
              d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14' />
          </svg>
          Surveys open on <strong class='text-gray-500'>GrassrootsMVT.org</strong> in a new tab.
          You will be leaving skovgard2026.org.
        </p>
      </div>
    </section>

    <!-- Principles -->
    <section class='bg-wy-navy py-20 px-4'>
      <div class='max-w-4xl mx-auto'>
        <h2 class='text-4xl font-serif font-bold text-white mb-10 text-center'>Our Principles</h2>
        <div class='grid sm:grid-cols-2 gap-8'>
          <div>
            <h3 class='text-wy-gold font-bold uppercase tracking-wider text-sm mb-4'>We Believe</h3>
            <ul class='space-y-3'>
              {[
                'Truth matters: combat disinformation',
                'Term limits matter: end career politicians',
                'Discourse matters: civil debate builds progress',
                'Local voices matter: Wyoming guides national choices',
              ].map(p => (
                <li class='flex gap-3 text-white/80'><span class='text-wy-gold'>&#10003;</span>{p}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class='text-red-400 font-bold uppercase tracking-wider text-sm mb-4'>We Reject</h3>
            <ul class='space-y-3'>
              {[
                'Authoritarian shortcuts',
                'Surveillance disguised as safety',
                'Political theater over genuine representation',
              ].map(p => (
                <li class='flex gap-3 text-white/80'><span class='text-red-400'>&#10007;</span>{p}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class='bg-white py-16 px-4 text-center'>
      <h2 class='text-3xl font-serif font-bold text-wy-navy mb-4'>Join Us</h2>
      <p class='text-gray-600 text-lg mb-8 max-w-xl mx-auto'>
        In Wyoming, when we need it, we go to the shop and build it.
      </p>
      <div class='flex flex-col sm:flex-row gap-4 justify-center'>
        <a href='https://grassrootsmvt.org' target='_blank' rel='noopener'
           class='bg-wy-navy text-white font-bold px-8 py-3 rounded hover:bg-wy-sky transition-colors'>
          Try the Platform
        </a>
        <a href='/feedback'
           class='border-2 border-wy-navy text-wy-navy font-bold px-8 py-3 rounded hover:bg-wy-navy hover:text-white transition-colors'>
          Share Feedback
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* Toggle bar */
  .survey-toggle-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }
  .stoggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 8px;
    border: 2px solid #0f2742;
    background: transparent;
    color: #0f2742;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .stoggle:hover { background: #0f2742; color: #f1ece1; }
  .stoggle-active { background: #0f2742; color: #f1ece1; }

  /* Panels */
  .survey-panel { margin-top: 4px; }
  .survey-panel.hidden { display: none; }

  /* Feedback text */
  .survey-feedback { font-size: 0.9375rem; color: #6b7280; margin-bottom: 8px; }
  .survey-feedback.hidden { display: none; }
  .survey-error a { color: #0f2742; }

  /* Go button */
  .survey-go-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    background: #0f2742;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.9375rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s;
  }
  .survey-go-btn:hover:not(:disabled) { background: #b22234; }
  .survey-go-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Survey count label */
  .survey-count {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #c68a4a;
    margin-bottom: 14px;
  }

  /* Survey cards */
  .survey-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e5e2da;
    border-left: 4px solid #0f2742;
    border-radius: 10px;
    text-decoration: none;
    overflow: hidden;
    transition: border-left-color 0.18s, box-shadow 0.18s, transform 0.18s;
  }
  .survey-card:hover {
    border-left-color: #b22234;
    box-shadow: 0 6px 20px rgba(15,39,66,0.13);
    transform: translateY(-3px);
  }
  .sc-body {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 18px 14px;
    flex: 1;
  }
  .sc-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #0f2742;
    color: #d8b46a;
    font-size: 0.6875rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    transition: background-color 0.18s;
  }
  .survey-card:hover .sc-num { background: #b22234; color: #fff; }
  .sc-title {
    font-family: 'Bitter', serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #0f2742;
    line-height: 1.45;
    margin: 0;
  }
  .sc-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 9px 18px;
    background: #f8f6f1;
    border-top: 1px solid #e5e2da;
  }
  .sc-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #b22234;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .survey-card:hover .sc-btn { color: #8b1a26; }
</style>

<script>
(function () {
  const loading      = document.getElementById('survey-loading');
  const errorEl      = document.getElementById('survey-error');
  const panelDrop    = document.getElementById('panel-dropdown');
  const panelCards   = document.getElementById('panel-cards');
  const selectEl     = document.getElementById('survey-select');
  const goBtn        = document.getElementById('survey-go-btn');
  const cardsGrid    = document.getElementById('survey-cards-grid');
  const btnDrop      = document.getElementById('toggle-dropdown');
  const btnCards     = document.getElementById('toggle-cards');

  const BASE = 'https://grassrootsmvt.org/surveys/';
  let surveys = [];
  let activePanel = 'dropdown';

  function showPanel(which) {
    activePanel = which;
    panelDrop.classList.toggle('hidden', which !== 'dropdown');
    panelCards.classList.toggle('hidden', which !== 'cards');
    btnDrop.classList.toggle('stoggle-active', which === 'dropdown');
    btnCards.classList.toggle('stoggle-active', which === 'cards');
    btnDrop.setAttribute('aria-pressed', which === 'dropdown');
    btnCards.setAttribute('aria-pressed', which === 'cards');
  }

  btnDrop.addEventListener('click', () => showPanel('dropdown'));
  btnCards.addEventListener('click', () => showPanel('cards'));

  function buildDropdown(list) {
    list.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s.slug;
      opt.textContent = s.title;
      selectEl.appendChild(opt);
    });
  }

  function buildCards(list) {
    const countEl = document.getElementById('survey-count');
    if (countEl) countEl.textContent = `${list.length} active Wyoming surveys`;

    list.forEach((s, i) => {
      const num = String(i + 1).padStart(2, '0');
      const a = document.createElement('a');
      a.href = BASE + s.slug;
      a.target = '_blank';
      a.rel = 'noopener';
      a.className = 'survey-card';
      a.innerHTML =
        `<div class="sc-body">` +
          `<span class="sc-num" aria-hidden="true">${num}</span>` +
          `<p class="sc-title">${s.title}</p>` +
        `</div>` +
        `<div class="sc-footer">` +
          `<span class="sc-btn">` +
            `Take Survey` +
            `<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">` +
              `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>` +
            `</svg>` +
          `</span>` +
        `</div>`;
      cardsGrid.appendChild(a);
    });
  }

  selectEl.addEventListener('change', () => {
    goBtn.disabled = !selectEl.value;
  });

  goBtn.addEventListener('click', () => {
    if (selectEl.value) window.open(BASE + selectEl.value, '_blank', 'noopener');
  });

  async function loadSurveys() {
    try {
      const resp = await fetch('/api/surveys');
      if (!resp.ok) throw new Error('non-ok');
      const data = await resp.json();
      surveys = data.surveys || [];
      if (!surveys.length) throw new Error('empty');

      loading.classList.add('hidden');
      buildDropdown(surveys);
      buildCards(surveys);
      panelDrop.classList.remove('hidden');
    } catch (_) {
      loading.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  loadSurveys();
})();
</script>
