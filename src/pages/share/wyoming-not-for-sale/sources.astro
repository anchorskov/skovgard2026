---
// src/pages/share/wyoming-not-for-sale/sources.astro
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<Base
  title="Sources — Wyoming Is Not for Sale — Skovgard 2026"
  description="Primary sources and research notes supporting the Wyoming Is Not for Sale share message about out-of-state PAC spending and dark money in Wyoming elections."
>
  <Nav />
  <main class="pt-20">

    <!-- Breadcrumb -->
    <div class="bg-wy-bone border-b border-gray-200 py-3 px-4">
      <div class="max-w-3xl mx-auto flex items-center gap-2 flex-wrap">
        <a href="/share" class="inline-flex items-center gap-1.5 text-gray-400 hover:text-wy-ember text-xs font-semibold uppercase tracking-widest transition-colors shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All messages
        </a>
        <span class="text-gray-300 text-sm">/</span>
        <a href="/share/wyoming-not-for-sale/" class="text-sm font-semibold text-gray-400 hover:text-wy-ember transition-colors">Wyoming Is Not for Sale</a>
        <span class="text-gray-300 text-sm">/</span>
        <span class="text-sm font-semibold text-wy-charcoal">Sources</span>
      </div>
    </div>

    <!-- Hero -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Research Notes</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-wy-bone mb-4 leading-tight">
        Wyoming Is Not for Sale
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto">
        Sources and research notes supporting the claims in the share message.
        This is a research aid, not a legal opinion.
      </p>
    </div>

    <!-- Preamble -->
    <section class="bg-wy-bone border-b border-gray-200 py-10 px-4">
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="bg-white border border-gray-200 rounded-xl px-6 py-5">
          <p class="text-sm text-gray-700 leading-relaxed">
            <strong>About this page.</strong> This page documents the primary sources behind
            the Wyoming Is Not for Sale share message. All claims are drawn from public records,
            press releases, official disclosures, and published news reporting. Links go to
            the original sources — no link in this document is invented or unverified.
            The point is not that every outside-dollar expenditure is illegal. The point is
            that Wyoming citizens deserve to know who is trying to shape Wyoming law before
            the vote is over and the money has moved on.
          </p>
        </div>
        <div class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-6 py-4">
          <svg class="w-5 h-5 text-wy-ember shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <a href="/docs/wyoming-not-for-sale-expose.pdf" target="_blank" rel="noopener"
              class="text-sm font-semibold text-wy-ember hover:underline">
            Download the full expose (PDF) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Claims table -->
    <article class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto sources-content">

        <h2>Key claims and source support</h2>

        <div class="claims-table">

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [1]</p>
              <p class="claim-text">AFP-Wyoming called its 2024 legislative endorsement effort the <em>single largest investment in Wyoming state-level politics in history.</em></p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                AFP-Wyoming 2024 endorsement press release.
                <a href="https://americansforprosperity.org/press-release/afp-wyoming-announces-11-new-endorsements-for-2024-primary-elections/"
                    class="src-link" target="_blank" rel="noopener">
                  AFP-WY endorsement release &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [2]</p>
              <p class="claim-text">AFP-Wyoming criticized Governor Gordon's veto of HB 178, which dealt with public-sector union dues and payroll deductions.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                AFP-WY press release on the HB 178 veto.
                <a href="https://americansforprosperity.org/press-release/afp-wy-bashes-gov-gordon-for-veto-of-paycheck-protection-act/"
                    class="src-link" target="_blank" rel="noopener">
                  AFP-WY HB 178 veto release &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [3]</p>
              <p class="claim-text">Virginia-based Make Liberty Win spent just over $370,000 on texts, phone calls, and mailers in Wyoming primary races.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                Wyoming Public Media reporting on out-of-state PAC spending in Wyoming races.
                <a href="https://www.wyomingpublicmedia.org/politics-government/2024-08-19/reports-show-out-of-state-pacs-spent-big-money-in-wyoming-primary-races"
                    class="src-link" target="_blank" rel="noopener">
                  Wyoming Public Media — out-of-state PAC spending &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [4]</p>
              <p class="claim-text">Some Make Liberty Win mailers spread misinformation, including wrong early-voting dates.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                WyoFile reporting on Make Liberty Win's Wyoming spending and mailer inaccuracies.
                <a href="https://wyofile.com/as-candidates-spend-big-one-out-of-state-group-injects-370k-into-wyomings-primaries/"
                    class="src-link" target="_blank" rel="noopener">
                  WyoFile — Make Liberty Win and $370K &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [5]</p>
              <p class="claim-text">Governor Gordon's HB 178 veto letter warned of <em>out-of-state interests foisting out-of-state solutions on Wyoming.</em></p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                WyoFile reporting on HB 178 and quoting Governor Gordon's veto letter.
                <a href="https://wyofile.com/public-payroll-deductions-for-union-fees-stand-after-house-fails-to-override-gov-gordons-veto/"
                    class="src-link" target="_blank" rel="noopener">
                  WyoFile — HB 178 veto and national-policy template concern &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [6]</p>
              <p class="claim-text">HB 178 was the official Wyoming Legislature bill on public unions, transparency, and dues withdrawal limitations.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                Official Wyoming Legislature bill page.
                <a href="https://www.wyoleg.gov/Legislation/2026/HB0178"
                    class="src-link" target="_blank" rel="noopener">
                  Wyoming Legislature — HB 178 &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [7]</p>
              <p class="claim-text">501(c)(4) organizations may lobby and may engage in some political activity, so long as political activity is not their primary activity.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                IRS guidance on 501(c)(4) social welfare organizations.
                <a href="https://www.irs.gov/charities-non-profits/other-non-profits/social-welfare-organizations"
                    class="src-link" target="_blank" rel="noopener">
                  IRS — 501(c)(4) social welfare organizations &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [8]</p>
              <p class="claim-text">AFP's own giving page states that AFP is a 501(c)(4) social welfare organization and may advocate for or against legislation.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                AFP's own legacy giving page stating its 501(c)(4) status.
                <a href="https://americansforprosperity.org/legacy-giving/"
                    class="src-link" target="_blank" rel="noopener">
                  AFP — legacy giving page &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [9]</p>
              <p class="claim-text">AFP is not required to disclose donors and does not disclose donors.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                FactCheck.org reporting on AFP's donor disclosure practices.
                <a href="https://www.factcheck.org/2014/02/americans-for-prosperity-3/"
                    class="src-link" target="_blank" rel="noopener">
                  FactCheck.org — AFP donor disclosure &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [10]</p>
              <p class="claim-text">Dark-money groups, nonprofits, and shell companies that do not reveal donors put more than $1.9 billion into the 2024 federal election cycle.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                Brennan Center for Justice reporting on dark money in the 2024 federal cycle.
                <a href="https://www.brennancenter.org/our-work/research-reports/dark-money-hit-record-high-19-billion-2024-federal-races"
                    class="src-link" target="_blank" rel="noopener">
                  Brennan Center — dark money record $1.9 billion &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [11]</p>
              <p class="claim-text">Hawaii enacted a law taking effect July 1, 2027 that uses a state-corporate-law approach to limit corporate election spending. Montana advocates are pursuing a similar idea.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                Associated Press reporting on the Hawaii corporate political-spending law.
                <a href="https://apnews.com/article/corporate-campaign-money-citizens-united-hawaii-71a28bc7e8f6e0279b31e999f222519a"
                    class="src-link" target="_blank" rel="noopener">
                  AP — Hawaii corporate political-spending law &rarr;
                </a>
              </p>
            </div>
          </div>

          <div class="claim-row">
            <div class="claim-col">
              <p class="claim-label">Claim [12]</p>
              <p class="claim-text">Montana advocates are pursuing a citizen ballot effort on corporate political spending for 2026.</p>
            </div>
            <div class="source-col">
              <p class="source-label">Primary source</p>
              <p class="source-text">
                Montana Secretary of State proposed 2026 ballot issues page showing the current status of ballot efforts.
                <a href="https://sosmt.gov/elections/ballot_issues/proposed-2026-ballot-issues/"
                    class="src-link" target="_blank" rel="noopener">
                  Montana SOS — proposed 2026 ballot issues &rarr;
                </a>
              </p>
            </div>
          </div>

        </div><!-- /claims-table -->

        <div class="mt-12 pt-8 border-t border-gray-200">
          <p class="text-sm text-gray-500 leading-relaxed mb-6">
            <strong>Responsible use note.</strong> The sources above document public spending
            disclosures, press releases, news reporting, and official government pages. They
            establish what was spent, what was said publicly, and what the law currently allows.
            They do not constitute a legal opinion on whether any activity was improper.
            Readers are encouraged to review the original sources and form their own conclusions.
          </p>
          <a href="/share/wyoming-not-for-sale/" class="inline-flex items-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            Share this message
          </a>
        </div>

      </div>
    </article>

  </main>
  <Footer />
</Base>

<style>
  .sources-content h2 {
    font-family: 'Bitter', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #2b2b2b;
    margin: 0 0 20px;
  }

  .claims-table {
    border: 1px solid #e5e2da;
    border-radius: 12px;
    overflow: hidden;
  }

  .claim-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #e5e2da;
  }
  .claim-row:last-child { border-bottom: none; }

  @media (max-width: 640px) {
    .claim-row { grid-template-columns: 1fr; }
  }

  .claim-col {
    padding: 16px 18px;
    background: #fff;
    border-right: 1px solid #e5e2da;
  }
  @media (max-width: 640px) {
    .claim-col { border-right: none; border-bottom: 1px solid #e5e2da; }
  }

  .source-col {
    padding: 16px 18px;
    background: #faf9f7;
  }

  .claim-label, .source-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
    margin: 0 0 6px;
  }

  .claim-text {
    font-size: 0.9rem;
    line-height: 1.55;
    color: #2b2b2b;
    margin: 0;
  }

  .source-text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #374151;
    margin: 0;
  }

  .src-link {
    display: inline-block;
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #b22234;
    text-decoration: none;
  }
  .src-link:hover { text-decoration: underline; }
</style>
