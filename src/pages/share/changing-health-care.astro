---
// src/pages/share/changing-health-care.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Changing Health Care — Skovgard 2026"
  description="Wyoming is facing a hard question. The honest path is a constitutional amendment placed before the people. Take the Wyoming Health Care and Constitutional Process Survey."
  ogImage="/images/share/meme-changing-health-care.png"
>
  <Nav />
  <main class="pt-20">

    <!-- Breadcrumb bar -->
    <div class="bg-wy-bone border-b border-gray-200 py-3 px-4">
      <div class="max-w-3xl mx-auto flex items-center gap-3">
        <a href="/share" class="inline-flex items-center gap-1.5 text-gray-400 hover:text-wy-ember text-xs font-semibold uppercase tracking-widest transition-colors shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All messages
        </a>
        <span class="text-gray-300 text-sm">/</span>
        <span class="text-sm font-semibold text-wy-charcoal truncate">Changing Health Care</span>
      </div>
    </div>

    <!-- Hero -->
    <section class="bg-wy-charcoal py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-wy-sandstone font-bold uppercase tracking-widest text-xs mb-3">Health Care &amp; Constitution</p>
        <h1 class="font-serif font-extrabold text-wy-bone text-4xl sm:text-5xl leading-tight mb-4">
          Changing Health Care
        </h1>
        <p class="text-xl text-gray-300 font-medium leading-snug mb-10">
          Our representatives work for us. The Constitution belongs to the people.
        </p>
        <div class="space-y-5 text-lg text-gray-200 leading-relaxed">
          <p>
            Wyoming is facing a hard question. After the Wyoming Supreme Court's ruling on abortion
            policy and Article 1, Section 38 of the Wyoming Constitution, the path forward should be
            honest, constitutional, and led by the people of Wyoming.
          </p>
          <p>
            This campaign is built on a simple belief: we do not have to let hard issues tear us apart.
            We can face them directly. We can tell the truth. We can follow the Constitution. And when
            the Constitution needs to be changed, we can place that question before the people.
          </p>
          <p>
            The issue is bigger than one court case, one law, or one headline.
            It goes to the oath of office itself.
          </p>
          <p class="text-white font-semibold">
            Every elected representative is bound to support, obey, and defend the Constitution.
            Our representatives do not own that oath. We do.
          </p>
        </div>
      </div>
    </section>

    <!-- The Honest Path -->
    <section class="bg-wy-bone py-14 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="section-kicker">The Honest Path</p>
        <p class="text-gray-700 text-lg leading-relaxed mb-6">
          If Wyoming wants to change how the Constitution applies to health care and abortion policy,
          the honest path is a constitutional amendment placed before the people of Wyoming.
        </p>
        <p class="text-gray-600 mb-5 font-medium">That path lets us answer the hard questions directly:</p>
        <ul class="space-y-3 pl-0">
          {[
            "When does human life begin?",
            "When should human life receive the protections of law?",
            "What safeguards must exist for medical emergencies, miscarriage care, ectopic pregnancy care, fatal fetal anomalies, rape, incest, and serious threats to a pregnant patient's health?",
            "How do we protect lawful, medically appropriate decisions between patients and medical providers?",
            "And how do we make sure our representatives stay within the guardrails of the Constitution?",
          ].map(q => (
            <li class="flex gap-3 items-start text-gray-700 leading-relaxed">
              <span class="mt-1.5 w-2 h-2 rounded-full bg-wy-ember shrink-0"></span>
              <span>{q}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- GrassrootsMVT -->
    <section class="bg-white py-14 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="section-kicker">GrassrootsMVT: A Proof of Concept</p>
        <p class="text-gray-700 text-lg leading-relaxed mb-8">
          GrassrootsMVT.org is being built as a proof of concept for verified public input.
          The purpose is simple: give registered Wyoming voters a way to weigh in directly on difficult
          issues, district by district and county by county, so our representatives cannot hide behind
          noise, pressure, or assumptions.
        </p>

        <!-- Survey CTA -->
        <a
          href="https://grassrootsmvt.org/surveys/wy-health-care-constitutional-process"
          target="_blank"
          rel="noopener"
          class="survey-btn"
        >
          Take the Wyoming Health Care and Constitutional Process Survey
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- PDF source link -->
        <div class="mt-10 pt-8 border-t border-gray-200">
          <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-3">Source Documentation</p>
          <a
            href="/docs/Wellspring_Completed_Questionnaire_Skovgard_With_Public_Input.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-wy-charcoal font-semibold hover:text-wy-ember transition-colors"
          >
            <svg class="w-5 h-5 shrink-0 text-wy-ember" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Read the source packet — constitutional background and court ruling (PDF)
          </a>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="bg-wy-charcoal py-16 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-2xl sm:text-3xl font-serif font-bold text-wy-bone leading-loose">
          We are Wyoming.<br />
          Our representatives work for us.<br />
          The Constitution belongs to the people.
        </p>
      </div>
    </section>

    <!-- ① Share on social media -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Share on social media</p>
        <p class="section-desc">
          This image and link are what people see when you post on Facebook or X.
          When someone clicks the link, they land on this page.
        </p>

        <figure class="rounded-xl overflow-hidden shadow-lg mb-7">
          <img
            src="/images/share/meme-changing-health-care.png"
            alt="Changing Health Care — Our representatives work for us. The Constitution belongs to the people."
            class="w-full block"
            style="background-color:#2b2b2b;min-height:180px;"
            loading="eager"
          />
        </figure>

        <div class="flex flex-wrap gap-3">
          <a id="social-facebook" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
            Share on Facebook
          </a>
          <a id="social-twitter" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Share on X
          </a>
          <button id="social-copy-link" type="button" class="social-btn-outline">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy link
          </button>
          <a id="social-whatsapp" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.534 4.05 1.475 5.757L0 24l6.435-1.689A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 01-4.993-1.368l-.358-.213-3.716.975.993-3.62-.234-.372A9.799 9.799 0 012.182 12C2.182 6.565 6.565 2.182 12 2.182S21.818 6.565 21.818 12 17.435 21.818 12 21.818z"/>
            </svg>
            WhatsApp
          </a>
          <button id="social-native-share" type="button" class="social-btn-outline" hidden>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
            </svg>
            Share…
          </button>
        </div>

      </div>
    </section>

    <!-- ② Send by email -->
    <section class="bg-white py-12 px-4">
      <div class="max-w-2xl mx-auto">

        <p class="section-kicker">Send by email to your contacts</p>
        <p class="section-desc">
          This is the written message your contacts receive in their inbox.
          It is not a social post — it is a personal email that comes from you.
        </p>

        <div class="bg-wy-bone rounded-2xl border border-gray-200 p-8">

          <!-- Your name -->
          <div class="mb-6">
            <label for="share-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input
              id="share-sender"
              type="text"
              autocomplete="given-name"
              placeholder="e.g. Sarah"
              maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember"
            />
          </div>

          <!-- Email tag input -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">
                Friends' email addresses
              </label>
              <button
                id="share-contacts-btn"
                type="button"
                hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>

            <div
              id="share-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Email address list"
            >
              <input
                id="share-email-input"
                type="email"
                inputmode="email"
                autocomplete="off"
                autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent"
              />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd>Enter</kbd> or <kbd>,</kbd> after each address. Paste a comma-separated list to add several at once. Up to 10 recipients.
            </p>
          </div>

          <!-- Honeypot -->
          <input id="share-trap" name="share_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <!-- Live HTML email preview -->
          <div class="email-preview-wrap mb-6">
            <div class="email-preview-header">
              <div class="epf"><span class="epl">From:</span> Jimmy Skovgard for Wyoming &lt;support@grassrootsmvt.org&gt;</div>
              <div class="epf"><span class="epl">Subject:</span> <span id="preview-subject-line">Wyoming health care: the honest constitutional path</span></div>
            </div>
            <iframe
              id="email-preview-iframe"
              title="Preview of the email your contacts will receive"
              sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
              scrolling="yes"
              class="email-preview-iframe"
            ></iframe>
          </div>

          <!-- Status message -->
          <div id="share-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              id="share-send-btn"
              type="button"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span id="share-send-label">Have us send it</span>
            </button>
          </div>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            We send a campaign-branded email on your behalf. Recipients are not added to any mailing list.
          </p>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .share-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1ece1;
    border: 1px solid #c68a4a33;
    color: #2b2b2b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    max-width: 220px;
  }
  .share-chip span { overflow: hidden; text-overflow: ellipsis; }
  .share-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: #c68a4a55;
    color: #2b2b2b;
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .share-chip button:hover { background: #b22234; color: #fff; }

  .section-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c68a4a;
    margin-bottom: 10px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 52ch;
  }

  .survey-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: #b22234;
    color: #f1ece1;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.15s;
    line-height: 1.35;
  }
  .survey-btn:hover { background: #8b1a26; }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: #2b2b2b;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: background-color 0.15s;
  }
  .social-btn:hover { background: #b22234; }
  .social-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: transparent;
    color: #2b2b2b;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    border: 2px solid #2b2b2b;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .social-btn-outline:hover { background: #2b2b2b; color: #f1ece1; }

  #share-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #share-status.status-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
  #share-status.status-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
  #share-status.status-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }

  kbd {
    padding: 1px 5px;
    background: #f3f4f6;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
    color: #6b7280;
  }

  .email-preview-wrap {
    border: 1px solid #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .email-preview-header {
    padding: 10px 14px;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .epf { font-size: 0.8125rem; color: #374151; line-height: 1.6; }
  .epl { font-weight: 700; color: #6b7280; margin-right: 4px; }
  .email-preview-iframe {
    display: block;
    width: 100%;
    height: 520px;
    border: none;
  }
</style>

<script>
(function () {
  const PAGE_URL   = 'https://skovgard2026.org/share/changing-health-care';
  const TWEET_TEXT = 'Wyoming is facing a hard question on health care and the Constitution. The honest path is a constitutional amendment placed before the people. #Wyoming';

  const fbUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(PAGE_URL);
  const twUrl = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(PAGE_URL) +
    '&text=' + encodeURIComponent(TWEET_TEXT);

  const elFb = document.getElementById('social-facebook');
  if (elFb) elFb.href = fbUrl;
  const elTw = document.getElementById('social-twitter');
  if (elTw) elTw.href = twUrl;

  async function copyLink() {
    try {
      await navigator.clipboard.writeText(PAGE_URL);
      setStatus('Link copied!', 'success');
      setTimeout(() => setStatus('', ''), 3000);
    } catch {
      setStatus('Could not copy automatically — please copy the URL manually.', 'error');
    }
  }
  const copyLinkBtn = document.getElementById('social-copy-link');

  /* ── WhatsApp + Web Share API ───────────────────────────── */
  const elWa = document.getElementById('social-whatsapp');
  if (elWa) elWa.href = 'https://wa.me/?text=' + encodeURIComponent(PAGE_URL);

  const nativeShareBtn = document.getElementById('social-native-share');
  if (nativeShareBtn && navigator.canShare && navigator.canShare({ url: PAGE_URL })) {
    nativeShareBtn.hidden = false;
    nativeShareBtn.addEventListener('click', async () => {
      try { await navigator.share({ title: document.title, url: PAGE_URL }); }
      catch (_) {}
    });
  }
  if (copyLinkBtn) copyLinkBtn.addEventListener('click', copyLink);

  /* ── Email state ─────────────────────────────────────────── */
  const emails = [];
  const MAX = 10;

  const tagBox             = document.getElementById('share-tag-box');
  const emailInput         = document.getElementById('share-email-input');
  const senderInput        = document.getElementById('share-sender');
  const contactsBtn        = document.getElementById('share-contacts-btn');
  const previewIframe      = document.getElementById('email-preview-iframe');
  const previewSubjectLine = document.getElementById('preview-subject-line');
  const sendBtn            = document.getElementById('share-send-btn');
  const sendLabel          = document.getElementById('share-send-label');
  const statusEl           = document.getElementById('share-status');
  const trapEl             = document.getElementById('share-trap');

  function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim()); }

  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  function renderTags() {
    Array.from(tagBox.querySelectorAll('.share-chip')).forEach(c => c.remove());
    emails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'share-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">✕</button>`;
      chip.querySelector('button').addEventListener('click', () => removeEmail(i));
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons();
    schedulePreview();
  }

  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (emails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (emails.length >= MAX) { setStatus(`Maximum ${MAX} recipients per send.`, 'info'); return; }
    setStatus('', '');
    emails.push(e);
    renderTags();
  }

  function removeEmail(index) { emails.splice(index, 1); setStatus('', ''); renderTags(); }

  function updateButtons() { sendBtn.disabled = emails.length === 0 && !isValidEmail(emailInput.value.trim()); }

  /* ── Live email preview ─────────────────────────────────── */
  let previewTimer = null;

  function buildPreviewUrl() {
    const name = senderInput.value.trim().slice(0, 80);
    const params = new URLSearchParams({ slug: 'changing-health-care' });
    if (name) params.set('sender_name', name);
    return '/api/share/preview?' + params.toString();
  }

  function updateSubjectLine() {
    const name = senderInput.value.trim();
    if (previewSubjectLine) {
      previewSubjectLine.textContent = name
        ? `${name} wanted you to see this — Changing Health Care`
        : 'Wyoming health care: the honest constitutional path';
    }
  }

  async function fetchPreview() {
    updateSubjectLine();
    if (!previewIframe) return;
    try {
      const resp = await fetch(buildPreviewUrl());
      if (resp.ok) previewIframe.srcdoc = await resp.text();
    } catch (_) {}
  }

  function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(fetchPreview, 300);
  }

  senderInput.addEventListener('input', schedulePreview);

  emailInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      addEmail(emailInput.value);
      emailInput.value = '';
    } else if (e.key === 'Backspace' && emailInput.value === '' && emails.length > 0) {
      removeEmail(emails.length - 1);
    }
  });

  emailInput.addEventListener('blur', () => {
  emailInput.addEventListener('input', updateButtons);
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
  });

  emailInput.addEventListener('paste', (e) => {
    e.preventDefault();
    const pasted = (e.clipboardData || window.clipboardData).getData('text');
    pasted.split(/[,;\s\n]+/).forEach(part => { if (part.trim()) addEmail(part); });
    emailInput.value = '';
  });

  tagBox.addEventListener('click', () => emailInput.focus());

  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try {
          const picked = await navigator.contacts.select(['name', 'email'], { multiple: true });
          picked.forEach(c => (c.email || []).forEach(e => addEmail(e)));
        } catch (_) {}
      });
    } catch (_) {}
  })();

  sendBtn.addEventListener('click', async () => {
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
    if (emails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }

    sendBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setStatus('', '');

    try {
      const resp = await fetch('/api/share', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          message_slug: 'changing-health-care',
          sender_name:  senderInput.value.trim(),
          recipients:   emails.slice(),
          _trap: "",
          _t:    Date.now(),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = ['localhost','127.0.0.1'].includes(window.location.hostname);
        setStatus(
          resp.status === 404 && isLocal
            ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev'
            : resp.status === 503
            ? 'Share feature is not enabled on this environment yet.'
            : data.error || 'Something went wrong. Please try again.',
          'error'
        );
      } else {
        const n = data.sent || emails.length;
        setStatus(`Sent! ${n} message${n !== 1 ? 's' : ''} accepted for delivery. Thank you for spreading the word.`, 'success');
        emails.length = 0;
        renderTags();
      }
    } catch (_) {
      setStatus(
        ['localhost','127.0.0.1'].includes(window.location.hostname)
          ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal.'
          : 'Network error — please check your connection and try again.',
        'error'
      );
    } finally {
      sendLabel.textContent = 'Have us send it';
      updateButtons();
    }
  });

  updateButtons();
  fetchPreview();

  if (['localhost','127.0.0.1'].includes(window.location.hostname)) {
    setStatus(
      'Local dev: "Have us send it" needs the Worker running. ' +
      'In a second terminal: cd worker && npx wrangler dev.',
      'info'
    );
  }
})();
</script>
