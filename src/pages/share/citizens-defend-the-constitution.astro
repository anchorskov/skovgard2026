---
// src/pages/share/citizens-defend-the-constitution.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { MEDIA_BASE_URL } from '../../constants';
---
<Base
  title="Citizens Defend the Constitution — Skovgard 2026"
  description="A short Wyoming message on Heart Mountain, the Golden Rule, and the three pillars of this campaign: defend the Constitution, restore accountability, and listen to Wyoming."
>
  <Nav />
  <main class="pt-20">

    <!-- Breadcrumb bar -->
    <div class="bg-wy-bone border-b border-gray-200 py-3 px-4">
      <div class="max-w-3xl mx-auto flex items-center gap-3">
        <a href="/share" class="inline-flex items-center gap-1.5 text-gray-400 hover:text-wy-ember text-xs font-semibold uppercase tracking-widest transition-colors shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All messages
        </a>
        <span class="text-gray-300 text-sm">/</span>
        <span class="text-sm font-semibold text-wy-charcoal truncate">Citizens Defend the Constitution</span>
      </div>
    </div>

    <!-- Hero -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Featured Message</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-wy-bone mb-4 leading-tight">
        Citizens Defend the Constitution
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto mb-8">
        Heart Mountain. The Golden Rule. The three pillars of this campaign.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="hero-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="hero-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="hero-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

    <!-- ① Watch & share -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Watch &amp; share</p>
        <p class="section-desc">
          Watch the video, then share this page on Facebook or X — or copy the link and send it yourself.
          When someone clicks through, they land here and can watch it too.
        </p>

        <!-- Video player -->
        <div class="rounded-xl overflow-hidden shadow-lg mb-7 bg-black">
          <video
            controls
            preload="metadata"
            class="w-full block"
            style="max-height:480px;"
          >
            <source src={`${MEDIA_BASE_URL}/videos/Jimmy_6-14.mp4`} type="video/mp4" />
          </video>
        </div>

        <div class="mb-2">
          <p class="text-xs font-bold uppercase tracking-widest text-wy-sandstone mb-1">June 2026 · Video · 4:54</p>
          <p class="font-serif font-extrabold text-wy-charcoal text-xl mb-1">Three Pillars of the Campaign</p>
          <p class="text-gray-600 text-sm">Citizens defend the Constitution. Public servants swear the oath.</p>
        </div>

        <div class="flex flex-wrap gap-3 mt-6">
          <a id="social-facebook" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
            Share on Facebook
          </a>
          <a id="social-twitter" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Share on X
          </a>
          <button id="social-copy-link" type="button" class="social-btn-outline">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy link
          </button>
        </div>

      </div>
    </section>

    <!-- ② Send by email -->
    <section class="bg-white py-12 px-4">
      <div class="max-w-2xl mx-auto">

        <p class="section-kicker">Send by email to your contacts</p>
        <p class="section-desc">
          This is the written message your contacts receive in their inbox.
          It is not the video above — it is a personal email that comes from you, with a link to watch it.
        </p>

        <div class="bg-wy-bone rounded-2xl border border-gray-200 p-8">

          <!-- Your name -->
          <div class="mb-6">
            <label for="share-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input
              id="share-sender"
              type="text"
              autocomplete="given-name"
              placeholder="e.g. Sarah"
              maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember"
            />
          </div>

          <!-- Email tag input -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">
                Friends' email addresses
              </label>
              <button
                id="share-contacts-btn"
                type="button"
                hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>

            <div
              id="share-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Email address list"
            >
              <input
                id="share-email-input"
                type="email"
                inputmode="email"
                autocomplete="off"
                autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent"
              />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd>Enter</kbd> or <kbd>,</kbd> after each address. Paste a comma-separated list to add several at once. Up to 10 recipients.
            </p>
          </div>

          <!-- Honeypot -->
          <input id="share-trap" name="share_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <!-- Live HTML email preview -->
          <div class="email-preview-wrap mb-6">
            <div class="email-preview-header">
              <div class="epf"><span class="epl">From:</span> Jimmy Skovgard for Wyoming &lt;support@grassrootsmvt.org&gt;</div>
              <div class="epf"><span class="epl">Subject:</span> <span id="preview-subject-line">Citizens defend the Constitution — a Wyoming message from Jimmy Skovgard</span></div>
            </div>
            <iframe
              id="email-preview-iframe"
              title="Preview of the email your contacts will receive"
              sandbox="allow-same-origin"
              scrolling="yes"
              class="email-preview-iframe"
            ></iframe>
          </div>

          <!-- Status message -->
          <div id="share-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              id="share-send-btn"
              type="button"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span id="share-send-label">Have us send it</span>
            </button>
          </div>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            We send a campaign-branded email on your behalf. Recipients are not added to any mailing list.
          </p>
        </div>

      </div>
    </section>

    <!-- Three pillars -->
    <section class="bg-white py-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-widest text-wy-sandstone mb-4">Three Pillars of the Campaign</p>
        <div class="grid sm:grid-cols-3 gap-6 text-left">
          {[
            { n: '1', head: 'Defend the Constitution', body: 'The oath still matters. Wyoming deserves a Senator who takes it seriously.' },
            { n: '2', head: 'Restore Accountability', body: 'Public servants answer to Wyoming — not to party insiders, donors, or Washington.' },
            { n: '3', head: 'Listen to Wyoming', body: 'Real decisions require real input. From ranch roads to main streets, Wyoming voices count.' },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-wy-ember font-serif font-extrabold text-2xl leading-none mt-0.5">{item.n}.</span>
              <div>
                <h3 class="font-semibold text-wy-charcoal mb-1">{item.head}</h3>
                <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-12">
          <a href="/share" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-wy-ember transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            More messages to share
          </a>
        </div>
      </div>
    </section>

    <!-- Bottom share bar -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Spread the Word</p>
      <p class="text-wy-bone/70 text-sm mb-6 max-w-md mx-auto">
        One message from someone you know carries more weight than any ad. Share this with Wyoming neighbors.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="footer-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="footer-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="footer-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

  </main>
  <Footer />
</Base>

<style>
  .share-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1ece1;
    border: 1px solid #c68a4a33;
    color: #2b2b2b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    max-width: 220px;
  }
  .share-chip span { overflow: hidden; text-overflow: ellipsis; }
  .share-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: #c68a4a55;
    color: #2b2b2b;
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .share-chip button:hover { background: #b22234; color: #fff; }

  .section-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c68a4a;
    margin-bottom: 6px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 52ch;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: #2b2b2b;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: background-color 0.15s;
  }
  .social-btn:hover { background: #b22234; }
  .social-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: transparent;
    color: #2b2b2b;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    border: 2px solid #2b2b2b;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .social-btn-outline:hover { background: #2b2b2b; color: #f1ece1; }

  .share-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border: 2px solid rgba(241, 236, 225, 0.45);
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .share-btn-outline:hover {
    background-color: rgba(241, 236, 225, 0.1);
    border-color: #f1ece1;
  }

  .email-preview-wrap {
    border: 1px solid #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .email-preview-header {
    padding: 10px 14px;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .epf { font-size: 0.8125rem; color: #374151; line-height: 1.6; }
  .epl { font-weight: 700; color: #6b7280; margin-right: 4px; }
  .email-preview-iframe { display: block; width: 100%; height: 460px; border: none; }

  #share-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #share-status.status-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
  #share-status.status-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
  #share-status.status-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }

  kbd {
    padding: 1px 5px;
    background: #f3f4f6;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
    color: #6b7280;
  }
</style>

<script>
(function () {
  const PAGE_URL = 'https://skovgard2026.org/share/citizens-defend-the-constitution';
  const tweetText = 'Citizens defend the Constitution. Public servants swear the oath. Wyoming deserves a Senator who takes that oath seriously. — Jimmy Skovgard for U.S. Senate 2026';

  const fbUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(PAGE_URL);
  const twUrl = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(PAGE_URL) +
    '&text=' + encodeURIComponent(tweetText);

  ['hero-facebook', 'social-facebook', 'footer-facebook'].forEach(id => { const el = document.getElementById(id); if (el) el.href = fbUrl; });
  ['hero-twitter',  'social-twitter',  'footer-twitter' ].forEach(id => { const el = document.getElementById(id); if (el) el.href = twUrl; });

  async function copyLink(btnId) {
    try {
      await navigator.clipboard.writeText(PAGE_URL);
      const btn = document.getElementById(btnId);
      if (btn) {
        const orig = btn.innerHTML;
        btn.innerHTML = btn.innerHTML.replace(/Copy link/, 'Copied!');
        setTimeout(() => { btn.innerHTML = orig; }, 2000);
      }
    } catch { setStatus('Could not copy — please copy the URL manually.', 'error'); }
  }

  ['hero-copy-link', 'social-copy-link', 'footer-copy-link']
    .forEach(id => { const btn = document.getElementById(id); if (btn) btn.addEventListener('click', () => copyLink(id)); });

  /* ── Email state ─────────────────────────────────────────── */
  const emails = [];
  const MAX    = 10;

  const tagBox             = document.getElementById('share-tag-box');
  const emailInput         = document.getElementById('share-email-input');
  const senderInput        = document.getElementById('share-sender');
  const contactsBtn        = document.getElementById('share-contacts-btn');
  const previewIframe      = document.getElementById('email-preview-iframe');
  const previewSubjectLine = document.getElementById('preview-subject-line');
  const sendBtn            = document.getElementById('share-send-btn');
  const sendLabel          = document.getElementById('share-send-label');
  const statusEl           = document.getElementById('share-status');

  function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim()); }

  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  function renderTags() {
    Array.from(tagBox.querySelectorAll('.share-chip')).forEach(c => c.remove());
    emails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'share-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">✕</button>`;
      chip.querySelector('button').addEventListener('click', () => removeEmail(i));
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons();
    schedulePreview();
  }

  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (emails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (emails.length >= MAX) { setStatus(`Maximum ${MAX} recipients per send.`, 'info'); return; }
    setStatus('', '');
    emails.push(e);
    renderTags();
  }

  function removeEmail(index) { emails.splice(index, 1); setStatus('', ''); renderTags(); }

  function updateButtons() { sendBtn.disabled = emails.length === 0; }

  let previewTimer = null;

  function buildPreviewUrl() {
    const name = senderInput.value.trim().slice(0, 80);
    const params = new URLSearchParams({ slug: 'citizens-defend-the-constitution' });
    if (name) params.set('sender_name', name);
    return '/api/share/preview?' + params.toString();
  }

  function updateSubjectLine() {
    const name = senderInput.value.trim();
    if (previewSubjectLine) {
      previewSubjectLine.textContent = name
        ? `${name} wanted you to see this — Citizens Defend the Constitution`
        : 'Citizens defend the Constitution — a Wyoming message from Jimmy Skovgard';
    }
  }

  async function fetchPreview() {
    updateSubjectLine();
    if (!previewIframe) return;
    try {
      const resp = await fetch(buildPreviewUrl());
      if (resp.ok) previewIframe.srcdoc = await resp.text();
    } catch (_) {}
  }

  function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(fetchPreview, 300);
  }

  senderInput.addEventListener('input', schedulePreview);

  emailInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addEmail(emailInput.value); emailInput.value = ''; }
    else if (e.key === 'Backspace' && emailInput.value === '' && emails.length > 0) { removeEmail(emails.length - 1); }
  });
  emailInput.addEventListener('blur', () => { if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; } });
  emailInput.addEventListener('paste', e => {
    e.preventDefault();
    (e.clipboardData || window.clipboardData).getData('text').split(/[,;\s\n]+/).forEach(p => { if (p.trim()) addEmail(p); });
    emailInput.value = '';
  });
  tagBox.addEventListener('click', () => emailInput.focus());

  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try { const picked = await navigator.contacts.select(['name', 'email'], { multiple: true }); picked.forEach(c => (c.email || []).forEach(e => addEmail(e))); } catch (_) {}
      });
    } catch (_) {}
  })();

  sendBtn.addEventListener('click', async () => {
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
    if (emails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }

    sendBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setStatus('', '');

    try {
      const resp = await fetch('/api/share', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          message_slug: 'citizens-defend-the-constitution',
          sender_name:  senderInput.value.trim(),
          recipients:   emails.slice(),
          _trap: "",
          _t:    Date.now(),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        setStatus(
          resp.status === 404 && isLocal
            ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev'
            : resp.status === 503
            ? 'Share feature is not enabled on this environment yet.'
            : data.error || 'Something went wrong. Please try again.',
          'error'
        );
      } else {
        const n = data.sent || emails.length;
        setStatus(`Sent! ${n} message${n !== 1 ? 's' : ''} accepted for delivery. Thank you for spreading the word.`, 'success');
        emails.length = 0;
        renderTags();
      }
    } catch (_) {
      setStatus(
        ['localhost', '127.0.0.1'].includes(window.location.hostname)
          ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal.'
          : 'Network error — please check your connection and try again.',
        'error'
      );
    } finally {
      sendLabel.textContent = 'Have us send it';
      updateButtons();
    }
  });

  updateButtons();
  fetchPreview();

  if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
    setStatus(
      'Local dev: "Have us send it" needs the Worker running. ' +
      'In a second terminal: cd worker && npx wrangler dev.',
      'info'
    );
  }
})();
</script>
