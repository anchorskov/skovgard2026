---
// src/pages/share/fleecing-letters.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="The Fleecing Letters — Skovgard 2026"
  description="Two official letters arrived in Wyoming mailboxes on congressional letterhead — both paid for by public funds. An analysis of the fear, deflection, and tactics used."
  ogImage="/images/share/meme-fleecing-letters.png"
>
  <Nav />
  <main class="pt-20">

    <!-- Breadcrumb -->
    <div class="bg-wy-bone border-b border-gray-200 py-3 px-4">
      <div class="max-w-3xl mx-auto flex items-center gap-3">
        <a href="/share" class="inline-flex items-center gap-1.5 text-gray-400 hover:text-wy-ember text-xs font-semibold uppercase tracking-widest transition-colors shrink-0">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All messages
        </a>
        <span class="text-gray-300 text-sm">/</span>
        <span class="text-sm font-semibold text-wy-charcoal truncate">The Fleecing Letters</span>
      </div>
    </div>

    <!-- Hero -->
    <div class="bg-wy-charcoal py-16 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Official Accountability</p>
      <h1 class="text-3xl sm:text-4xl font-serif font-extrabold text-wy-bone mb-3 leading-tight max-w-2xl mx-auto">
        The Fleecing Letters
      </h1>
      <p class="text-wy-sandstone font-semibold text-base sm:text-lg mb-6 tracking-wide">
        Taxpayer-funded mail deserves taxpayer-level inspection.
      </p>
      <p class="text-wy-bone/75 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
        Two letters arrived in Wyoming mailboxes on official congressional letterhead. Both stated
        &#8220;PAID FOR BY OFFICIAL FUNDS AUTHORIZED BY THE HOUSE OF REPRESENTATIVES.&#8221;
        Both used fear, blame, and campaign-style framing at public expense.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="hero-copy-msg" type="button"
          class="inline-flex items-center gap-2 px-6 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="hero-copy-label">Copy Share Message</span>
        </button>
      </div>
      <p id="hero-copy-confirm" class="mt-4 text-wy-sandstone text-sm font-semibold hidden">
        Copied. Now send it to three Wyoming neighbors.
      </p>
    </div>

    <!-- Main analysis -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-2xl mx-auto">

        <p class="section-kicker">The Letter Behind the Letter</p>

        <!-- Intro -->
        <p class="body-prose">
          Two letters arrived in Wyoming mailboxes on official congressional letterhead. And they carried
          the weight of public office. Both stated &#8220;PAID FOR BY OFFICIAL FUNDS AUTHORIZED BY THE
          HOUSE OF REPRESENTATIVES.&#8221;
        </p>
        <p class="body-prose">
          This is about how our tax dollars &#8212; or should we say our grandchildren&#8217;s tax dollars &#8212;
          are being misused by Harriet Hageman to shape public opinion.
          We deserve clean information, honest costs, and public resources that serve the public.
        </p>

        <!-- The Question -->
        <div class="question-block">
          <p class="question-label">The Question</p>
          <p class="body-prose-sm">
            When official mail uses fear, blame, and campaign-style defense of a public record, we have a right to ask:
          </p>
          <ul class="question-list">
            <li>Who paid for it?</li>
            <li>Why were the letters sent now?</li>
            <li>How much did they cost?</li>
            <li>What facts were included?</li>
            <li>What facts were left out?</li>
          </ul>
        </div>

        <!-- Tactics heading -->
        <h2 class="tactics-head">How Harriet&#8217;s Letters Work</h2>

        <!-- 1 -->
        <div class="summary-section">
          <div class="summary-num">1</div>
          <div class="summary-body">
            <h3 class="summary-head">Both letters begin with fear.</h3>
            <p class="body-prose">
              The messages point to danger, crisis, unsafe roads, blocked access, fires, bureaucracy,
              and outside threats. Fear is powerful because it narrows attention.
            </p>
            <div class="quote-box">
              <p class="quote-text">When fear comes first, we react before we reflect.</p>
            </div>
          </div>
        </div>

        <!-- 2 -->
        <div class="summary-section">
          <div class="summary-num">2</div>
          <div class="summary-body">
            <h3 class="summary-head">The letters deflect responsibility.</h3>
            <p class="body-prose">
              The message points frustration toward critics, agencies, outsiders, and national political fights.
              That turns a policy question into a blame story.
            </p>
            <p class="body-prose">
              Deflection works by moving our attention away from the person sending the letter and toward someone else.
            </p>
            <p class="body-prose">
              Representative Hageman has served in Congress since January 2023. She has held federal office for more
              than three years while many of the problems described in these letters continued to grow. Yet the letters
              paint the picture as if responsibility lives somewhere else.
            </p>
            <div class="callout-box">
              <p class="callout-text">That is the move worth noticing.</p>
            </div>
            <p class="body-prose">Good public communication says:</p>
            <ul class="body-list">
              <li>Here is the problem.</li>
              <li>Here is my role in it.</li>
              <li>Here is what I have done.</li>
              <li>Here is what still has not worked.</li>
              <li>Here is what I will do next.</li>
            </ul>
            <p class="body-prose">Deflection says: <em>Look over there.</em></p>
            <p class="body-prose">Wyoming deserves the first kind.</p>
          </div>
        </div>

        <!-- 3 -->
        <div class="summary-section">
          <div class="summary-num">3</div>
          <div class="summary-body">
            <h3 class="summary-head">The letters borrow official authority.</h3>
            <p class="body-prose">
              The letter arrives on official congressional letterhead. It looks like a public update.
              That gives the message the weight of government authority.
            </p>
            <div class="quote-box">
              <p class="quote-text">That is exactly why official funds require careful guardrails.</p>
            </div>
          </div>
        </div>

        <!-- 4 -->
        <div class="summary-section">
          <div class="summary-num">4</div>
          <div class="summary-body">
            <h3 class="summary-head">They build a proof pile.</h3>
            <p class="body-prose">
              A long list of bills, hearings, rules, agencies, and actions can feel like proof.
              But volume is not the same as clarity.
            </p>
            <div class="quote-box">
              <p class="quote-text">Wyoming deserves plain facts, real costs, and side-by-side tradeoffs.</p>
            </div>
          </div>
        </div>

        <!-- 5 -->
        <div class="summary-section">
          <div class="summary-num">5</div>
          <div class="summary-body">
            <h3 class="summary-head">The letters skip the middle.</h3>
            <p class="body-prose">The middle is where the real debate belongs.</p>
            <ul class="body-list">
              <li>What are the options?</li>
              <li>What are the costs?</li>
              <li>Who benefits?</li>
              <li>Who pays?</li>
              <li>What happens next?</li>
            </ul>
            <p class="body-prose">A good public letter answers those questions clearly.</p>
          </div>
        </div>

        <!-- What Clean Public Mail Looks Like -->
        <div class="clean-mail-box">
          <p class="clean-mail-label">What Clean Public Mail Looks Like</p>
          <p class="body-prose">Clean public mail does not use labels to dismiss concern.</p>
          <p class="body-prose">Clean public mail does not turn neighbors into targets.</p>
          <p class="body-prose">Clean public mail gives sources, costs, tradeoffs, and next steps.</p>
          <p class="body-prose" style="margin-bottom:0;">Clean public mail helps us think.</p>
        </div>

        <!-- The Standard + PDF links -->
        <div class="standard-block">
          <p class="standard-label">The Standard</p>
          <p class="body-prose">I am not asking Wyoming to agree with me on every issue.</p>
          <p class="body-prose">I am asking us to slow down and inspect how official power is used.</p>
          <p class="body-prose">
            We can disagree on public lands, trucking, immigration, housing, energy, and federal management.
            But we can agree on one thing:
          </p>
          <div class="quote-box">
            <p class="quote-text">Public money must serve the public.</p>
          </div>
          <p class="body-prose">Read the letters. Follow the money. Ask better questions.</p>
          <div class="doc-links">
            <a href="/docs/hageman-june-12-letter.pdf" target="_blank" rel="noopener" class="view-letter-link">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              Read the June 12 letter (PDF)
            </a>
            <a href="/docs/hageman-june-15-letter.pdf" target="_blank" rel="noopener" class="view-letter-link">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 002 2z" />
              </svg>
              Read the June 15 letter (PDF)
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- ① Share on social media -->
    <section class="bg-white py-12 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="section-kicker">Share on social media</p>
        <p class="section-desc">
          This is what people see when you post the link on Facebook or X.
          When someone clicks through, they land here with both letters linked.
        </p>
        <figure class="rounded-xl overflow-hidden shadow-lg mb-7">
          <img
            src="/images/share/meme-fleecing-letters.png"
            alt="Fleeced and Distracted — an analysis of two official congressional letters sent to Wyoming households at public expense"
            class="w-full block"
            style="background-color:#2b2b2b;min-height:180px;"
            loading="eager"
          />
        </figure>
        <div class="flex flex-wrap gap-3">
          <a id="social-facebook" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
            Share on Facebook
          </a>
          <a id="social-twitter" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Share on X
          </a>
          <button id="social-copy-link" type="button" class="social-btn-outline">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy link
          </button>
        </div>
      </div>
    </section>

    <!-- ② Send by email -->
    <section class="bg-wy-bone py-12 px-4" id="send-email">
      <div class="max-w-2xl mx-auto">
        <p class="section-kicker">Send by email to your contacts</p>
        <p class="section-desc">
          This is the written message your contacts receive in their inbox.
          It is not the image above&#8212;it is a personal email that comes from you.
        </p>
        <div class="bg-white rounded-2xl border border-gray-200 p-8">

          <div class="mb-6">
            <label for="share-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input id="share-sender" type="text" autocomplete="given-name" placeholder="e.g. Sarah" maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base bg-white focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember" />
          </div>

          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">Friends' email addresses</label>
              <button id="share-contacts-btn" type="button" hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>
            <div id="share-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Email address list">
              <input id="share-email-input" type="email" inputmode="email" autocomplete="off" autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent" />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd>Enter</kbd> or <kbd>,</kbd> after each address. Up to 10 recipients.
            </p>
          </div>

          <input id="share-trap" name="share_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <div class="email-preview-wrap mb-6">
            <div class="email-preview-header">
              <div class="epf"><span class="epl">From:</span> Jimmy Skovgard for Wyoming &lt;support@grassrootsmvt.org&gt;</div>
              <div class="epf"><span class="epl">Subject:</span> <span id="preview-subject-line">Official mail paid for by you. Here&#8217;s what&#8217;s in it.</span></div>
            </div>
            <iframe id="email-preview-iframe" title="Preview of the email your contacts will receive"
              sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" scrolling="yes" class="email-preview-iframe"></iframe>
          </div>

          <div id="share-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <div class="flex flex-col sm:flex-row gap-3">
            <button id="share-send-btn" type="button"
              class="flex-1 flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span id="share-send-label">Have us send it</span>
            </button>
          </div>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            We send a campaign-branded email on your behalf. Recipients are not added to any mailing list.
          </p>
        </div>
      </div>
    </section>

    <!-- Why share -->
    <section class="bg-white pt-4 pb-16 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="grid sm:grid-cols-3 gap-6 text-left mb-12">
          {[
            { n: '1', head: 'The letters are public', body: 'Both congressional mailings are linked on this page. "PAID FOR BY OFFICIAL FUNDS" is printed on the letters themselves.' },
            { n: '2', head: 'The tactics are named', body: 'Fear, deflection, borrowed authority, proof piles, and skipping the middle are shown in the actual letters — not asserted.' },
            { n: '3', head: 'The standard is clear', body: "Public money must serve the public — not the incumbent's reelection. That standard applies to everyone." },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-wy-ember font-serif font-extrabold text-2xl leading-none mt-0.5">{item.n}.</span>
              <div>
                <h3 class="font-semibold text-wy-charcoal mb-1">{item.head}</h3>
                <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
        <a href="/share" class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-wy-ember transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          More messages to share
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .body-prose { font-size: 1rem; line-height: 1.75; color: #2b2b2b; margin: 0 0 18px; }
  .body-prose-sm { font-size: 0.9375rem; line-height: 1.7; color: #2b2b2b; margin: 0 0 12px; }
  .section-kicker { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #c68a4a; margin-bottom: 6px; }
  .section-desc { font-size: 0.9rem; color: #6b7280; line-height: 1.6; margin-bottom: 20px; max-width: 52ch; }

  .question-block { background: #f7f3ec; border-left: 4px solid #c68a4a; border-radius: 0 10px 10px 0; padding: 18px 22px; margin: 0 0 28px; }
  .question-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #c68a4a; margin: 0 0 10px; }
  .question-list { margin: 0; padding: 0 0 0 20px; list-style: disc; }
  .question-list li { font-size: 0.9375rem; line-height: 1.7; color: #2b2b2b; margin-bottom: 4px; }

  .tactics-head { font-family: 'Bitter', serif; font-size: 1.3rem; font-weight: 800; color: #0f2742; margin: 0 0 24px; padding-top: 12px; border-top: 1px solid #e5ddd0; }

  .body-list { margin: 0 0 18px; padding: 0 0 0 22px; list-style: disc; }
  .body-list li { font-size: 1rem; line-height: 1.75; color: #2b2b2b; margin-bottom: 2px; }

  .summary-section { display: flex; gap: 20px; margin-bottom: 36px; padding-bottom: 36px; border-bottom: 1px solid #e5ddd0; }
  .summary-section:last-of-type { border-bottom: none; margin-bottom: 0; }
  .summary-num { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: #b22234; color: #f1ece1; font-family: 'Bitter', serif; font-weight: 800; font-size: 1rem; display: flex; align-items: center; justify-content: center; margin-top: 4px; }
  .summary-body { flex: 1; min-width: 0; }
  .summary-head { font-family: 'Bitter', serif; font-size: 1.15rem; font-weight: 700; color: #0f2742; margin: 0 0 14px; line-height: 1.3; }

  .quote-box { background: #f9f6f0; border-left: 4px solid #c68a4a; border-radius: 0 10px 10px 0; padding: 14px 18px; margin: 0 0 18px; }
  .quote-text { font-size: 0.9375rem; line-height: 1.6; color: #2b2b2b; margin: 0; font-style: italic; }

  .callout-box { background: #fef2f2; border-left: 4px solid #b22234; border-radius: 0 10px 10px 0; padding: 14px 18px; margin: 0 0 18px; }
  .callout-text { font-size: 0.9375rem; line-height: 1.6; color: #7f1d1d; margin: 0; font-style: italic; font-weight: 600; }

  .clean-mail-box { background: #f0f4ec; border: 1px solid #c6d4b8; border-radius: 12px; padding: 22px 24px; margin: 36px 0 28px; }
  .clean-mail-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #7a8a6b; margin: 0 0 14px; }

  .standard-block { padding-top: 28px; border-top: 1px solid #e5ddd0; margin-top: 8px; }
  .standard-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #c68a4a; margin: 0 0 14px; }

  .view-letter-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 0.8125rem; font-weight: 700; color: #0f2742; text-decoration: none; }
  .view-letter-link:hover { color: #b22234; text-decoration: underline; }
  .doc-links { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }

  .social-btn { display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px; background: #2b2b2b; color: #f1ece1; font-weight: 700; font-size: 0.875rem; border-radius: 8px; text-decoration: none; cursor: pointer; border: none; transition: background-color 0.15s; }
  .social-btn:hover { background: #b22234; }
  .social-btn-outline { display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px; background: transparent; color: #2b2b2b; font-weight: 700; font-size: 0.875rem; border-radius: 8px; border: 2px solid #2b2b2b; cursor: pointer; transition: background-color 0.15s, color 0.15s; }
  .social-btn-outline:hover { background: #2b2b2b; color: #f1ece1; }

  .share-chip { display: inline-flex; align-items: center; gap: 4px; background: #f1ece1; border: 1px solid #c68a4a33; color: #2b2b2b; font-size: 0.8rem; font-weight: 500; padding: 2px 8px 2px 10px; border-radius: 999px; white-space: nowrap; max-width: 220px; }
  .share-chip span { overflow: hidden; text-overflow: ellipsis; }
  .share-chip button { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; border: none; background: #c68a4a55; color: #2b2b2b; cursor: pointer; font-size: 10px; line-height: 1; padding: 0; flex-shrink: 0; }
  .share-chip button:hover { background: #b22234; color: #fff; }

  .email-preview-wrap { border: 1px solid #d1d5db; border-radius: 12px; overflow: hidden; background: #fff; }
  .email-preview-header { padding: 10px 14px; background: #f9fafb; border-bottom: 1px solid #e5e7eb; }
  .epf { font-size: 0.8125rem; color: #374151; line-height: 1.6; }
  .epl { font-weight: 700; color: #6b7280; margin-right: 4px; }
  .email-preview-iframe { display: block; width: 100%; height: 460px; border: none; }

  #share-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #share-status.status-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
  #share-status.status-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
  #share-status.status-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }

  kbd { padding: 1px 5px; background: #f3f4f6; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 0.8em; color: #6b7280; }
</style>

<script>
(function () {
  const PAGE_URL = 'https://skovgard2026.org/share/fleecing-letters/';

  const SHARE_MESSAGE =
    'Two official congressional letters. Both marked:\n' +
    '"PAID FOR BY OFFICIAL FUNDS AUTHORIZED BY THE HOUSE OF REPRESENTATIVES."\n\n' +
    'How these letters work:\n\n' +
    '1. Both begin with fear — danger, crisis, fires, outside threats. When fear comes first, we react before we reflect.\n\n' +
    '2. They deflect responsibility. Rep. Hageman has held office for more than three years while the problems in these letters continued to grow. The letters paint responsibility as living somewhere else.\n\n' +
    '3. Official letterhead lends the weight of government authority to what is essentially a campaign defense.\n\n' +
    '4. Volume is not clarity. A long list of bills and hearings feels like proof — it is not the same as facts, costs, and tradeoffs.\n\n' +
    '5. The middle gets skipped. What are the options? Costs? Who benefits? Who pays? Good public mail answers those questions.\n\n' +
    'Public money must serve the public.\n\n' +
    'Read the letters. Follow the money. Ask better questions.\n' +
    'https://skovgard2026.org/share/fleecing-letters/';

  const tweetText = 'Two official letters. Congressional letterhead. "PAID FOR BY OFFICIAL FUNDS." Fear, deflection, and skipped questions — at taxpayer expense. Wyoming deserves clean information. #Wyoming';
  const fbUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(PAGE_URL);
  const twUrl = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(PAGE_URL) + '&text=' + encodeURIComponent(tweetText);

  const elFb = document.getElementById('social-facebook');
  if (elFb) elFb.href = fbUrl;
  const elTw = document.getElementById('social-twitter');
  if (elTw) elTw.href = twUrl;

  async function copyShareMessage(labelEl, confirmEl) {
    try {
      await navigator.clipboard.writeText(SHARE_MESSAGE);
      if (labelEl) labelEl.textContent = 'Copied!';
      if (confirmEl) confirmEl.classList.remove('hidden');
      setTimeout(() => {
        if (labelEl) labelEl.textContent = 'Copy Share Message';
        if (confirmEl) confirmEl.classList.add('hidden');
      }, 3500);
    } catch {
      if (labelEl) labelEl.textContent = 'Copy failed — try selecting the text above.';
      setTimeout(() => { if (labelEl) labelEl.textContent = 'Copy Share Message'; }, 3500);
    }
  }

  const heroCopyBtn     = document.getElementById('hero-copy-msg');
  const heroCopyLabel   = document.getElementById('hero-copy-label');
  const heroCopyConfirm = document.getElementById('hero-copy-confirm');
  if (heroCopyBtn) heroCopyBtn.addEventListener('click', () => copyShareMessage(heroCopyLabel, heroCopyConfirm));

  const copyLinkBtn = document.getElementById('social-copy-link');
  if (copyLinkBtn) {
    copyLinkBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(PAGE_URL); setStatus('Link copied!', 'success'); setTimeout(() => setStatus('', ''), 3000); }
      catch { setStatus('Could not copy automatically. Please copy the URL manually.', 'error'); }
    });
  }

  const emails = [];
  const MAX = 10;
  const tagBox             = document.getElementById('share-tag-box');
  const emailInput         = document.getElementById('share-email-input');
  const senderInput        = document.getElementById('share-sender');
  const contactsBtn        = document.getElementById('share-contacts-btn');
  const previewIframe      = document.getElementById('email-preview-iframe');
  const previewSubjectLine = document.getElementById('preview-subject-line');
  const sendBtn            = document.getElementById('share-send-btn');
  const sendLabel          = document.getElementById('share-send-label');
  const statusEl           = document.getElementById('share-status');

  function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim()); }
  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }
  function renderTags() {
    Array.from(tagBox.querySelectorAll('.share-chip')).forEach(c => c.remove());
    emails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'share-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">&#x2715;</button>`;
      chip.querySelector('button').addEventListener('click', () => removeEmail(i));
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons(); schedulePreview();
  }
  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (emails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (emails.length >= MAX) { setStatus(`Maximum ${MAX} recipients per send.`, 'info'); return; }
    setStatus('', ''); emails.push(e); renderTags();
  }
  function removeEmail(index) { emails.splice(index, 1); setStatus('', ''); renderTags(); }
  function updateButtons() { sendBtn.disabled = emails.length === 0; }

  let previewTimer = null;
  function buildPreviewUrl() {
    const name = senderInput.value.trim().slice(0, 80);
    const params = new URLSearchParams({ slug: 'fleecing-letters' });
    if (name) params.set('sender_name', name);
    return '/api/share/preview?' + params.toString();
  }
  function updateSubjectLine() {
    const name = senderInput.value.trim();
    if (previewSubjectLine) {
      previewSubjectLine.textContent = name
        ? `${name} wanted you to see this — The Fleecing Letters`
        : 'Official mail paid for by you. Here’s what’s in it.';
    }
  }
  async function fetchPreview() {
    updateSubjectLine();
    if (!previewIframe) return;
    try { const resp = await fetch(buildPreviewUrl()); if (resp.ok) previewIframe.srcdoc = await resp.text(); } catch (_) {}
  }
  function schedulePreview() { clearTimeout(previewTimer); previewTimer = setTimeout(fetchPreview, 300); }
  senderInput.addEventListener('input', schedulePreview);

  emailInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addEmail(emailInput.value); emailInput.value = ''; }
    else if (e.key === 'Backspace' && emailInput.value === '' && emails.length > 0) { removeEmail(emails.length - 1); }
  });
  emailInput.addEventListener('blur', () => { if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; } });
  emailInput.addEventListener('paste', e => {
    e.preventDefault();
    (e.clipboardData || window.clipboardData).getData('text').split(/[,;\s\n]+/).forEach(p => { if (p.trim()) addEmail(p); });
    emailInput.value = '';
  });
  tagBox.addEventListener('click', () => emailInput.focus());

  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try { const picked = await navigator.contacts.select(['name', 'email'], { multiple: true }); picked.forEach(c => (c.email || []).forEach(e => addEmail(e))); } catch (_) {}
      });
    } catch (_) {}
  })();

  sendBtn.addEventListener('click', async () => {
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
    if (emails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }
    sendBtn.disabled = true; sendLabel.textContent = 'Sending…'; setStatus('', '');
    try {
      const resp = await fetch('/api/share', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message_slug: 'fleecing-letters', sender_name: senderInput.value.trim(), recipients: emails.slice(), _trap: "", _t: Date.now() }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        setStatus(resp.status === 404 && isLocal ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev' : resp.status === 503 ? 'Share feature is not enabled on this environment yet.' : data.error || 'Something went wrong. Please try again.', 'error');
      } else {
        const n = data.sent || emails.length;
        setStatus(`Sent! ${n} message${n !== 1 ? 's' : ''} accepted for delivery. Thank you for spreading the word.`, 'success');
        emails.length = 0; renderTags();
      }
    } catch (_) {
      setStatus(['localhost', '127.0.0.1'].includes(window.location.hostname) ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal.' : 'Network error — please check your connection and try again.', 'error');
    } finally { sendLabel.textContent = 'Have us send it'; updateButtons(); }
  });

  updateButtons(); fetchPreview();
  if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
    setStatus('Local dev: "Have us send it" needs the Worker running. In a second terminal: cd worker && npx wrangler dev.', 'info');
  }
})();
</script>
