---
// src/pages/share/freedom-or-control/sources.astro
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<Base
  title="Sources — Freedom or Control? — Skovgard 2026"
  description="Public sources and evidence documenting outside political influence in Wyoming's 2026 primary elections."
>
  <Nav />
  <main class="pt-20">

    <!-- Breadcrumb -->
    <div class="bg-wy-bone border-b border-gray-200 py-3 px-4">
      <div class="max-w-3xl mx-auto flex items-center gap-2 flex-wrap text-xs font-semibold uppercase tracking-widest">
        <a href="/share" class="text-gray-400 hover:text-wy-ember transition-colors">All messages</a>
        <span class="text-gray-300">/</span>
        <a href="/share/freedom-or-control" class="text-gray-400 hover:text-wy-ember transition-colors">Freedom or Control?</a>
        <span class="text-gray-300">/</span>
        <span class="text-wy-charcoal">Sources</span>
      </div>
    </div>

    <!-- Header -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Evidence &amp; Sources</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold text-wy-bone mb-4 leading-tight">
        Freedom or Control?
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto">
        Public sources documenting outside political influence in Wyoming.
        Review the original sources yourself.
      </p>
    </div>

    <!-- About this page -->
    <section class="bg-wy-bone border-b border-gray-200 py-10 px-4">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white border border-gray-200 rounded-xl px-6 py-5 flex gap-4 items-start">
          <div class="shrink-0 w-8 h-8 rounded-full bg-wy-sandstone/20 flex items-center justify-center mt-0.5">
            <svg class="w-4 h-4 text-wy-sandstone" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-700 leading-relaxed">
              <strong>About this page.</strong> This page documents the publicly available sources
              behind the Freedom or Control share message. The goal is to encourage informed
              discussion and allow every reader to evaluate the evidence independently.
              The One Million Messages campaign encourages respectful, face-to-face conversations
              rooted in transparency, local decision-making, and informed citizenship.
            </p>
            <a href="/docs/freedom-or-control-evidence.pdf" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1.5 mt-3 text-sm font-semibold text-wy-ember hover:underline">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Download the full evidence packet (PDF)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions for voters -->
    <section class="bg-white py-10 px-4 border-b border-gray-200">
      <div class="max-w-3xl mx-auto">
        <h2 class="sources-h2">Questions for Wyoming voters</h2>
        <div class="questions-grid">
          <div class="question-card">Who paid for this message?</div>
          <div class="question-card">Is the funding primarily local or national?</div>
          <div class="question-card">Who benefits if this message succeeds?</div>
          <div class="question-card">Does it strengthen local decision-making?</div>
          <div class="question-card">Does it help voters make their own choice?</div>
          <div class="question-card">Does it encourage conversation and participation?</div>
        </div>
      </div>
    </section>

    <!-- Media sources -->
    <article class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto sources-content">

        <h2 class="sources-h2">Media sources</h2>
        <div class="source-list">

          <div class="source-item">
            <p class="source-label">
              WyoFile — Wyoming GOP endorsement lawsuit
              <span class="source-desc">Federal lawsuit challenging state ban on pre-primary candidate endorsements</span>
            </p>
            <a href="https://wyofile.com/wyoming-gop-sues-state-challenges-constitutionality-of-ban-on-pre-primary-candidate-endorsements/"
               target="_blank" rel="noopener" class="source-link">
              wyofile.com — Wyoming GOP sues state
            </a>
          </div>

          <div class="source-item">
            <p class="source-label">
              WyoFile — The Takeover
              <span class="source-desc">How Wyoming's Freedom Caucus aligned with a national organization and moved to control the statehouse</span>
            </p>
            <a href="https://wyofile.com/the-takeover-how-wyomings-tireless-minority-took-control/"
               target="_blank" rel="noopener" class="source-link">
              wyofile.com — The Takeover
            </a>
          </div>

          <div class="source-item">
            <p class="source-label">
              Wyoming Public Media — Out-of-state PAC spending
              <span class="source-desc">Reports show out-of-state PACs spent big money in Wyoming's 2024 primary races</span>
            </p>
            <a href="https://www.wyomingpublicmedia.org/politics-government/2024-08-19/reports-show-out-of-state-pacs-spent-big-money-in-wyoming-primary-races"
               target="_blank" rel="noopener" class="source-link">
              wyomingpublicmedia.org — Out-of-state PAC spending (Aug 2024)
            </a>
          </div>

          <div class="source-item">
            <p class="source-label">
              News From The States — Wyoming GOP endorsement plans
              <span class="source-desc">Statewide candidates split on Wyoming GOP plans to defy state law and make endorsements</span>
            </p>
            <a href="https://www.newsfromthestates.com/article/statewide-candidates-split-wyoming-gops-plans-defy-state-law-and-make-endorsements"
               target="_blank" rel="noopener" class="source-link">
              newsfromthestates.com — Wyoming GOP endorsement plans
            </a>
          </div>

        </div>

        <h2 class="sources-h2">Organization records</h2>
        <div class="source-list">

          <div class="source-item">
            <p class="source-label">
              Americans for Prosperity — official site
              <span class="source-desc">Press releases regarding Wyoming endorsements and campaign investments</span>
            </p>
            <a href="https://americansforprosperity.org/"
               target="_blank" rel="noopener" class="source-link">
              americansforprosperity.org
            </a>
          </div>

          <div class="source-item">
            <p class="source-label">
              Young Americans for Liberty — official site
              <span class="source-desc">National organization; headquarters Austin, Texas. "Operation Win at the Door" campaign program.</span>
            </p>
            <a href="https://yaliberty.org/"
               target="_blank" rel="noopener" class="source-link">
              yaliberty.org
            </a>
          </div>

          <div class="source-item">
            <p class="source-label">
              FEC — Make Liberty Win committee filing
              <span class="source-desc">Federal Election Commission records for Make Liberty Win PAC (C00731133); headquarters Fairfax, Virginia</span>
            </p>
            <a href="https://www.fec.gov/data/committee/C00731133/"
               target="_blank" rel="noopener" class="source-link">
              fec.gov — Make Liberty Win (C00731133)
            </a>
          </div>

        </div>

        <h2 class="sources-h2">Campaign principle</h2>
        <blockquote class="principle-block">
          The One Million Messages campaign encourages respectful, face-to-face conversations
          rooted in transparency, local decision-making, and informed citizenship. The purpose
          of this evidence packet is to document publicly available information so every reader
          can evaluate the evidence independently.
        </blockquote>

      </div>
    </article>

    <!-- Back CTA -->
    <div class="bg-white py-12 px-4 border-t border-gray-200 text-center">
      <a href="/share/freedom-or-control"
         class="inline-flex items-center gap-2 px-6 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Freedom or Control?
      </a>
    </div>

  </main>
  <Footer />
</Base>

<style>
  .sources-h2 {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #2b2b2b;
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #c68a4a;
  }
  .sources-h2:first-child { margin-top: 0; }

  .questions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }
  .question-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 0.9375rem;
    color: #0f2742;
    font-weight: 500;
    line-height: 1.5;
  }

  .source-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid #e5e2da;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .source-item {
    background: #fff;
    padding: 16px 20px;
    border-bottom: 1px solid #e5e2da;
  }
  .source-item:last-child { border-bottom: none; }
  .source-label {
    font-weight: 700;
    font-size: 0.9375rem;
    color: #0f2742;
    margin: 0 0 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .source-desc {
    font-weight: 400;
    font-size: 0.8125rem;
    color: #6b7280;
  }
  .source-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: #b22234;
    text-decoration: none;
    word-break: break-all;
    margin-top: 2px;
  }
  .source-link:hover { text-decoration: underline; }

  .principle-block {
    background: #fef9f0;
    border-left: 4px solid #c68a4a;
    border-radius: 0 8px 8px 0;
    padding: 16px 20px;
    margin: 0 0 2rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #2b2b2b;
    font-style: normal;
  }
</style>
