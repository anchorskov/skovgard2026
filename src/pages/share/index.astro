---
// src/pages/share/index.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const BASE = 'https://skovgard2026.org';

const cards = [
  {
    slug: 'wyoming-family-economy',
    href: '/share/wyoming-family-economy',
    label: 'Economic Stewardship',
    title: 'A Good Economy Starts at the Kitchen Table',
    teaser: 'A strong economy is one where Wyoming families can pay their bills, save money, and build a sustainable life at home.',
    meme: '/images/share/meme-wyoming-family-economy-fb.png',
    memeAlt: 'Wall Street celebrates market gains while a Wyoming family weighs its grocery, fuel, utility, and housing bills',
    memeBg: '#2b2b2b',
    tweetText: 'A good economy is measured at the kitchen table: can Wyoming families pay their bills, save money, and build a life at home? — Jimmy Skovgard for U.S. Senate',
    emailSubject: 'A good economy starts at the kitchen table',
    emailBody: [
      'Hi,',
      '',
      'I wanted to share Jimmy Skovgard\'s message about the financial reality facing Wyoming families.',
      '',
      'A strong economy is not just a market index. It means families can afford groceries, fuel, utilities, and housing — with room to save and build a life at home.',
      '',
      'Jimmy is calling for honest budgets, stable energy policy, and leaders who explain their votes plainly and listen to Wyoming citizens.',
      '',
      `Watch the video: ${BASE}/share/wyoming-family-economy/`,
      '',
      'Jimmy Skovgard — Preserving our legacy. Empowering our future.',
      'Paid for by Skovgard for Senate.',
    ].join("\n"),
  },
