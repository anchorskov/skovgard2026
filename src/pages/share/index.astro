    title: 'One Million Messages',
    teaser: 'One conversation at a time. One neighbor at a time. Are we moving toward freedom or control? Start one conversation today.',
    meme: '/images/share/meme-one-million-messages.png',
    memeAlt: 'One Million Messages — one conversation, one neighbor, one community at a time',
    memeBg: '#2b2b2b',
    tweetText: 'One million conversations. One question: are we moving toward freedom or control? Start one conversation today. — Jimmy Skovgard for U.S. Senate',
    emailSubject: 'One million messages — will you start one today?',
    emailBody: [
      'Hi,',
      '',
      'I wanted to share a message about a movement worth joining.',
      '',
      'One million conversations. One question: are we moving toward greater freedom, or greater control?',
      '',
      'It starts with one honest conversation between neighbors. You can be part of it today.',
      '',
      `Read the full message: ${BASE}/share/one-million-messages/`,
      '',
      'Jimmy Skovgard — Preserving our legacy. Empowering our future.',
      'Paid for by Skovgard for Senate.',
    ].join("\n"),
  },
