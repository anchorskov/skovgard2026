---
// src/pages/share/one-million-messages.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="One Million Messages — Skovgard 2026"
  description="One million conversations. One question: are we moving toward greater freedom, or greater control? Start one conversation today."
  ogImage="/images/share/meme-one-million-messages.png"
>
  <Nav />
  <main class="pt-20">

    <!-- Hero -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <a href="/share" class="inline-flex items-center gap-1.5 text-wy-bone/50 hover:text-wy-bone text-xs font-semibold uppercase tracking-widest mb-6 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All messages
      </a>
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Civic Movement</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold mb-4 leading-tight">
        <span class="text-wy-bone">One Million</span>
        <span class="text-wy-ember"> Messages</span>
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto mb-8">
        One conversation at a time. One neighbor at a time. One community at a time.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="hero-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="hero-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="hero-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

    <!-- ① Share on social media -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Share on social media</p>
        <p class="section-desc">
          This image and link are what people see when you post on Facebook or X.
          When someone clicks the link, they land on this page with the full message.
        </p>

        <figure class="rounded-xl overflow-hidden shadow-lg mb-7">
          <img
            src="/images/share/meme-one-million-messages.png"
            alt="One Million Messages — one conversation, one neighbor, one community at a time"
            class="w-full block"
            style="background-color:#2b2b2b;min-height:180px;"
            loading="eager"
          />
        </figure>

        <div class="flex flex-wrap gap-3">
          <a id="social-facebook" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
            Share on Facebook
          </a>
          <a id="social-twitter" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Share on X
          </a>
          <button id="social-copy-link" type="button" class="social-btn-outline">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy link
          </button>
          <a id="social-whatsapp" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.089.534 4.05 1.475 5.757L0 24l6.435-1.689A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 01-4.993-1.368l-.358-.213-3.716.975.993-3.62-.234-.372A9.799 9.799 0 012.182 12C2.182 6.565 6.565 2.182 12 2.182S21.818 6.565 21.818 12 17.435 21.818 12 21.818z"/>
            </svg>
            WhatsApp
          </a>
          <button id="social-native-share" type="button" class="social-btn-outline" hidden>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
            </svg>
            Share…
          </button>
        </div>

      </div>
    </section>

    <!-- ② Send by email -->
    <section class="bg-white py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Send by email to your contacts</p>
        <p class="section-desc">
          This is the written message your contacts receive in their inbox.
          It is not the image above — it is a personal email that comes from you.
        </p>

        <div class="bg-wy-bone rounded-2xl border border-gray-200 p-7">

          <!-- Your name -->
          <div class="mb-6">
            <label for="omm-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input
              id="omm-sender"
              type="text"
              autocomplete="given-name"
              placeholder="e.g. Sarah"
              maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember"
            />
          </div>

          <!-- Honeypot -->
          <input id="omm-trap" name="omm_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <!-- Recipient input -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">
                Friends' email addresses
              </label>
              <button id="omm-contacts-btn" type="button" hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>
            <div id="omm-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Recipient email list">
              <input id="omm-email-input" type="email" inputmode="email" autocomplete="off" autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent" />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd>Enter</kbd> or <kbd>,</kbd> after each address. Paste a comma-separated list to add several at once. Up to 10.
            </p>
          </div>

          <!-- Live HTML email preview -->
          <div class="email-preview-wrap mb-6">
            <div class="email-preview-header">
              <div class="epf"><span class="epl">From:</span> Jimmy Skovgard for Wyoming &lt;support@grassrootsmvt.org&gt;</div>
              <div class="epf"><span class="epl">Subject:</span> <span id="omm-preview-subject">One million messages — will you start one today?</span></div>
            </div>
            <iframe
              id="omm-preview-iframe"
              title="Preview of the email your contacts will receive"
              sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
              scrolling="yes"
              class="email-preview-iframe"
            ></iframe>
          </div>

          <!-- Status -->
          <div id="omm-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <!-- Action button -->
          <button id="omm-send-btn" type="button"
            class="w-full flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span id="omm-send-label">Have us send it</span>
          </button>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            We send a campaign-branded email on your behalf. Recipients are not added to any mailing list.
          </p>

        </div>
      </div>
    </section>

    <!-- Full message -->
    <article class="bg-wy-bone border-t border-gray-200 py-14 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">The full message</p>

        <div class="prose-content">

          <p>Every generation faces a defining question.</p>
          <p>Will our future be shaped more by freedom or by control?</p>
          <p>I believe the answer begins with us.</p>

          <h2>Who</h2>
          <p>You.</p>
          <p>Me.</p>
          <p>Every citizen willing to have one honest conversation with another person.</p>
          <p>Together, our goal is simple: one million messages.</p>

          <h2>What</h2>
          <p>One million conversations centered on one question:</p>
          <p><strong>Are we moving toward greater freedom, or greater control?</strong></p>
          <p>We listen. We think. We learn. We understand. We build trust.</p>
          <p>Every conversation brings another perspective, another idea, and another opportunity to strengthen our communities.</p>

          <h2>When</h2>
          <p>It starts today.</p>
          <p>It continues one conversation at a time as more people join the effort.</p>

          <h2>Where</h2>
          <p>Across Wyoming. Across America.</p>
          <p>At the kitchen table. Over coffee. At work. At community events.</p>
          <p>Anywhere people are willing to look each other in the eye and have an honest conversation.</p>

          <h2>Why</h2>
          <p>Freedom grows with informed, engaged citizens.</p>
          <p>Trust grows through conversation.</p>
          <p>Communities grow stronger when we listen, learn, and work together.</p>
          <p>One conversation can inspire another. One idea can spark a movement. One million conversations can help shape the future.</p>
          <p class="context-note">For the data behind this question, see our breakdown of Wyoming election legislation: <a href="/share/freedom-or-control" class="inline-link">Freedom or Control?</a>.</p>

          <h2>How</h2>
          <p>Join the Pulse platform at Skovgard2026.org.</p>
          <p>Receive conversation starters, questions, and ideas worth sharing.</p>
          <p>Then carry those conversations into your community.</p>

          <div class="count-block my-10">
            <p>One conversation becomes ten.</p>
            <p>Ten become one hundred.</p>
            <p>One hundred become one thousand.</p>
            <p><strong>Together, we can share one million messages.</strong></p>
          </div>

          <h2>Your Next Step</h2>
          <p>Join the movement.</p>
          <p>Start one conversation today.</p>
          <p>Invite one other person to do the same.</p>
          <p>Share one message that encourages curiosity, understanding, and participation.</p>

          <div class="closing-block my-10">
            <p>One conversation.</p>
            <p>One neighbor.</p>
            <p>One community.</p>
            <p>One million messages.</p>
            <p><strong>Our future begins with us.</strong></p>
          </div>

          <p>
            <a href="https://skovgard2026.org/pulse" class="cta-link">Join the Pulse platform at Skovgard2026.org</a>
          </p>

        </div>
      </div>
    </article>

    <!-- Bottom share bar -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Spread the Word</p>
      <p class="text-wy-bone/70 text-sm mb-6 max-w-md mx-auto">
        One message from someone you know carries more weight than any ad. Share this with Wyoming neighbors.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="footer-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="footer-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="footer-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

  </main>
  <Footer />
</Base>

<style>
  .section-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c68a4a;
    margin-bottom: 6px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 52ch;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: #2b2b2b;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .social-btn:hover { background: #b22234; }
  .social-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: transparent;
    color: #2b2b2b;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    border: 2px solid #2b2b2b;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .social-btn-outline:hover { background: #2b2b2b; color: #f1ece1; }

  .share-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border: 2px solid rgba(241, 236, 225, 0.45);
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .share-btn-outline:hover {
    background-color: rgba(241, 236, 225, 0.1);
    border-color: #f1ece1;
  }

  .email-preview-wrap {
    border: 1px solid #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .email-preview-header {
    padding: 10px 14px;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .epf { font-size: 0.8125rem; color: #374151; line-height: 1.6; }
  .epl { font-weight: 700; color: #6b7280; margin-right: 4px; }
  .email-preview-iframe {
    display: block;
    width: 100%;
    height: 460px;
    border: none;
  }

  #omm-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .omm-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1ece1;
    border: 1px solid #c68a4a33;
    color: #2b2b2b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    max-width: 220px;
  }
  .omm-chip span { overflow: hidden; text-overflow: ellipsis; }
  .omm-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: #c68a4a55;
    color: #2b2b2b;
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .omm-chip button:hover { background: #b22234; color: #fff; }

  kbd {
    padding: 1px 5px;
    background: #f3f4f6;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
    color: #6b7280;
  }

  .prose-content { line-height: 1.8; color: #2b2b2b; }
  .prose-content h2 {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1.5rem;
    margin: 2rem 0 0.75rem;
    color: #2b2b2b;
  }
  .prose-content p { margin-bottom: 1rem; font-size: 1.0625rem; }

  .count-block {
    border-left: 4px solid #b22234;
    background: #fef7f7;
    padding: 20px 24px;
    border-radius: 0 8px 8px 0;
  }
  .count-block p { margin-bottom: 0.5rem; font-size: 1.0625rem; }
  .count-block p:last-child { margin-bottom: 0; }

  .closing-block {
    border-left: 4px solid #d8b46a;
    background: #fbf8f1;
    padding: 20px 24px;
    border-radius: 0 8px 8px 0;
  }
  .closing-block p { margin-bottom: 0.5rem; font-size: 1.0625rem; }
  .closing-block p:last-child { margin-bottom: 0; }

  .context-note {
    font-size: 0.9375rem;
    color: #6b7280;
    border-left: 3px solid #d8b46a;
    padding-left: 14px;
    margin-top: 1.25rem;
  }
  .inline-link {
    color: #b22234;
    font-weight: 600;
    text-decoration: none;
  }
  .inline-link:hover { text-decoration: underline; }

  .cta-link {
    display: inline-block;
    background: #b22234;
    color: #f1ece1;
    font-weight: 700;
    font-size: 1rem;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .cta-link:hover { background: #8b1a26; }

  #omm-status.status-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
  #omm-status.status-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
  #omm-status.status-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }
</style>

<script>
(function () {
  const PAGE_URL = 'https://skovgard2026.org/share/one-million-messages';

  const fb = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(PAGE_URL);
  const tw = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(PAGE_URL) +
    '&text=' + encodeURIComponent('One million conversations. One question: are we moving toward freedom or control? Start one conversation today. — Jimmy Skovgard for U.S. Senate');
  ['hero-facebook', 'social-facebook', 'footer-facebook'].forEach(id => { const el = document.getElementById(id); if (el) el.href = fb; });
  ['hero-twitter',  'social-twitter',  'footer-twitter' ].forEach(id => { const el = document.getElementById(id); if (el) el.href = tw; });

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      setStatus('Link copied!', 'success');
      setTimeout(() => setStatus('', ''), 3000);
    } catch {
      setStatus('Could not copy — please copy manually.', 'error');
    }
  }

  ['hero-copy-link', 'social-copy-link', 'footer-copy-link']
    .forEach(id => { const btn = document.getElementById(id); if (btn) btn.addEventListener('click', () => copyText(PAGE_URL)); });

  /* ── WhatsApp + Web Share API ───────────────────────────── */
  const elWa = document.getElementById('social-whatsapp');
  if (elWa) elWa.href = 'https://wa.me/?text=' + encodeURIComponent(PAGE_URL);

  const nativeShareBtn = document.getElementById('social-native-share');
  if (nativeShareBtn && navigator.canShare && navigator.canShare({ url: PAGE_URL })) {
    nativeShareBtn.hidden = false;
    nativeShareBtn.addEventListener('click', async () => {
      try { await navigator.share({ title: document.title, url: PAGE_URL }); }
      catch (_) {}
    });
  }

  const ommEmails   = [];
  const OMM_MAX     = 10;
  const tagBox      = document.getElementById('omm-tag-box');
  const emailInput  = document.getElementById('omm-email-input');
  const senderInput = document.getElementById('omm-sender');
  const contactsBtn = document.getElementById('omm-contacts-btn');
  const previewIframe  = document.getElementById('omm-preview-iframe');
  const previewSubject = document.getElementById('omm-preview-subject');
  const sendBtn     = document.getElementById('omm-send-btn');
  const sendLabel   = document.getElementById('omm-send-label');
  const statusEl    = document.getElementById('omm-status');
  const trapEl      = document.getElementById('omm-trap');

  function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim()); }

  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  function renderTags() {
    Array.from(tagBox.querySelectorAll('.omm-chip')).forEach(c => c.remove());
    ommEmails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'omm-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">✕</button>`;
      chip.querySelector('button').addEventListener('click', () => { ommEmails.splice(i, 1); setStatus('', ''); renderTags(); });
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons();
    schedulePreview();
  }

  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (ommEmails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (ommEmails.length >= OMM_MAX) { setStatus(`Maximum ${OMM_MAX} recipients.`, 'info'); return; }
    setStatus('', '');
    ommEmails.push(e);
    renderTags();
  }

  function updateButtons() { sendBtn.disabled = ommEmails.length === 0 && !isValidEmail(emailInput.value.trim()); }

  emailInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addEmail(emailInput.value); emailInput.value = ''; }
    else if (e.key === 'Backspace' && emailInput.value === '' && ommEmails.length > 0) {
      ommEmails.splice(ommEmails.length - 1, 1); setStatus('', ''); renderTags();
    }
  });
  emailInput.addEventListener('blur', () => { if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; } });
  emailInput.addEventListener('input', updateButtons);
  emailInput.addEventListener('paste', e => {
    e.preventDefault();
    (e.clipboardData || window.clipboardData).getData('text').split(/[,;\s\n]+/).forEach(p => { if (p.trim()) addEmail(p); });
    emailInput.value = '';
  });
  tagBox.addEventListener('click', () => emailInput.focus());

  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try { const picked = await navigator.contacts.select(['name', 'email'], { multiple: true }); picked.forEach(c => (c.email || []).forEach(e => addEmail(e))); } catch (_) {}
      });
    } catch (_) {}
  })();

  let previewTimer = null;

  function buildPreviewUrl() {
    const name = senderInput.value.trim().slice(0, 80);
    const params = new URLSearchParams({ slug: 'one-million-messages' });
    if (name) params.set('sender_name', name);
    return '/api/share/preview?' + params.toString();
  }

  function updateSubjectLine() {
    const name = senderInput.value.trim();
    if (previewSubject) {
      previewSubject.textContent = name
        ? `${name} wanted you to see this — One Million Messages`
        : 'One million messages — will you start one today?';
    }
  }

  async function fetchPreview() {
    updateSubjectLine();
    if (!previewIframe) return;
    try {
      const resp = await fetch(buildPreviewUrl());
      if (resp.ok) previewIframe.srcdoc = await resp.text();
    } catch (_) {}
  }

  function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(fetchPreview, 300);
  }

  senderInput.addEventListener('input', schedulePreview);

  sendBtn.addEventListener('click', async () => {
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
    if (ommEmails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }
    if (trapEl.value.trim()) return;

    sendBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setStatus('', '');

    try {
      const resp = await fetch('/api/share', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          message_slug: 'one-million-messages',
          sender_name:  senderInput.value.trim(),
          recipients:   ommEmails.slice(),
          _trap: "",
          _t:    Date.now(),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        setStatus(
          resp.status === 404 && isLocal
            ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev'
            : resp.status === 503
            ? 'Share feature is not enabled on this environment yet.'
            : data.error || 'Something went wrong. Please try again.',
          'error'
        );
      } else {
        const n = data.sent || ommEmails.length;
        setStatus(`Sent! ${n} message${n !== 1 ? 's' : ''} accepted for delivery. Thank you for spreading the word.`, 'success');
        ommEmails.length = 0;
        renderTags();
      }
    } catch (_) {
      setStatus(
        ['localhost', '127.0.0.1'].includes(window.location.hostname)
          ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal.'
          : 'Network error — please check your connection and try again.',
        'error'
      );
    } finally {
      sendLabel.textContent = 'Have us send it';
      updateButtons();
    }
  });

  updateButtons();
  fetchPreview();

  if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
    setStatus(
      'Local dev: "Have us send it" needs the Worker running. ' +
      'In a second terminal: cd worker && npx wrangler dev.',
      'info'
    );
  }
})();
</script>
