---
// src/pages/share/freedom-or-control.astro
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Base
  title="Freedom or Control? — Skovgard 2026"
  description="Wyoming voters face a clear question. Powerful organizations from outside the state are investing significant resources to shape our choices. Here is what has been documented."
  ogImage="/images/share/meme-freedom-or-control.png"
>
  <Nav />
  <main class="pt-20">

    <!-- Hero -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <a href="/share" class="inline-flex items-center gap-1.5 text-wy-bone/50 hover:text-wy-bone text-xs font-semibold uppercase tracking-widest mb-6 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All messages
      </a>
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">One Million Messages</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-extrabold mb-4 leading-tight">
        <span class="text-wy-bone">Freedom</span>
        <span class="text-wy-ember"> or </span>
        <span class="text-wy-ember">Control?</span>
      </h1>
      <p class="text-wy-bone/70 text-lg max-w-xl mx-auto mb-8">
        Wyoming voters face a clear question. Powerful organizations from outside the state
        are investing significant resources to shape our choices. Here is what has been documented.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="hero-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="hero-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="hero-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

    <!-- ① Share on social media -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Share on social media</p>
        <p class="section-desc">
          This image and link are what people see when you post on Facebook or X.
          When someone clicks the link, they land on this page with the full breakdown.
        </p>

        <figure class="rounded-xl overflow-hidden shadow-lg mb-7">
          <img
            src="/images/share/meme-freedom-or-control.png"
            alt="Freedom or Control — One Million Messages, One Conversation at a Time. Will our future be shaped more by Freedom or Control? Skovgard 2026."
            class="w-full block"
            style="background-color:#1B2A4A;min-height:180px;"
            loading="eager"
          />
        </figure>

        <div class="flex flex-wrap gap-3">
          <a id="social-facebook" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
            Share on Facebook
          </a>
          <a id="social-twitter" href="#" target="_blank" rel="noopener" class="social-btn">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Share on X
          </a>
          <button id="social-copy-link" type="button" class="social-btn-outline">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Copy link
          </button>
        </div>

      </div>
    </section>

    <!-- ② Send by email -->
    <section class="bg-white py-12 px-4">
      <div class="max-w-3xl mx-auto">

        <p class="section-kicker">Send by email to your contacts</p>
        <p class="section-desc">
          This is the written message your contacts receive in their inbox.
          It is not the image above — it is a personal email that comes from you.
        </p>

        <div class="bg-wy-bone rounded-2xl border border-gray-200 p-7">

          <!-- Your name -->
          <div class="mb-6">
            <label for="foc-sender" class="block text-sm font-semibold text-gray-700 mb-1">
              Your name <span class="font-normal text-gray-400">(optional — personalises the message)</span>
            </label>
            <input
              id="foc-sender"
              type="text"
              autocomplete="given-name"
              placeholder="e.g. Sarah"
              maxlength="80"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-base focus:outline-none focus:ring-2 focus:ring-wy-ember focus:border-wy-ember"
            />
          </div>

          <!-- Honeypot -->
          <input id="foc-trap" name="foc_trap" type="text" autocomplete="off" tabindex="-1"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

          <!-- Recipient input -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-1">
              <label class="text-sm font-semibold text-gray-700">
                Friends' email addresses
              </label>
              <button id="foc-contacts-btn" type="button" hidden
                class="text-xs font-semibold text-wy-ember hover:text-wy-ember-dark flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.768-.231-1.47-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.768.231-1.47.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Add from contacts
              </button>
            </div>
            <div id="foc-tag-box"
              class="min-h-[48px] w-full px-2 py-1.5 border border-gray-300 rounded-lg bg-white cursor-text flex flex-wrap gap-1.5 items-center focus-within:ring-2 focus-within:ring-wy-ember focus-within:border-wy-ember"
              aria-label="Recipient email list">
              <input id="foc-email-input" type="email" inputmode="email" autocomplete="off" autocapitalize="off"
                placeholder="Type an address and press Enter"
                class="flex-1 min-w-[180px] border-0 outline-none text-sm py-1 px-1 bg-transparent" />
            </div>
            <p class="text-xs text-gray-400 mt-1.5">
              Press <kbd>Enter</kbd> or <kbd>,</kbd> after each address. Paste a comma-separated list to add several at once. Up to 10.
            </p>
          </div>

          <!-- Live HTML email preview -->
          <div class="email-preview-wrap mb-6">
            <div class="email-preview-header">
              <div class="epf"><span class="epl">From:</span> Jimmy Skovgard for Wyoming &lt;support@grassrootsmvt.org&gt;</div>
              <div class="epf"><span class="epl">Subject:</span> <span id="foc-preview-subject">Freedom or Control? — Wyoming voters deserve to know who's paying</span></div>
            </div>
            <iframe
              id="foc-preview-iframe"
              title="Preview of the email your contacts will receive"
              sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
              scrolling="yes"
              class="email-preview-iframe"
            ></iframe>
          </div>

          <!-- Status -->
          <div id="foc-status" role="status" aria-live="polite" class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-medium"></div>

          <!-- Action button -->
          <button id="foc-send-btn" type="button"
            class="w-full flex items-center justify-center gap-2 px-5 py-3 bg-wy-ember text-wy-bone font-bold rounded-lg hover:bg-wy-ember-dark transition-colors text-sm shadow-sm">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span id="foc-send-label">Have us send it</span>
          </button>

          <p class="text-xs text-gray-400 text-center mt-4 leading-relaxed">
            We send a campaign-branded email on your behalf. Recipients are not added to any mailing list.
          </p>

        </div>
      </div>
    </section>

    <!-- Full breakdown article -->
    <article class="bg-wy-bone border-t border-gray-200 py-14 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">Full breakdown</p>

        <div class="prose-content">

          <h2>The question in front of every Wyoming voter</h2>

          <p>Wyoming voters are being shaped by forces most of them will never hear named.</p>

          <p>
            National PACs. Billionaire-funded advocacy networks. Out-of-state consulting firms.
            Dark money organizations. Social media algorithms built to divide. Cable news outrage
            engineered to exhaust. AI-generated persuasion at scale.
          </p>

          <p>This is not a left problem or a right problem. It is a Wyoming problem.</p>

          <p>
            The question is not whether the influence comes from one direction or another.
            The question is whether Wyoming voters are making Wyoming decisions — or whether
            powerful organizations headquartered outside this state are shaping our choices
            before we have a chance to think them through.
          </p>

          <p>Here is what has been documented.</p>

          <!-- Org cards -->
          <div class="org-list">

            <div class="org-card">
              <h3 class="org-name">Americans for Prosperity / AFP-Wyoming</h3>
              <p class="org-body">
                Americans for Prosperity is connected to the Koch political network.
                AFP-Wyoming described its 2024 Wyoming primary investment as historic,
                issuing endorsements of legislative candidates before voters had spoken.
                In June 2026, AFP-Wyoming announced nine more legislative endorsements
                ahead of the August 18 primary.
              </p>
              <p class="org-source">Source: Americans for Prosperity press releases</p>
            </div>

            <div class="org-card">
              <h3 class="org-name">Young Americans for Liberty and Make Liberty Win</h3>
              <p class="org-body">
                Young Americans for Liberty is a national political organization headquartered
                in Austin, Texas, with hundreds of campus chapters across the country and a
                nationwide campaign program called &#8220;Operation Win at the Door.&#8221;
                Its affiliated PAC, Make Liberty Win, is headquartered in Fairfax, Virginia.
                Wyoming Public Media reported that Make Liberty Win spent more than $370,000
                on mail, texts, and voter outreach in Wyoming&#8217;s 2024 legislative
                primaries — with Young Americans for Liberty identified as the PAC&#8217;s
                primary financial backer.
              </p>
              <p class="org-source">Source: Wyoming Public Media, FEC filings</p>
            </div>

            <div class="org-card">
              <h3 class="org-name">State Freedom Caucus Network / Wyoming Freedom Caucus</h3>
              <p class="org-body">
                WyoFile reported that the Wyoming Freedom Caucus transformed from a loose group
                of lawmakers into a force positioned to control the statehouse after aligning
                with a national organization. It is now working to retain and expand that
                position in the 2026 Legislature.
              </p>
              <p class="org-source">Source: WyoFile</p>
            </div>

            <div class="org-card">
              <h3 class="org-name">Wyoming GOP Pre-Primary Endorsement Lawsuit</h3>
              <p class="org-body">
                The outside pressure does not stop at external organizations. The Wyoming
                Republican Party has filed a federal lawsuit challenging a state law that
                blocks political parties from spending to back one primary candidate over
                another before voters choose the nominee. The fight is now in court: whether
                party insiders can spend money to steer your primary before you vote.
              </p>
              <p class="org-source">Source: WyoFile, News From The States</p>
            </div>

          </div>

          <h2>The pattern I keep seeing</h2>

          <div class="pattern-box">
            <p>
              Outside money comes in.<br />
              Messages get sharpened.<br />
              Neighbors get divided.<br />
              Candidates get pressured.<br />
              Local judgment gets weakened.
            </p>
            <p>Then we are told this is &#8220;freedom.&#8221;</p>
            <p class="pattern-verdict">I call it control.</p>
          </div>

          <p>
            The issue is not where these organizations are headquartered.
            The issue is whether Wyoming voters have enough information to recognize when
            well-funded organizations — from any direction — are investing significant
            resources to shape Wyoming elections.
          </p>

          <div class="transparency-box">
            <p>Transparency strengthens freedom.</p>
            <p>Hidden influence strengthens control.</p>
          </div>

          <p>
            Every voter deserves to know who is speaking, who is paying for the message,
            and what interests are being advanced before casting a ballot.
          </p>

          <div class="manifesto">
            <p>The people choose.</p>
            <p>The party serves.</p>
            <p>The government answers to us.</p>
          </div>

          <!-- Evidence document download -->
          <div class="evidence-block">
            <div class="evidence-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <p class="evidence-label">Evidence Packet</p>
              <p class="evidence-desc">
                The One Million Messages evidence packet documents the public sources
                behind this message. Review the original sources yourself.
              </p>
              <a href="/docs/freedom-or-control-evidence.pdf" target="_blank" rel="noopener"
                class="evidence-link">
                Download evidence packet (PDF)
              </a>
            </div>
          </div>

        </div>
      </div>
    </article>

    <!-- Bottom share bar -->
    <div class="bg-wy-charcoal py-14 px-4 text-center">
      <p class="text-wy-sandstone font-semibold uppercase tracking-widest text-xs mb-3">Spread the Word</p>
      <p class="text-wy-bone/70 text-sm mb-6 max-w-md mx-auto">
        One message from someone you know carries more weight than any ad.
        Share this with Wyoming neighbors before the August 18 primary.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="footer-copy-link" type="button" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Copy link
        </button>
        <a id="footer-facebook" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
          </svg>
          Facebook
        </a>
        <a id="footer-twitter" href="#" target="_blank" rel="noopener" class="share-btn-outline">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          X / Twitter
        </a>
      </div>
    </div>

    <!-- Sources -->
    <section class="bg-wy-bone py-12 px-4">
      <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-1">Sources &amp; Evidence</h2>
          <p class="text-sm text-gray-600">
            All claims are documented with publicly available sources.
          </p>
        </div>
        <a href="/share/freedom-or-control/sources/"
           class="inline-flex items-center gap-2 px-5 py-2.5 bg-wy-charcoal text-wy-bone font-bold rounded-lg hover:bg-wy-ember transition-colors text-sm shrink-0">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          View all sources
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .section-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c68a4a;
    margin-bottom: 6px;
  }
  .section-desc {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 52ch;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: #2b2b2b;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .social-btn:hover { background: #b22234; }
  .social-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: transparent;
    color: #2b2b2b;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    border: 2px solid #2b2b2b;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .social-btn-outline:hover { background: #2b2b2b; color: #f1ece1; }

  .share-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border: 2px solid rgba(241, 236, 225, 0.45);
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .share-btn-outline:hover {
    background-color: rgba(241, 236, 225, 0.1);
    border-color: #f1ece1;
  }

  .email-preview-wrap {
    border: 1px solid #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }
  .email-preview-header {
    padding: 10px 14px;
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }
  .epf { font-size: 0.8125rem; color: #374151; line-height: 1.6; }
  .epl { font-weight: 700; color: #6b7280; margin-right: 4px; }
  .email-preview-iframe { display: block; width: 100%; height: 460px; border: none; }

  #foc-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .foc-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1ece1;
    border: 1px solid #c68a4a33;
    color: #2b2b2b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 2px 8px 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    max-width: 220px;
  }
  .foc-chip span { overflow: hidden; text-overflow: ellipsis; }
  .foc-chip button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: #c68a4a55;
    color: #2b2b2b;
    cursor: pointer;
    font-size: 10px;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .foc-chip button:hover { background: #b22234; color: #fff; }

  kbd {
    padding: 1px 5px;
    background: #f3f4f6;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.8em;
    color: #6b7280;
  }

  /* Essay typography */
  .prose-content { line-height: 1.8; color: #2b2b2b; }
  .prose-content h2 {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    color: #2b2b2b;
  }
  .prose-content h2:first-child { margin-top: 0; }
  .prose-content p { margin-bottom: 1.25rem; font-size: 1.0625rem; }

  /* Org cards */
  .org-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid #ddd8ce;
    border-radius: 12px;
    overflow: hidden;
    margin: 1.5rem 0 2rem;
  }
  .org-card {
    background: #fff;
    padding: 18px 22px;
    border-bottom: 1px solid #ddd8ce;
  }
  .org-card:last-child { border-bottom: none; }
  .org-name {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1rem;
    color: #0f2742;
    margin: 0 0 8px;
  }
  .org-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #374151;
    margin: 0 0 6px;
  }
  .org-source {
    font-size: 0.8125rem;
    color: #9ca3af;
    margin: 0;
    font-style: italic;
  }

  /* Pattern box */
  .pattern-box {
    background: #0f2742;
    border-radius: 12px;
    padding: 24px 28px;
    margin: 0 0 2rem;
    color: #f1ece1;
  }
  .pattern-box p {
    font-size: 1.0625rem;
    line-height: 2;
    margin: 0 0 1rem;
    color: #f1ece1;
  }
  .pattern-box p:last-child { margin: 0; }
  .pattern-verdict {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1.25rem !important;
    color: #e87a86 !important;
    line-height: 1.3 !important;
  }

  /* Transparency box */
  .transparency-box {
    border-left: 4px solid #c68a4a;
    padding: 14px 20px;
    margin: 0 0 1.5rem;
    background: #fef9f0;
    border-radius: 0 8px 8px 0;
  }
  .transparency-box p {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #2b2b2b;
    margin: 0 0 4px;
  }
  .transparency-box p:last-child { margin: 0; }

  /* Manifesto */
  .manifesto {
    border-top: 2px solid #2b2b2b;
    border-bottom: 2px solid #2b2b2b;
    padding: 18px 0;
    margin: 2rem 0;
  }
  .manifesto p {
    font-family: 'Bitter', serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #0f2742;
    margin: 0 0 4px;
    line-height: 1.4;
  }
  .manifesto p:last-child { margin: 0; }

  /* Evidence download block */
  .evidence-block {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px 22px;
    margin-top: 2rem;
  }
  .evidence-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: #0f2742;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f1ece1;
  }
  .evidence-label {
    font-weight: 700;
    font-size: 0.875rem;
    color: #0f2742;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 4px;
  }
  .evidence-desc {
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .evidence-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #b22234;
    text-decoration: none;
  }
  .evidence-link:hover { text-decoration: underline; }

  #foc-status.status-success { background: #f0fdf4; border: 1px solid #86efac; color: #166534; }
  #foc-status.status-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
  #foc-status.status-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }
</style>

<script>
(function () {
  const PAGE_URL = 'https://skovgard2026.org/share/freedom-or-control';

  const TWEET = 'Wyoming voters face a clear question: are outside PACs and national networks shaping our choices? Freedom or control — the answer is yours.';

  const fb = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(PAGE_URL);
  const tw = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(PAGE_URL) +
    '&text=' + encodeURIComponent(TWEET);
  ['hero-facebook', 'social-facebook', 'footer-facebook'].forEach(id => { const el = document.getElementById(id); if (el) el.href = fb; });
  ['hero-twitter',  'social-twitter',  'footer-twitter' ].forEach(id => { const el = document.getElementById(id); if (el) el.href = tw; });

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      setStatus('Link copied!', 'success');
      setTimeout(() => setStatus('', ''), 3000);
    } catch {
      setStatus('Could not copy — please copy manually.', 'error');
    }
  }

  ['hero-copy-link', 'social-copy-link', 'footer-copy-link']
    .forEach(id => { const btn = document.getElementById(id); if (btn) btn.addEventListener('click', () => copyText(PAGE_URL)); });

  /* ── Email state ─────────────────────────────────────────── */
  const focEmails     = [];
  const FOC_MAX       = 10;
  const tagBox        = document.getElementById('foc-tag-box');
  const emailInput    = document.getElementById('foc-email-input');
  const senderInput   = document.getElementById('foc-sender');
  const contactsBtn   = document.getElementById('foc-contacts-btn');
  const previewIframe = document.getElementById('foc-preview-iframe');
  const previewSubject = document.getElementById('foc-preview-subject');
  const sendBtn       = document.getElementById('foc-send-btn');
  const sendLabel     = document.getElementById('foc-send-label');
  const statusEl      = document.getElementById('foc-status');
  const trapEl        = document.getElementById('foc-trap');

  function isValidEmail(e) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e.trim()); }

  function setStatus(msg, type) {
    if (!msg) { statusEl.classList.add('hidden'); statusEl.textContent = ''; return; }
    statusEl.className = `mb-4 px-4 py-3 rounded-lg text-sm font-medium status-${type}`;
    statusEl.textContent = msg;
    statusEl.classList.remove('hidden');
  }

  function renderTags() {
    Array.from(tagBox.querySelectorAll('.foc-chip')).forEach(c => c.remove());
    focEmails.forEach((email, i) => {
      const chip = document.createElement('span');
      chip.className = 'foc-chip';
      chip.innerHTML = `<span title="${email}">${email}</span><button type="button" aria-label="Remove ${email}">✕</button>`;
      chip.querySelector('button').addEventListener('click', () => { focEmails.splice(i, 1); setStatus('', ''); renderTags(); });
      tagBox.insertBefore(chip, emailInput);
    });
    updateButtons();
    schedulePreview();
  }

  function addEmail(raw) {
    const e = raw.trim().toLowerCase();
    if (!e) return;
    if (!isValidEmail(e)) { setStatus(`"${e}" doesn't look like a valid email address.`, 'error'); return; }
    if (focEmails.includes(e)) { setStatus(`${e} is already in the list.`, 'info'); return; }
    if (focEmails.length >= FOC_MAX) { setStatus(`Maximum ${FOC_MAX} recipients.`, 'info'); return; }
    setStatus('', '');
    focEmails.push(e);
    renderTags();
  }

  function updateButtons() { sendBtn.disabled = focEmails.length === 0 && !isValidEmail(emailInput.value.trim()); }

  emailInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addEmail(emailInput.value); emailInput.value = ''; }
    else if (e.key === 'Backspace' && emailInput.value === '' && focEmails.length > 0) {
      focEmails.splice(focEmails.length - 1, 1); setStatus('', ''); renderTags();
    }
  });
  emailInput.addEventListener('blur', () => { if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; } });
  emailInput.addEventListener('input', updateButtons);
  emailInput.addEventListener('paste', e => {
    e.preventDefault();
    (e.clipboardData || window.clipboardData).getData('text').split(/[,;\s\n]+/).forEach(p => { if (p.trim()) addEmail(p); });
    emailInput.value = '';
  });
  tagBox.addEventListener('click', () => emailInput.focus());

  (async () => {
    if (!('contacts' in navigator)) return;
    try {
      const props = await navigator.contacts.getProperties();
      if (!props.includes('email')) return;
      contactsBtn.hidden = false;
      contactsBtn.addEventListener('click', async () => {
        try { const picked = await navigator.contacts.select(['name', 'email'], { multiple: true }); picked.forEach(c => (c.email || []).forEach(e => addEmail(e))); } catch (_) {}
      });
    } catch (_) {}
  })();

  /* ── Live email preview ──────────────────────────────────── */
  let previewTimer = null;

  function buildPreviewUrl() {
    const name = senderInput.value.trim().slice(0, 80);
    const params = new URLSearchParams({ slug: 'freedom-or-control' });
    if (name) params.set('sender_name', name);
    return '/api/share/preview?' + params.toString();
  }

  function updateSubjectLine() {
    const name = senderInput.value.trim();
    if (previewSubject) {
      previewSubject.textContent = name
        ? `${name} shared this with you — Freedom or Control?`
        : "Freedom or Control? — Wyoming voters deserve to know who's paying";
    }
  }

  async function fetchPreview() {
    updateSubjectLine();
    if (!previewIframe) return;
    try {
      const resp = await fetch(buildPreviewUrl());
      if (resp.ok) previewIframe.srcdoc = await resp.text();
    } catch (_) {}
  }

  function schedulePreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(fetchPreview, 300);
  }

  senderInput.addEventListener('input', schedulePreview);

  /* ── Send via Worker ─────────────────────────────────────── */
  sendBtn.addEventListener('click', async () => {
    if (emailInput.value.trim()) { addEmail(emailInput.value); emailInput.value = ''; }
    if (focEmails.length === 0) { setStatus('Add at least one email address first.', 'error'); return; }
    if (trapEl.value.trim()) return;

    sendBtn.disabled = true;
    sendLabel.textContent = 'Sending…';
    setStatus('', '');

    try {
      const resp = await fetch('/api/share', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          message_slug: 'freedom-or-control',
          sender_name:  senderInput.value.trim(),
          recipients:   focEmails.slice(),
          _trap: "",
          _t:    Date.now(),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok || !data.ok) {
        const isLocal = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        setStatus(
          resp.status === 404 && isLocal
            ? 'Route not found — make sure the Worker is running: cd worker && npx wrangler dev'
            : resp.status === 503
            ? 'Share feature is not enabled on this environment yet.'
            : data.error || 'Something went wrong. Please try again.',
          'error'
        );
      } else {
        const n = data.sent || focEmails.length;
        setStatus(`Sent! ${n} message${n !== 1 ? 's' : ''} accepted for delivery. Thank you for spreading the word.`, 'success');
        focEmails.length = 0;
        renderTags();
      }
    } catch (_) {
      setStatus(
        ['localhost', '127.0.0.1'].includes(window.location.hostname)
          ? 'Worker not reachable. Run `cd worker && npx wrangler dev` in a second terminal.'
          : 'Network error — please check your connection and try again.',
        'error'
      );
    } finally {
      sendLabel.textContent = 'Have us send it';
      updateButtons();
    }
  });

  /* ── Init ────────────────────────────────────────────────── */
  updateButtons();
  fetchPreview();

  if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
    setStatus(
      'Local dev: "Have us send it" needs the Worker running. ' +
      'In a second terminal: cd worker && npx wrangler dev.',
      'info'
    );
  }
})();
</script>
