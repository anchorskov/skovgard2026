---
// src/layouts/Base.astro
import '../styles/global.css';
import { MEDIA_BASE_URL } from '../constants';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title = 'Jimmy Skovgard — U.S. Senate 2026',
  description = 'Wyoming deserves a Senator who actually shows up. Jimmy Skovgard for U.S. Senate 2026.',
  ogImage = '/images/og-default.jpg',
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;

const siteBase = Astro.site ?? 'https://www.skovgard2026.org';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteBase).toString();
const ogImagePath = new URL(ogImageURL).pathname.toLowerCase();
const ogImageType = ogImagePath.endsWith('.png') ? 'image/png' : 'image/jpeg';
const resolvedOgImageAlt = ogImageAlt || title;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:secure_url" content={ogImageURL} />
  <meta property="og:image:type" content={ogImageType} />
  {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
  {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
  <meta property="og:image:alt" content={resolvedOgImageAlt} />
  <meta property="og:site_name" content="Skovgard 2026" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
  <!-- Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <!-- Per-page head injection (CSS, scripts, meta) -->
  <slot name="head" />
  <!-- Fonts — Western / Frontier theme: Bitter headlines + Source Sans 3 body -->
  <link rel="preconnect" href={MEDIA_BASE_URL} crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-wy-stone text-wy-navy font-sans antialiased">
  <slot />
  <script is:inline>
    (function resolveCandidatesLinks() {
      const hostname = window.location.hostname.toLowerCase();
      let candidatesOrigin = 'https://candidates.skovgard2026.org';

      if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname === '[::1]') {
        candidatesOrigin = 'http://localhost:4322';
      } else if (hostname === 'this-is-us.org' || hostname.endsWith('.this-is-us.org')) {
        candidatesOrigin = 'https://candidates.this-is-us.org';
      }

      document.querySelectorAll('a[data-candidates-link]').forEach(function (link) {
        link.href = candidatesOrigin;
      });
    })();
  </script>
</body>
</html>
