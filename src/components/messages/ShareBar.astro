---
// src/components/messages/ShareBar.astro
// One restrained "Share this message" button that reveals a compact panel.
// Replaces the old pattern of 2-3 separate share blocks per page (hover
// quick-bar on the listing card, top-of-page social buttons, closing share
// bar) — see the "Latest From Jimmy" planning discussion this component
// came out of.
interface Props {
  url: string;
  title: string;
  tweetText?: string;
}
const { url, title, tweetText = title } = Astro.props;
---

<div class="share-bar" data-url={url} data-title={title} data-tweet={tweetText}>
  <button type="button" id="share-toggle" class="share-toggle-btn" aria-expanded="false" aria-controls="share-panel">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M8.684 13.342a4 4 0 100-2.684m0 2.684a4 4 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a4 4 0 105.367-5.367 4 4 0 00-5.367 5.367zm0 6.632a4 4 0 105.368 5.367 4 4 0 00-5.368-5.367z" />
    </svg>
    Share this message
  </button>

  <div id="share-panel" class="share-panel" hidden>
    <button type="button" id="share-copy" class="share-panel-btn">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      Copy link
    </button>
    <a id="share-fb" href="#" target="_blank" rel="noopener" class="share-panel-btn">
      <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
      </svg>
      Facebook
    </a>
    <a id="share-x" href="#" target="_blank" rel="noopener" class="share-panel-btn">
      <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
      X
    </a>
    <button type="button" id="share-native" class="share-panel-btn" hidden>
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
      </svg>
      Share…
    </button>
    <a id="share-email" href="#" class="share-panel-btn">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Email
    </a>
  </div>
</div>

<div id="share-toast" role="status" aria-live="polite" hidden>
  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
  </svg>
  <span id="share-toast-msg">Copied!</span>
</div>

<style>
  .share-bar { position: relative; }

  .share-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    background: #b22234;
    color: #f1ece1;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 0.35rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .share-toggle-btn:hover { background: #8b1a26; }

  .share-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.75rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }

  .share-panel-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #f1ece1;
    color: #2b2b2b;
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .share-panel-btn:hover { background: #e5ddc8; }

  #share-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #2b2b2b;
    color: #f1ece1;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    z-index: 100;
  }
</style>

<script>
(function () {
  const bars = document.querySelectorAll('.share-bar');
  bars.forEach((bar) => {
    const url = bar.getAttribute('data-url') || window.location.href;
    const title = bar.getAttribute('data-title') || document.title;
    const tweetText = bar.getAttribute('data-tweet') || title;

    const toggle = bar.querySelector('#share-toggle');
    const panel = bar.querySelector('#share-panel');
    const fb = bar.querySelector('#share-fb');
    const x = bar.querySelector('#share-x');
    const email = bar.querySelector('#share-email');
    const copyBtn = bar.querySelector('#share-copy');
    const nativeBtn = bar.querySelector('#share-native');

    if (fb) fb.setAttribute('href', 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url));
    if (x) x.setAttribute('href', 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(tweetText));
    if (email) email.setAttribute('href', 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(tweetText + '\n\n' + url));

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        showToast('Copied!');
      } catch {
        showToast('Could not copy. Please copy the URL manually.');
      }
    });

    if (nativeBtn && navigator.canShare && navigator.canShare({ url })) {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', async () => {
        try { await navigator.share({ title, url }); }
        catch (_) {}
      });
    }
  });

  function showToast(msg) {
    const toast = document.getElementById('share-toast');
    const toastMsg = document.getElementById('share-toast-msg');
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 2500);
  }
})();
</script>
