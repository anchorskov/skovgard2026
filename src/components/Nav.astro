---
// src/components/Nav.astro
const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/civ-tech', label: 'Civ-Tech' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/events', label: 'Events' },
  { href: '/pulse', label: 'Pulse' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/finance', label: 'Finance' },
];

const current = Astro.url.pathname;
---
<nav class="fixed top-0 w-full z-50 bg-wy-navy/95 backdrop-blur-sm border-b border-wy-gold/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Wordmark -->
    <a href="/" class="flex items-center gap-2">
      <span class="text-white font-serif font-bold text-lg leading-tight">
        Jimmy<br/><span class="text-wy-gold">Skovgard</span>
      </span>
      <span class="text-white/40 text-xs ml-2 hidden sm:block">U.S. Senate · 2026</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={[
            'text-sm font-medium transition-colors',
            current === link.href || current.startsWith(link.href + '/')
              ? 'text-wy-gold'
              : 'text-white/80 hover:text-white'
          ].join(' ')}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTA + mobile hamburger row -->
    <div class="flex items-center gap-3">
      <a
        href="/donate"
        class="bg-wy-gold text-wy-navy font-bold text-sm px-4 py-2 rounded hover:bg-amber-400 transition-colors"
      >
        Donate
      </a>
      <!-- Hamburger — mobile only -->
      <button
        id="nav-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden text-white p-1 rounded focus:outline-none focus:ring-2 focus:ring-wy-gold"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (hidden by default) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-wy-navy border-t border-wy-gold/20 px-4 pb-4"
  >
    {navLinks.map(link => (
      <a
        href={link.href}
        class={[
          'block py-2 text-sm font-medium transition-colors',
          current === link.href || current.startsWith(link.href + '/')
            ? 'text-wy-gold'
            : 'text-white/80 hover:text-white'
        ].join(' ')}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script is:inline>
(function () {
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  if (!toggle || !menu) return;
  toggle.addEventListener('click', function () {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  });
})();
</script>
