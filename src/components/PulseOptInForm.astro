---
// src/components/PulseOptInForm.astro
interface Props {
  showPrivacyNote?: boolean;
  /** 'full' shows the two-step Citizen Poll flow (used on /pulse). 'updates' trims
   * the form to contact info + SMS/email consent only — same submit path as the
   * existing "Join updates without voting" shortcut, just without the poll upsell. */
  variant?: 'full' | 'updates';
}

const {
  showPrivacyNote = true,
  variant = 'full',
} = Astro.props;
const isUpdatesOnly = variant === 'updates';
---
<div class="pulse-optin-surface">
  <noscript>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 text-amber-800 text-sm">
      JavaScript is required to submit this form securely. Please email
      <a href="mailto:anchorskov@gmail.com?subject=Pulse%20Opt-in" class="underline">anchorskov@gmail.com</a>
      with the subject "Pulse Opt-in" and include your name and mobile number.
    </div>
  </noscript>

  <form id="optin-form" class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border border-gray-100" method="post" novalidate data-variant={variant}>

    <section id="pulse-step-1" class="pulse-form-step space-y-5" aria-labelledby="pulse-step-1-title">
      <div>
        <h2 id="pulse-step-1-title" class="text-2xl font-serif font-bold text-wy-charcoal">
          Choose a Better Direction
        </h2>
        <p class="text-sm text-gray-600 mt-1">
          Join Jimmy Skovgard in holding Harriet Hageman and Chuck Gray accountable for their actions and inactions.
        </p>
      </div>

      <!-- Name -->
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">First name <span class="text-red-500">*</span></label>
          <input
            id="first_name"
            name="first_name"
            type="text"
            autocomplete="given-name"
            required
            class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
          />
        </div>
        <div>
          <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Last name <span class="text-red-500">*</span></label>
          <input
            id="last_name"
            name="last_name"
            type="text"
            autocomplete="family-name"
            required
            class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
          />
        </div>
      </div>

      <!-- Mobile (required) -->
      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Mobile number <span class="text-red-500">*</span></label>
        <input
          id="phone"
          name="phone"
          type="tel"
          inputmode="tel"
          placeholder="307-555-1234"
          autocomplete="tel"
          required
          class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
        />
        <p class="text-xs text-gray-400 mt-1">Standard message and data rates may apply. Reply STOP to opt out.</p>
      </div>

      <!-- Email (required for poll, optional for updates) -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
          Email address <span class="text-gray-400 font-normal text-xs">(required for citizen surveys)</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
        />
        <p class="text-xs text-gray-400 mt-1">
          We use email to send source links, issue summaries, and survey invitations. It is optional if you only want text updates.
        </p>
      </div>

      <!-- SMS consent (required) -->
      <div id="consent-panel" class="pulse-consent-panel rounded-xl border border-wy-ember/25 bg-wy-bone/50 px-4 py-4 space-y-3">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="consent_sms"
            name="consent_sms"
            required
            aria-describedby="consent-copy consent-error"
            class="mt-1 w-4 h-4 shrink-0"
            style="accent-color:#b22234"
          />
          <span class="text-sm text-gray-700 font-medium">
            I agree to receive political and informational text messages from Jimmy Skovgard. <span class="text-red-500">*</span>
          </span>
        </label>

        <!-- Email consent (shown only when email is filled — toggled by JS) -->
        <div id="email-consent-wrap" style="display:none">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              id="consent_email"
              name="consent_email"
              class="mt-0.5 w-4 h-4 shrink-0"
              style="accent-color:#b22234"
            />
            <span class="text-sm text-gray-700">
              I also agree to receive informational emails from Jimmy Skovgard.
            </span>
          </label>
        </div>

        <p id="consent-copy" class="text-xs leading-5 text-gray-500 pl-7">
          By checking this box and submitting your mobile number, you agree to receive recurring political and informational
          text messages from Skovgard for Senate. Messages may discuss Wyoming issues, support or oppose federal candidates,
          share Jimmy Skovgard's personal commentary, and invite participation in citizen surveys or civic action.
          Message frequency may vary. Message and data rates may apply. Reply STOP to opt out. Reply HELP for help.
          Consent is not a condition of donation. Your information will not be transferred to another campaign. View
          <a href="/privacy" class="text-wy-ember underline">Privacy Policy</a>
          and
          <a href="/terms" class="text-wy-ember underline">Terms</a>.
        </p>
        <p id="consent-error" class="hidden pl-7 text-sm font-semibold text-wy-ember-dark" aria-live="polite"></p>
      </div>

      <button type="button" id={isUpdatesOnly ? "pulse-updates-only" : "pulse-join-btn"} class="pulse-primary-action">
        Join the Effort
      </button>
    </section>

    {!isUpdatesOnly && (
      <section id="pulse-postjoin" class="pulse-form-step space-y-4" aria-labelledby="pulse-postjoin-title" hidden>
        <div class="pulse-poll-card">
          <p class="text-xs font-bold uppercase tracking-widest text-wy-rust mb-1">You're on the list!</p>
          <h3 id="pulse-postjoin-title" tabindex="-1" class="text-xl font-serif font-bold text-wy-charcoal">Want to vote in your district's Citizen Poll?</h3>
          <p class="text-sm text-gray-600 mt-1 mb-4">We check your name, city, and ZIP against the Wyoming voter roll to send the right ballot.</p>
          <button type="button" id="pulse-continue-poll" class="pulse-primary-action">
            Continue to Citizen Poll
          </button>
          <button type="button" id="pulse-request-callback" class="pulse-secondary-action">
            Please have Jimmy call me back
          </button>
          <button type="button" id="pulse-im-done" class="pulse-secondary-action">
            No, I'm done
          </button>
        </div>
      </section>
    )}

    {!isUpdatesOnly && (
      <section id="pulse-step-2" class="pulse-form-step space-y-5" aria-labelledby="pulse-step-2-title" hidden>
        <div tabindex="-1" id="pulse-step-2-heading">
          <h2 id="pulse-step-2-title" class="text-2xl font-serif font-bold text-wy-charcoal">Get your Citizen Poll ballot</h2>
          <p class="text-sm text-gray-600 mt-1">
            We check your name, city, and ZIP against the Wyoming voter roll so we can send the ballot for your district.
          </p>
        </div>

        <div class="rounded-xl border border-wy-dust bg-wy-bone/50 px-4 py-4 space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City <span class="text-red-500">*</span></label>
              <input
                id="city"
                name="city"
                type="text"
                autocomplete="address-level2"
                placeholder="Casper"
                aria-required="true"
                class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
              />
            </div>
            <div>
              <label for="zip" class="block text-sm font-medium text-gray-700 mb-1">ZIP code <span class="text-red-500">*</span></label>
              <input
                id="zip"
                name="zip"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{5}"
                placeholder="82601"
                aria-required="true"
                class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
              />
            </div>
          </div>
          <div>
            <label for="address1" class="block text-sm font-medium text-gray-700 mb-1">
              Street address <span class="text-gray-400 font-normal text-xs">(optional)</span>
            </label>
            <input
              id="address1"
              name="address1"
              type="text"
              autocomplete="address-line1"
              placeholder="123 Main St"
              class="w-full border-2 border-gray-200 rounded-lg px-4 py-3 focus:border-wy-ember focus:outline-none"
            />
            <p class="text-xs text-gray-400 mt-1">Adding your street address improves matching when names are similar.</p>
          </div>
        </div>

        <button type="submit" id="optin-submit" class="pulse-primary-action">
          Verify me and get my ballot
        </button>
        <button type="button" id="pulse-back" class="pulse-secondary-action">
          Back
        </button>
      </section>
    )}

    <!-- Hidden fields -->
    <input id="state" name="state" type="hidden" value="WY" />

    <!-- Honeypot -->
    <div class="hp-field" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none;">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" id="ts_start" name="ts_start" value="" />
    <div id="ts-slot" aria-live="polite"></div>

    <div id="form-message" class="hidden mt-2 text-center text-sm"></div>
  </form>

  {showPrivacyNote && (
    <div class="mt-6 bg-white rounded-xl p-5 border border-gray-100 text-sm text-gray-500">
      <h3 class="font-semibold text-wy-charcoal mb-2">How we protect your information</h3>
      <p>
        We collect the minimum information needed to send updates, including your name, mobile number,
        and optionally your email and ZIP. We protect data in transit with HTTPS, store consent records
        securely, and do not sell or share opt-in data for promotional or marketing purposes.
      </p>
    </div>
  )}
</div>

<script type="module" src="/js/pulse-optin.js?v=16"></script>

<style is:global>
  #optin-form .pulse-poll-card {
    border: 2px solid #b22234;
    border-radius: 1rem;
    background: #f1ece1;
    padding: 1.1rem;
  }

  #optin-form .pulse-primary-action,
  #optin-form .pulse-secondary-action {
    display: block;
    width: 100%;
    min-height: 3rem;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  #optin-form .pulse-primary-action {
    border: 1px solid #b22234;
    background: #b22234;
    color: #f1ece1;
    font-size: 1.05rem;
  }

  #optin-form .pulse-primary-action:hover,
  #optin-form .pulse-primary-action:focus-visible {
    border-color: #8b1a26;
    background: #8b1a26;
  }

  #optin-form .pulse-secondary-action {
    margin-top: 0.55rem;
    border: 1px solid transparent;
    background: transparent;
    color: #8a3d23;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  #optin-form .pulse-primary-action:disabled,
  #optin-form .pulse-secondary-action:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  #optin-form .pulse-form-step[hidden] {
    display: none;
  }

  #optin-form .optin-success {
    margin-top: 0.75rem;
    color: #166534;
    font-size: 0.95rem;
    font-weight: 600;
  }

  #optin-form .optin-error {
    margin-top: 0.75rem;
    color: #991b1b;
    font-size: 0.95rem;
    font-weight: 600;
  }

  #optin-form .pulse-consent-panel.has-error {
    border-color: rgba(153, 27, 27, 0.7);
    background: rgba(254, 242, 242, 0.92);
    box-shadow: 0 0 0 1px rgba(153, 27, 27, 0.12);
  }

  #optin-form #consent_sms:focus-visible {
    outline: 2px solid #b22234;
    outline-offset: 2px;
  }

  .optin-modal-backdrop {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(17, 24, 39, 0.55);
    z-index: 80;
  }

  .optin-modal-backdrop.show {
    display: flex;
  }

  .optin-modal-backdrop .optin-dialog {
    width: min(100%, 28rem);
    background: #f1ece1;
    color: #2b2b2b;
    border: 1px solid rgba(178, 34, 52, 0.2);
    border-radius: 1rem;
    padding: 1.25rem;
    box-shadow: 0 24px 60px rgba(17, 24, 39, 0.22);
  }

  .optin-modal-backdrop h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .optin-modal-backdrop p {
    margin: 0.25rem 0 0;
    line-height: 1.55;
  }

  .optin-modal-backdrop .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .optin-modal-backdrop .actions button {
    min-height: 2.75rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid #b22234;
    border-radius: 0.65rem;
    background: #b22234;
    color: #f1ece1;
    font-weight: 700;
    cursor: pointer;
  }
</style>
