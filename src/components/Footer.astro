---
// src/components/Footer.astro
---
<footer class="bg-wy-charcoal text-wy-bone/60 py-10 px-4 text-center text-sm border-t-4 border-wy-ember">
  <div class="max-w-5xl mx-auto">
    <hr class="topo-rule mb-6" />
    <p class="text-wy-bone font-serif font-extrabold text-lg mb-2 tracking-wide">Jimmy <span class="text-wy-ember">Skovgard</span> for U.S. Senate 2026</p>
    <p class="mb-4 uppercase tracking-[0.18em] text-xs text-wy-bone/50">Paid for by Skovgard for Senate</p>
    <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 mb-5 text-xs">
      <a href="/messages" class="hover:text-wy-ember transition-colors">Latest From Jimmy</a>
      <a href="/events" class="hover:text-wy-ember transition-colors">Events</a>
      <a href="/pulse" class="hover:text-wy-ember transition-colors">Pulse</a>
      <a href="/finance" class="hover:text-wy-ember transition-colors">Finance</a>
      <a href="/civ-tech" class="hover:text-wy-ember transition-colors">Civ-Tech</a>
      <a href="/share" class="hover:text-wy-ember transition-colors">Share a Message</a>
    </div>
    <div class="flex justify-center gap-6 mb-4">
      <a href="/privacy" class="hover:text-wy-ember transition-colors">Privacy</a>
      <a href="/terms" class="hover:text-wy-ember transition-colors">Terms</a>
      <a href="mailto:jimmy@grassrootsmvt.org" class="hover:text-wy-ember transition-colors">Contact</a>
    </div>
    <div class="flex justify-center gap-4">
      <a href="https://www.facebook.com/skovgard2026" target="_blank" rel="noopener" class="hover:text-wy-ember transition-colors">Facebook</a>
      <a href="https://jimskovgard.substack.com/" target="_blank" rel="noopener" class="hover:text-wy-ember transition-colors">Substack</a>
    </div>
  </div>
</footer>
