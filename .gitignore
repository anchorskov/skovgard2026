cd /home/anchor/projects/skovgard2026

cat > .gitignore <<'EOF'
# Hugo build outputs
/public/
/resources/_gen/
/hugo_stats.json
.hugo_build.lock

# Node
/node_modules/
dist/

# Cloudflare Workers (local state only)
.dev.vars
.wrangler/
**/.wrangler/state/

# Databases / local data
*.sqlite
*.db

# OS / editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files (never commit secrets)
.env
.env.*

# Archives & review artifacts
*.zip
site-all-*.zip
site-bundle-*.txt
site-binary-assets-*.txt
site-zip-manifest-*.csv
tree-*.txt
skovgard2026Tree.txt
.tmp/

# Backups
*.bak
*.old
*~
EOF
