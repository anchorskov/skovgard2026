---
// Candidates/src/layouts/Base.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
}

const {
  title = 'Wyoming 2026 Voter Guide',
  description = 'Wyoming 2026 primary voter guide and candidate research at candidates.skovgard2026.org.',
  currentPath = '',
  ogImage,
} = Astro.props;

const pageTitle = title.includes('Wyoming 2026') ? title : `${title} | Wyoming 2026 Voter Guide`;
const path = currentPath || Astro.url.pathname || '/';
// og:url follows the request's actual domain (skovgard2026.org or the this-is-us.org mirror)
// so share cards link back to whichever domain the visitor is on.
const ogUrl = `${Astro.url.origin}${path}`;
const resolvedOgImage = ogImage || `${Astro.url.origin}/og-image.png`;
// rel=canonical always points at the primary domain, regardless of mirror, to keep SEO consolidated.
const canonicalUrl = `https://candidates.skovgard2026.org${path}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={ogUrl} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={resolvedOgImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="Wyoming 2026 Voter Guide" />

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={resolvedOgImage} />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header" aria-label="Candidates voter guide">
        <a class="brand-mark" href="/" aria-label="Candidates home">
          <span class="brand-mark__rule"></span>
          <span>
            <span class="brand-mark__project">The Integrity Project</span>
            <strong>Wyoming 2026</strong>
            <small>Primary Voter Guide</small>
          </span>
        </a>
        <nav class="top-nav" aria-label="Guide sections">
          <a href="/" class:list={[{ active: currentPath === '/' }]}>Find ballot</a>
          <a href="/races" class:list={[{ active: currentPath.startsWith('/races') || currentPath.startsWith('/race/') }]}>Browse races</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer" aria-label="Campaign disclaimer">
        <span class="site-footer__rule"></span>
        <p>Paid for by Skovgard for Senate</p>
      </footer>
    </div>

    <button class="fb-trigger" id="fb-btn" aria-label="Send feedback" aria-expanded="false" aria-controls="fb-modal">
      Feedback
    </button>

    <div class="fb-overlay" id="fb-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title" hidden>
      <div class="fb-panel">
        <div class="fb-panel__head">
          <h2 class="fb-panel__title" id="fb-title">Send feedback</h2>
          <button class="fb-panel__close" id="fb-close" aria-label="Close">✕</button>
        </div>
        <form class="fb-panel__form" id="fb-form">
          <label class="fb-panel__label" for="fb-name">
            Name <span class="fb-optional">(optional)</span>
          </label>
          <input class="fb-panel__input" type="text" id="fb-name" name="name" autocomplete="name" />
          <label class="fb-panel__label" for="fb-msg">Message</label>
          <textarea class="fb-panel__textarea" id="fb-msg" name="message" rows="5" required placeholder="What would you like us to know?"></textarea>
          <button class="fb-panel__submit" type="submit">Open in email →</button>
        </form>
        <p class="fb-panel__note">Opens your email client. Nothing is sent until you hit send.</p>
      </div>
    </div>

    <script>
      (function () {
        const btn   = document.getElementById('fb-btn');
        const modal = document.getElementById('fb-modal');
        const close = document.getElementById('fb-close');
        const form  = document.getElementById('fb-form');
        if (!btn || !modal || !close || !form) return;

        function open() {
          modal.removeAttribute('hidden');
          btn.setAttribute('aria-expanded', 'true');
          const msg = document.getElementById('fb-msg');
          if (msg) msg.focus();
        }
        function shut() {
          modal.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }

        btn.addEventListener('click', open);
        close.addEventListener('click', shut);
        modal.addEventListener('click', function (e) { if (e.target === modal) shut(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) shut(); });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          const name = (document.getElementById('fb-name')?.value || '').trim();
          const msg  = (document.getElementById('fb-msg')?.value  || '').trim();
          if (!msg) return;
          const subject = encodeURIComponent('Wyoming Voter Guide Feedback');
          const body    = encodeURIComponent((name ? 'From: ' + name + '\n\n' : '') + msg);
          window.location.href = 'mailto:candidates@grassroots.org?subject=' + subject + '&body=' + body;
          shut();
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --charcoal: #2B2B2B;
    --ember: #B22234;
    --ember-dark: #8B1A26;
    --sandstone: #C68A4A;
    --sage: #7A8A6B;
    --bone: #F1ECE1;
    --rust: #8A3D23;
    --dust: #B7A88A;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    color: var(--charcoal);
    font-family: 'Source Sans 3', 'Inter', system-ui, sans-serif;
    line-height: 1.5;
  }

  a { color: inherit; }
  button, input { font: inherit; }

  .page-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 22px 0 64px;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark__rule {
    display: block;
    width: 10px;
    height: 42px;
    background: var(--ember);
    border-right: 4px solid var(--sandstone);
    flex-shrink: 0;
  }

  .brand-mark strong,
  h1, h2, h3 {
    font-family: 'Bitter', 'Merriweather', Georgia, serif;
    letter-spacing: -0.01em;
  }

  .brand-mark strong {
    display: block;
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .brand-mark__project {
    display: block;
    color: var(--charcoal);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.05;
  }

  .brand-mark small {
    display: block;
    color: var(--rust);
    font-weight: 700;
    text-transform: uppercase;
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    font-weight: 700;
  }

  .top-nav a {
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
  }

  .top-nav a:hover,
  .top-nav a:focus-visible,
  .top-nav a.active {
    color: var(--ember);
    text-decoration-color: var(--ember);
    text-decoration-line: underline;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--rust);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .badge--incumbent {
    background: var(--sandstone);
    color: var(--bone);
  }

  .badge--party-r {
    background: var(--ember);
    color: var(--bone);
  }

  .badge--party-d {
    background: #2e5fa3;
    color: #fff;
  }

  .badge--party-l {
    background: var(--sandstone);
    color: var(--bone);
  }

  .badge--party-other {
    background: var(--charcoal);
    color: var(--bone);
  }

  .site-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--dust);
  }

  .site-footer__rule {
    display: block;
    width: 8px;
    height: 28px;
    background: var(--ember);
    border-right: 3px solid var(--sandstone);
    flex-shrink: 0;
  }

  .site-footer p {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 620px) {
    .page-shell {
      width: min(100% - 24px, 1120px);
      padding-top: 14px;
    }

    .site-header {
      align-items: flex-start;
    }

    .top-nav {
      gap: 12px;
      font-size: 0.95rem;
    }
  }

  /* Feedback button + modal */
  .fb-trigger {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 900;
    height: 36px;
    padding: 0 16px;
    background: var(--ember);
    color: var(--bone);
    border: none;
    border-radius: 18px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    transition: background 0.1s;
  }

  .fb-trigger:hover,
  .fb-trigger:focus-visible {
    background: var(--ember-dark);
    outline: none;
  }

  .fb-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(43,43,43,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .fb-overlay[hidden] { display: none; }

  .fb-panel {
    width: min(480px, 100%);
    background: var(--bone);
    border-top: 4px solid var(--ember);
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fb-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .fb-panel__title {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.1;
  }

  .fb-panel__close {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    font-size: 1rem;
    color: var(--rust);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .fb-panel__close:hover { background: var(--dust); }

  .fb-panel__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .fb-panel__label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--charcoal);
  }

  .fb-optional {
    font-weight: 400;
    color: var(--rust);
  }

  .fb-panel__input,
  .fb-panel__textarea {
    width: 100%;
    padding: 8px 10px;
    border: 1.5px solid var(--dust);
    background: #fff;
    font-size: 0.95rem;
    color: var(--charcoal);
    border-radius: 3px;
    font-family: inherit;
  }

  .fb-panel__input:focus,
  .fb-panel__textarea:focus {
    outline: none;
    border-color: var(--ember);
  }

  .fb-panel__textarea { resize: vertical; }

  .fb-panel__submit {
    align-self: flex-start;
    height: 36px;
    padding: 0 18px;
    background: var(--ember);
    color: var(--bone);
    border: none;
    border-radius: 3px;
    font-size: 0.88rem;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.1s;
    margin-top: 4px;
  }

  .fb-panel__submit:hover { background: var(--ember-dark); }

  .fb-panel__note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--rust);
  }
</style>
