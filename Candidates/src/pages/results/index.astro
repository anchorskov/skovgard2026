---
// Candidates/src/pages/results/index.astro
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';

interface ElectionEvent {
  id: number;
  election_key: string;
  election_name: string;
  election_phase: string;
  election_date: string;
  polls_close_at: string;
}

interface ContestRow {
  contest_id: number;
  contest_name_normalized: string;
  level: string;
  district: number | null;
  ballot_party: string | null;
  reporting_scope: string;
  counties_reporting: number;
  precincts_reporting: number;
  precincts_total: number;
  is_unofficial: number;
  latest_retrieved_at: string;
}

const { results: cycles } = await env.WY_DB.prepare(
  'SELECT id, election_key, election_name, election_phase, election_date, polls_close_at FROM election_events ORDER BY election_date DESC'
).all<ElectionEvent>();

const requestedKey = Astro.url.searchParams.get('cycle');
const cycleWithData = await env.WY_DB.prepare(
  `SELECT ee.election_key FROM election_events ee
    JOIN election_contests ec ON ec.election_id = ee.id
   GROUP BY ee.id ORDER BY ee.election_date DESC LIMIT 1`
).first<{ election_key: string }>();

const selectedKey = requestedKey || cycleWithData?.election_key || cycles[0]?.election_key;
const cycle = cycles.find((c) => c.election_key === selectedKey) || cycles[0];

const pollsCloseAt = cycle ? new Date(cycle.polls_close_at) : null;
const now = new Date();
const pollsHaveClosed = pollsCloseAt ? now >= pollsCloseAt : false;

let contests: ContestRow[] = [];
if (cycle && pollsHaveClosed) {
  // Aggregates from v_election_selected_snapshot_contests, which has
  // exactly one row per (contest, county) -- never from
  // v_election_current_results, which has one row per candidate/writein/
  // overvote/undervote and would multiply precinct counts by however many
  // result rows a county contributes to a contest. Confirmed as a real
  // bug before this fix: a contest's true precinct total was inflated
  // roughly 4x by summing over the result-row grain instead of this one.
  const { results } = await env.WY_DB.prepare(
    `SELECT
       ec.id AS contest_id, ec.contest_name_normalized, ec.level, ec.district,
       ec.ballot_party, ec.reporting_scope,
       COUNT(DISTINCT ssc.county) AS counties_reporting,
       SUM(ssc.precincts_reporting) AS precincts_reporting,
       SUM(ssc.precincts_total) AS precincts_total,
       MAX(ssc.is_unofficial) AS is_unofficial,
       MAX(ssc.retrieved_at) AS latest_retrieved_at
     FROM election_contests ec
     JOIN v_election_selected_snapshot_contests ssc ON ssc.contest_id = ec.id
     WHERE ec.election_id = ?1
     GROUP BY ec.id, ec.contest_name_normalized, ec.level, ec.district, ec.ballot_party, ec.reporting_scope
     ORDER BY
       CASE ec.level WHEN 'federal' THEN 0 WHEN 'statewide' THEN 1 WHEN 'wy_senate' THEN 2 WHEN 'wy_house' THEN 3 WHEN 'county' THEN 4 WHEN 'city' THEN 5 ELSE 6 END,
       ec.district, ec.contest_name_normalized, ec.ballot_party`
  ).bind(cycle.id).all<ContestRow>();
  contests = results;
}

const phaseLabel: Record<string, string> = {
  primary: 'Primary Election',
  general: 'General Election',
  special: 'Special Election',
};
const pageHeading = cycle
  ? `Wyoming ${phaseLabel[cycle.election_phase as string] ?? 'Election'} Results`
  : 'Election Results';

const LEVEL_LABELS: Record<string, string> = {
  federal: 'Federal',
  statewide: 'Statewide',
  wy_senate: 'Wyoming Senate',
  wy_house: 'Wyoming House',
  county: 'County & Local',
  city: 'Municipal',
};

const PARTY_LABELS: Record<string, string> = {
  REP: 'Republican', DEM: 'Democrat', LIB: 'Libertarian', NP: 'No party',
};

const grouped = new Map<string, ContestRow[]>();
for (const c of contests) {
  const list = grouped.get(c.level) || [];
  list.push(c);
  grouped.set(c.level, list);
}
---

<Base title="Election Results" currentPath="/results">
  <div class="results-header">
    <p class="eyebrow">{pageHeading}</p>
    <h1>Results</h1>

    <form method="get" class="cycle-form">
      <label for="cycle-select">Election cycle</label>
      <select id="cycle-select" name="cycle" onchange="this.form.submit()">
        {cycles.map((c) => (
          <option value={c.election_key} selected={c.election_key === selectedKey}>
            {c.election_name}, {c.election_date}
          </option>
        ))}
      </select>
      <noscript><button type="submit">Go</button></noscript>
    </form>
  </div>

  {!cycle ? (
    <p class="empty-note">No election cycles configured yet.</p>
  ) : !pollsHaveClosed ? (
    <div class="embargo-panel" role="status">
      <p class="embargo-panel__heading">Results will appear after polls close.</p>
      <p>
        {cycle.election_name}, {cycle.election_date}. Polls close at{' '}
        <strong>{pollsCloseAt?.toLocaleString('en-US', { timeZone: 'America/Denver', dateStyle: 'long', timeStyle: 'short' })} Mountain Time</strong>.
      </p>
    </div>
  ) : contests.length === 0 ? (
    <p class="empty-note">No results have been loaded for {cycle.election_name} ({cycle.election_date}) yet.</p>
  ) : (
    <div class="contest-groups">
      {[...grouped.entries()].map(([level, list]) => (
        <section class="contest-group">
          <h2>{LEVEL_LABELS[level] ?? level}</h2>
          <ul class="contest-list" role="list">
            {list.map((c) => (
              <li class="contest-card">
                <a href={`/results/contest/${c.contest_id}`} class="contest-card__link">
                  <span class="contest-card__name">
                    {c.contest_name_normalized}{c.district ? `, District ${c.district}` : ''}
                  </span>
                  {c.ballot_party && (
                    <span class={`badge badge--party-${(c.ballot_party || '').toLowerCase()}`}>
                      {PARTY_LABELS[c.ballot_party] ?? c.ballot_party}
                    </span>
                  )}
                  <span class="contest-card__status">
                    {c.counties_reporting} {c.counties_reporting === 1 ? 'county' : 'counties'} reporting
                    {' · '}
                    {c.precincts_reporting}/{c.precincts_total} precincts
                  </span>
                  <span class="contest-card__unofficial">
                    {c.is_unofficial ? 'Unofficial results' : 'Certified'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</Base>

<style>
  .results-header { padding: 32px 0 20px; }
  .eyebrow { margin: 0 0 8px; color: #8A3D23; font-weight: 800; text-transform: uppercase; font-size: .86rem; }
  h1 { margin: 0 0 20px; font-family: 'Bitter', 'Merriweather', Georgia, serif; font-size: clamp(2.2rem, 5vw, 3.2rem); }
  .cycle-form { display: flex; align-items: center; gap: 10px; }
  .cycle-form label { font-weight: 700; }
  .cycle-form select {
    padding: .5rem .7rem; border: 2px solid #2B2B2B; border-radius: 4px; font: inherit; background: #F1ECE1;
  }
  .empty-note { padding: 24px 0; color: #2B2B2B; }
  .embargo-panel {
    padding: 24px; border: 1.5px solid #B7A88A; border-left: 4px solid #C68A4A; border-radius: 4px; background: #faf8f4;
  }
  .embargo-panel__heading { margin: 0 0 8px; font-weight: 800; font-size: 1.1rem; }
  .contest-groups { padding: 12px 0 48px; }
  .contest-group { margin-bottom: 32px; }
  .contest-group h2 {
    font-family: 'Bitter', 'Merriweather', Georgia, serif; font-size: 1.4rem; margin: 0 0 12px;
    border-bottom: 2px solid #2B2B2B; padding-bottom: 6px;
  }
  .contest-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .contest-card__link {
    display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; align-items: center;
    padding: 14px 16px; border: 1px solid #B7A88A; border-radius: 4px; background: #F1ECE1;
    text-decoration: none; color: #2B2B2B;
  }
  .contest-card__link:hover, .contest-card__link:focus-visible { border-color: #B22234; }
  .contest-card__name { font-weight: 800; grid-column: 1; }
  .contest-card__status { grid-column: 1; font-size: .9rem; opacity: .8; }
  .contest-card__unofficial { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-size: .85rem; font-weight: 700; color: #8A3D23; white-space: nowrap; }
  .badge { grid-column: 2; grid-row: 1; justify-self: end; padding: .2rem .55rem; border-radius: 3px; font-size: .78rem; font-weight: 800; }
  .badge--party-rep { background: #B22234; color: #F1ECE1; }
  .badge--party-dem { background: #2B2B2B; color: #F1ECE1; }
  .badge--party-lib { background: #7A8A6B; color: #F1ECE1; }
</style>
