---
// Candidates/src/pages/index.astro
import '../styles/global.css';
import { env } from 'cloudflare:workers';

const electionDate = 'August 18, 2026';
const googleGeocodeKey = (env as any)?.GOOGLE_CIVIC_API_KEY || '';
const turnstileSiteKey = (env as any)?.TURNSTILE_SITE_KEY || '';

let guideStats = [
  { value: '1016', label: 'races tracked' },
  { value: '1878', label: 'filed candidates' },
  { value: '19', label: 'of 23 counties' },
];

if (env?.WY_DB) {
  try {
    const { results } = await env.WY_DB.prepare(`
      SELECT
        COUNT(DISTINCT o.id)                                          AS total_races,
        COUNT(DISTINCT CASE WHEN c.withdrawn_at IS NULL THEN c.id END) AS active_candidates,
        COUNT(DISTINCT o.county)                                      AS county_count
      FROM offices o
      LEFT JOIN candidates c ON c.office_id = o.id
    `).all();
    const row = results[0] as any;
    if (row) {
      guideStats = [
        { value: String(row.total_races),       label: 'races tracked' },
        { value: String(row.active_candidates), label: 'filed candidates' },
        { value: String(row.county_count),      label: 'of 23 counties' },
      ];
    }
  } catch { /* fall through to static defaults */ }
}

const keyDates = [
  { date: 'July 2', label: 'Primary ballots posted in clerk offices' },
  { date: 'July 21', label: 'Regular absentee voting begins' },
  { date: 'Early August', label: 'Sample ballots expected from county clerks' },
  { date: 'August 18', label: 'Primary election day' },
];


const addressFields = [
  {
    id: 'house-number',
    name: 'houseNumber',
    label: 'House / Unit Number',
    autocomplete: 'address-line2',
    placeholder: '123',
  },
  {
    id: 'street-name',
    name: 'street',
    label: 'Street Name',
    autocomplete: 'address-line1',
    placeholder: 'Main St',
  },
  {
    id: 'city',
    name: 'city',
    label: 'City',
    autocomplete: 'address-level2',
    placeholder: 'Cheyenne',
  },
  {
    id: 'zip-code',
    name: 'zip',
    label: 'ZIP Code',
    autocomplete: 'postal-code',
    placeholder: '82001',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Find your Wyoming 2026 primary ballot, compare candidates, browse races, and learn who is running in your county, district, and precinct."
    />
    <meta name="generator" content={Astro.generator} />
    <title>Wyoming 2026 Primary Ballot Guide — Find Candidates by County &amp; District</title>

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content="https://candidates.skovgard2026.org/" />
    <meta property="og:title"       content="Wyoming 2026 Primary Ballot Guide — Find Candidates by County &amp; District" />
    <meta property="og:description" content="Find your Wyoming 2026 primary ballot, compare candidates, browse races, and learn who is running in your county, district, and precinct." />
    <meta property="og:image"       content="https://candidates.skovgard2026.org/og-image.png" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name"   content="Wyoming 2026 Voter Guide" />

    <!-- Cloudflare Turnstile (invisible bot protection for ballot lookup) -->
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="Wyoming 2026 Primary Ballot Guide — Find Candidates by County &amp; District" />
    <meta name="twitter:description" content="Find your Wyoming 2026 primary ballot, compare candidates, browse races, and learn who is running in your county, district, and precinct." />
    <meta name="twitter:image"       content="https://candidates.skovgard2026.org/og-image.png" />
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header" aria-label="Candidates voter guide">
        <a class="brand-mark" href="/" aria-label="Candidates home">
          <span class="brand-mark__rule"></span>
          <span>
            <span class="brand-mark__project">The Integrity Project</span>
            <strong>Wyoming 2026</strong>
            <small>Primary Voter Guide</small>
          </span>
        </a>
        <nav class="top-nav" aria-label="Guide sections">
          <a href="#address-form-section">Find ballot</a>
          <a href="/races">Browse races</a>
        </nav>
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Nonpartisan Primary Voter Guide</p>
          <h1 id="hero-title">Know who is on your Wyoming ballot before primary day.</h1>
          <p class="lede">
            This guide turns the 2026 candidate roster into a practical ballot lookup: start with where
            you vote, see the races that apply to you, and compare candidates from the same source set.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a class="button button--primary" href="#address-form-section">Find my ballot</a>
            <a class="button button--secondary" href="/races">Browse all races</a>
          </div>
        </div>

        <aside class="election-card" aria-label="Election snapshot">
          <p class="election-card__label">Primary election</p>
          <strong>{electionDate}</strong>
          <dl class="key-dates">
            {keyDates.map((item) => (
              <div class="key-dates__row">
                <dt>{item.date}</dt>
                <dd>{item.label}</dd>
              </div>
            ))}
          </dl>
          <dl class="stats-grid">
            {guideStats.map((stat) => (
              <div>
                <dt>{stat.value}</dt>
                <dd>{stat.label}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </section>

      <section id="address-form-section" class="lookup-panel" aria-labelledby="lookup-title">
        <div>
          <p class="eyebrow">Ballot lookup</p>
          <h2 id="lookup-title">Enter a Wyoming voting address.</h2>
          <p>
            The lookup matches your address to your legislative district and county using
            the Wyoming voter file and Census geocoding, then returns the races on your ballot.
          </p>
        </div>
        <form class="address-form" method="get" action="#lookup-status" aria-label="Address lookup preview">
          <div class="address-form__grid">
            {addressFields.map((field) => (
              <label for={field.id}>
                <span>{field.label}</span>
                <input
                  id={field.id}
                  name={field.name}
                  type="text"
                  autocomplete={field.autocomplete}
                  placeholder={field.placeholder}
                />
              </label>
            ))}
          </div>
          <div class="form-actions">
            <button type="submit">Find My Ballot</button>
            <button type="button" id="gps-btn" aria-label="Use my location to look up my ballot">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="9" stroke-width="1.5" opacity=".35"/>
              </svg>
              Use my location
            </button>
          </div>
          <div id="lookup-status" class="lookup-status" role="status" aria-live="polite" hidden></div>
          <div id="gps-confirm" class="gps-confirm-panel" hidden>
            <p id="gps-confirm-address" class="gps-confirm-address"></p>
            <div class="gps-confirm-actions">
              <button type="button" id="gps-confirm-proceed">Proceed</button>
              <button type="button" id="gps-confirm-manual">Enter manually</button>
            </div>
          </div>
          <div id="district-badges" class="district-badges" hidden></div>
          <div id="results" class="lookup-results" hidden></div>
          <div id="local-results" class="lookup-results lookup-results--local" hidden></div>
          <div id="polling-section" class="polling-section" hidden></div>
          <div id="fallback-panel" class="fallback-panel" hidden></div>
          {turnstileSiteKey && (
            <div
              id="ts-widget"
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-size="invisible"
              data-callback="onTurnstileSuccess"
              data-error-callback="onTurnstileError"
              data-expired-callback="onTurnstileExpired"
            ></div>
          )}
          <p class="form-note">Address data is used only for this ballot lookup. GPS coordinates may be logged anonymously to improve district matching.</p>
        </form>
      </section>

    </main>
    <footer class="site-footer" aria-label="Campaign disclaimer">
      <span class="site-footer__rule"></span>
      <p>Paid for by Skovgard for Senate &nbsp;&middot;&nbsp; <a href="/privacy">Privacy Policy</a></p>
    </footer>
    <script define:vars={{ googleGeocodeKey, turnstileSiteKey }}>
      window.__GOOGLE_GEOCODE_KEY__ = googleGeocodeKey || '';
      window.__TURNSTILE_SITE_KEY__ = turnstileSiteKey || '';
    </script>
    <script>
      const lookupForm = document.querySelector('.address-form');
      const lookupStatus = document.querySelector('#lookup-status');
      const lookupButton = lookupForm?.querySelector('button[type="submit"]');
      const districtBadges = document.querySelector('#district-badges');
      const lookupResults = document.querySelector('#results');
      const localResults = document.querySelector('#local-results');
      const pollingSection = document.querySelector('#polling-section');
      let gpsTriggeredLookup = false;
      let storedGpsLat = null;
      let storedGpsLon = null;

      // ── Turnstile (invisible) ───────────────────────────────────────────
      let _tsToken = null;
      let _tsResolve = null;

      window.onTurnstileSuccess = function (token) {
        _tsToken = token;
        if (_tsResolve) { _tsResolve(token); _tsResolve = null; }
      };
      window.onTurnstileError = function () {
        if (_tsResolve) { _tsResolve(null); _tsResolve = null; }
      };
      window.onTurnstileExpired = function () {
        _tsToken = null;
        if (window.turnstile) window.turnstile.reset('#ts-widget');
      };

      async function getTurnstileToken() {
        if (!window.__TURNSTILE_SITE_KEY__ || !window.turnstile) return null;
        if (_tsToken) {
          const tok = _tsToken;
          _tsToken = null;
          return tok;
        }
        return new Promise((resolve) => {
          _tsResolve = resolve;
          window.turnstile.execute('#ts-widget');
          setTimeout(() => {
            if (_tsResolve) { _tsResolve(null); _tsResolve = null; }
          }, 12000);
        });
      }

      function getFieldValue(name) {
        const field = lookupForm?.querySelector(`[name="${name}"]`);
        return field instanceof HTMLInputElement ? field.value.trim() : '';
      }

      function getField(name) {
        const field = lookupForm?.querySelector(`[name="${name}"]`);
        return field instanceof HTMLInputElement ? field : null;
      }

      const streetSuffixMap = new Map([
        ['STREET', 'St'],
        ['ST', 'St'],
        ['AVENUE', 'Ave'],
        ['AVE', 'Ave'],
        ['BOULEVARD', 'Blvd'],
        ['BLVD', 'Blvd'],
        ['HIGHWAY', 'Hwy'],
        ['HWY', 'Hwy'],
        ['PARKWAY', 'Pkwy'],
        ['PKWY', 'Pkwy'],
        ['TRAIL', 'Trl'],
        ['TRL', 'Trl'],
        ['CIRCLE', 'Cir'],
        ['CIR', 'Cir'],
        ['PLACE', 'Pl'],
        ['PL', 'Pl'],
        ['COURT', 'Ct'],
        ['CT', 'Ct'],
        ['DRIVE', 'Dr'],
        ['DR', 'Dr'],
        ['LANE', 'Ln'],
        ['LN', 'Ln'],
        ['ROAD', 'Rd'],
        ['RD', 'Rd'],
      ]);

      const directionMap = new Map([
        ['NORTH', 'N'],
        ['SOUTH', 'S'],
        ['EAST', 'E'],
        ['WEST', 'W'],
        ['NORTHEAST', 'NE'],
        ['NORTHWEST', 'NW'],
        ['SOUTHEAST', 'SE'],
        ['SOUTHWEST', 'SW'],
      ]);

      function normalizeHouseNumber(value) {
        return String(value || '').trim().replace(/[^\dA-Za-z-]/g, '').toUpperCase();
      }

      function titleStreetToken(token) {
        if (/^\d+(ST|ND|RD|TH)$/i.test(token)) {
          return token.toLowerCase().replace(/^\d+/, (digits) => digits);
        }
        if (/^[A-Z]{1,2}$/.test(token)) return token;
        return token.charAt(0).toUpperCase() + token.slice(1).toLowerCase();
      }

      // Browsers have no standard autocomplete token for "house number alone," so
      // autofill sometimes drops the full street address into either the house-number
      // field or the street field (never splitting it the way this form expects).
      function reconcileAddressFields(houseNumber, street) {
        let workingHouse = String(houseNumber || '').trim().replace(/\s+/g, ' ');
        let workingStreet = String(street || '').trim().replace(/\s+/g, ' ');
        const warnings = [];
        let changed = false;

        const houseMatch = workingHouse.match(/^(\d+[A-Za-z]?(?:-\d+)?)\s+(.+)$/);
        if (houseMatch) {
          const [, extractedNumber, remainder] = houseMatch;
          workingHouse = extractedNumber;
          if (!workingStreet) workingStreet = remainder;
          changed = true;
          warnings.push('Split the combined address entered in the house number field.');
        }

        if (!workingHouse) {
          const streetMatch = workingStreet.match(/^(\d+[A-Za-z]?(?:-\d+)?)\s+(.+)$/);
          if (streetMatch) {
            const [, extractedNumber, remainder] = streetMatch;
            workingHouse = extractedNumber;
            workingStreet = remainder;
            changed = true;
            warnings.push('Split the combined address entered in the street field.');
          }
        }

        return { houseNumber: workingHouse, street: workingStreet, changed, warnings };
      }

      function standardizeStreetName(street, houseNumber = '') {
        const original = String(street || '').trim().replace(/\s+/g, ' ');
        const houseKey = normalizeHouseNumber(houseNumber);
        let cleaned = original
          .replace(/[.,]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
        const warnings = [];

        if (houseKey) {
          const escapedHouse = houseKey.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const leadingHousePattern = new RegExp(`^${escapedHouse}\\b\\s+`, 'i');
          if (leadingHousePattern.test(cleaned)) {
            cleaned = cleaned.replace(leadingHousePattern, '').trim();
            warnings.push('Removed the duplicated house number from the street name.');
          }
        }

        const value = cleaned.split(/\s+/).filter(Boolean).map((token) => {
          const key = token.toUpperCase();
          if (directionMap.has(key)) return directionMap.get(key);
          if (streetSuffixMap.has(key)) return streetSuffixMap.get(key);
          return titleStreetToken(key);
        }).join(' ');

        return {
          value,
          changed: Boolean(original && value && original !== value),
          warnings,
        };
      }

      function clearFieldErrors() {
        ['houseNumber', 'street', 'city', 'zip'].forEach((name) => {
          getField(name)?.removeAttribute('aria-invalid');
        });
      }

      function markFieldErrors(fieldErrors = {}) {
        Object.keys(fieldErrors).forEach((name) => {
          getField(name)?.setAttribute('aria-invalid', 'true');
        });
      }

      function validateAndNormalizePayload() {
        clearFieldErrors();

        const payload = {
          houseNumber: getFieldValue('houseNumber'),
          street: getFieldValue('street'),
          city: getFieldValue('city'),
          zip: getFieldValue('zip'),
        };
        const fieldErrors = {};
        const warnings = [];

        const reconciled = reconcileAddressFields(payload.houseNumber, payload.street);
        if (reconciled.changed) {
          payload.houseNumber = reconciled.houseNumber;
          payload.street = reconciled.street;
          const houseField = getField('houseNumber');
          const streetField = getField('street');
          if (houseField) houseField.value = reconciled.houseNumber;
          if (streetField) streetField.value = reconciled.street;
          warnings.push(...reconciled.warnings);
        }

        const streetNormalization = standardizeStreetName(payload.street, payload.houseNumber);
        if (streetNormalization.value && streetNormalization.value !== payload.street) {
          payload.street = streetNormalization.value;
          const streetField = getField('street');
          if (streetField) streetField.value = streetNormalization.value;
          warnings.push(...streetNormalization.warnings);
        }

        if (payload.zip && !/^\d{5}$/.test(payload.zip)) {
          fieldErrors.zip = 'ZIP Code must be five digits.';
        }
        if (payload.street && !/[A-Za-z]/.test(payload.street)) {
          fieldErrors.street = 'Street name must include a street name, not only a number.';
        }

        return { payload, fieldErrors, warnings };
      }

      function setLookupStatus(message, tone = 'neutral') {
        if (!lookupStatus) return;
        lookupStatus.textContent = message;
        lookupStatus.dataset.tone = tone;
        lookupStatus.removeAttribute('hidden');
      }

      function setHidden(element, hidden) {
        if (!element) return;
        if (hidden) {
          element.setAttribute('hidden', '');
        } else {
          element.removeAttribute('hidden');
        }
      }

      function renderRaces(races) {
        if (!lookupResults) return;
        if (!Array.isArray(races) || races.length === 0) {
          setHidden(lookupResults, true);
          lookupResults.innerHTML = '';
          return;
        }

        lookupResults.innerHTML = `
          <h3>Races on your ballot</h3>
          <ul class="race-result-list">
            ${races.map((race) => {
              const count = Number(race.candidateCount);
              const countText = Number.isFinite(count)
                ? `${count} filed ${count === 1 ? 'candidate' : 'candidates'}`
                : race.status;
              return `<li>
                <a class="race-result-card" href="/race/${escapeHtml(String(race.id))}">
                  <span class="race-result-card__body">
                    <span class="race-result-card__name">${escapeHtml(race.name)}</span>
                    <span class="race-result-card__count">${escapeHtml(countText)}</span>
                  </span>
                  <span class="race-result-card__cta" aria-hidden="true">View candidates →</span>
                </a>
              </li>`;
            }).join('')}
          </ul>
          <div class="guide-ballot-cta">
            <p class="guide-ballot-cta__text">Ready to record your choices?</p>
            <a class="guide-ballot-cta__link" href="https://grassrootsmvt.org/ballot/" target="_blank" rel="noopener">
              Go to My Ballot &rarr;
            </a>
          </div>
        `;
        setHidden(lookupResults, false);
      }

      function renderLocalRaces(races, meta) {
        if (!localResults) return;

        const hasRaces = Array.isArray(races) && races.length > 0;
        const hasNote  = meta && (meta.hasPrecinctRaces || meta.hasWardRaces);

        if (!hasRaces && !hasNote) {
          setHidden(localResults, true);
          localResults.innerHTML = '';
          return;
        }

        function raceCards(list) {
          return list.map((race) => {
            const count = Number(race.candidateCount);
            const countText = Number.isFinite(count)
              ? `${count} filed ${count === 1 ? 'candidate' : 'candidates'}`
              : '';
            return `<li>
              <a class="race-result-card" href="/race/${escapeHtml(String(race.id))}">
                <span class="race-result-card__body">
                  <span class="race-result-card__name">${escapeHtml(race.name)}</span>
                  <span class="race-result-card__count">${escapeHtml(countText)}</span>
                </span>
                <span class="race-result-card__cta" aria-hidden="true">View candidates →</span>
              </a>
            </li>`;
          }).join('');
        }

        let html = '<h3>County &amp; Local races</h3>';

        if (hasRaces) {
          const precinctRaces = races.filter((r) => r.scopeKind === 'precinct_party' || r.scopeKind === 'precinct_party_gender');
          const countyRaces = races.filter((r) => r.level === 'county' && !precinctRaces.includes(r));
          const cityRaces   = races.filter((r) => r.level === 'city');
          const groupCount = [countyRaces, cityRaces, precinctRaces].filter((list) => list.length > 0).length;

          if (groupCount > 1 && countyRaces.length > 0) html += '<p class="local-sublabel">County offices</p>';
          if (countyRaces.length > 0) html += `<ul class="race-result-list">${raceCards(countyRaces)}</ul>`;
          if (groupCount > 1 && cityRaces.length > 0) html += '<p class="local-sublabel">Municipal offices</p>';
          if (cityRaces.length > 0)   html += `<ul class="race-result-list">${raceCards(cityRaces)}</ul>`;
          if (groupCount > 1 && precinctRaces.length > 0) html += '<p class="local-sublabel">Precinct offices</p>';
          if (precinctRaces.length > 0) html += `<ul class="race-result-list">${raceCards(precinctRaces)}</ul>`;
        }

        if (hasNote) {
          const parts = [];
          if (meta.hasPrecinctRaces) parts.push('precinct committee races');
          if (meta.hasWardRaces)     parts.push('ward races');
          const raceTypes = parts.join(' and ');
          const countySlug = meta.county
            ? meta.county.toLowerCase().replace(/\s+/g, '-')
            : '';
          const browseHref = countySlug ? `/races#county-${countySlug}` : '/races';
          html += `<p class="local-precinct-note">
            Your ballot may also include <strong>${escapeHtml(raceTypes)}</strong> that
            require your specific precinct or ward — we can't determine those from your
            address alone.
            <a href="${escapeHtml(browseHref)}">Browse all ${escapeHtml(meta.county || '')} County races →</a>
          </p>`;
        }

        localResults.innerHTML = html;
        setHidden(localResults, false);
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function formatCivicAddress(address) {
        if (!address) return '';
        return [address.locationName, address.line1, address.line2, address.line3, [address.city, address.state, address.zip].filter(Boolean).join(', ')]
          .filter(Boolean)
          .join('<br />');
      }

      function renderLocationList(title, locations) {
        if (!Array.isArray(locations) || locations.length === 0) return '';
        return `
          <section class="polling-subsection">
            <h4>${escapeHtml(title)}</h4>
            <ul>
              ${locations.map((location) => `
                <li>
                  ${location.name ? `<strong>${escapeHtml(location.name)}</strong>` : ''}
                  ${location.address ? `<p>${formatCivicAddress(location.address)}</p>` : ''}
                  ${location.pollingHours ? `<p><span>Hours:</span> ${escapeHtml(location.pollingHours)}</p>` : ''}
                  ${location.startDate || location.endDate ? `<p><span>Dates:</span> ${escapeHtml([location.startDate, location.endDate].filter(Boolean).join(' - '))}</p>` : ''}
                  ${location.notes ? `<p>${escapeHtml(location.notes)}</p>` : ''}
                </li>
              `).join('')}
            </ul>
          </section>
        `;
      }

      function renderElectionOffice(body) {
        if (!body) return '';
        const officials = Array.isArray(body.electionOfficials) ? body.electionOfficials : [];
        return `
          <section class="polling-subsection">
            <h4>Election office</h4>
            ${body.name ? `<strong>${escapeHtml(body.name)}</strong>` : ''}
            ${body.correspondenceAddress ? `<p>${formatCivicAddress(body.correspondenceAddress)}</p>` : ''}
            ${officials.map((official) => `
              <p>
                ${escapeHtml([official.title, official.name].filter(Boolean).join(': '))}
                ${official.officePhoneNumber ? `<br />${escapeHtml(official.officePhoneNumber)}` : ''}
                ${official.emailAddress ? `<br />${escapeHtml(official.emailAddress)}` : ''}
              </p>
            `).join('')}
            ${body.electionInfoUrl ? `<p><a href="${escapeHtml(body.electionInfoUrl)}" rel="noopener noreferrer">Election information</a></p>` : ''}
            ${body.votingLocationFinderUrl ? `<p><a href="${escapeHtml(body.votingLocationFinderUrl)}" rel="noopener noreferrer">Voting location finder</a></p>` : ''}
          </section>
        `;
      }

      function renderResolvedPolling(resolved) {
        if (!resolved?.location_name) return '';
        const labels = {
          gis_spatial: 'Polling location for your precinct',
          polygon_d1:  'Polling location for your precinct',
          city_d1:     'Polling location for your area',
        };
        const heading = labels[resolved.source] || 'Polling location';
        const note = resolved.source === 'city_d1'
          ? '<p class="polling-note">Based on your city. Verify with your county clerk before election day.</p>'
          : '';
        const addrLine = resolved.address
          ? `<p class="poll-loc-addr">${escapeHtml(resolved.address)}</p>`
          : '';
        return `
          <section class="polling-subsection polling-subsection--d1">
            <h4>${escapeHtml(heading)}</h4>
            <ul><li>
              <strong class="poll-loc-name">${escapeHtml(resolved.location_name)}</strong>
              ${addrLine}
            </li></ul>
            ${note}
          </section>
        `;
      }

      function renderPollingDetails(details, resolvedPolling) {
        if (!pollingSection) return;
        const status = details?.status || 'not_available';
        const d1Html = renderResolvedPolling(resolvedPolling);

        // api_not_configured: show D1 data if we have it, otherwise hide
        if (status === 'api_not_configured') {
          if (d1Html) {
            pollingSection.innerHTML = `<strong>Polling location</strong>${d1Html}`;
            setHidden(pollingSection, false);
          } else {
            setHidden(pollingSection, true);
          }
          return;
        }

        const polling  = Array.isArray(details?.pollingLocations)  ? details.pollingLocations  : [];
        const early    = Array.isArray(details?.earlyVoteSites)     ? details.earlyVoteSites    : [];
        const dropOff  = Array.isArray(details?.dropOffLocations)   ? details.dropOffLocations  : [];
        const officeHtml = renderElectionOffice(details?.electionAdministrationBody);

        const parts = [];

        if (d1Html) parts.push(d1Html);

        if (polling.length > 0) {
          parts.push(renderLocationList('Election Day voting locations for this address', polling));
        }
        if (early.length > 0) {
          parts.push(renderLocationList('Early voting sites', early));
        }
        if (dropOff.length > 0) {
          parts.push(renderLocationList('Ballot drop-off locations', dropOff));
        }

        // No location data at all — show a contextual message
        if (parts.length === 0) {
          const note = status === 'error'
            ? 'Polling-place lookup could not be completed. Please try again or contact your county clerk.'
            : 'Election Day polling locations for this address are not yet available. Check back closer to the primary, or contact your county clerk.';
          parts.push(`<p class="polling-note">${note}</p>`);
        }

        // Always append election office contact if returned
        if (officeHtml) parts.push(officeHtml);

        pollingSection.innerHTML = `<strong>Polling details</strong>${parts.join('')}`;
        setHidden(pollingSection, false);
      }

      const fallbackPanel = document.getElementById('fallback-panel');

      function renderFallback(data) {
        if (!fallbackPanel) return;
        const hasLegislative = Boolean(data.districts?.wyHouse || data.districts?.wySenate);
        const hasCounty      = Boolean(data.districts?.county);
        const hasLocalRaces  = Array.isArray(data.localRaces) && data.localRaces.length > 0;

        // Only show when no legislative district matched and no local races surfaced.
        // County-only or GPS-only matches still return statewide races — that's useful enough
        // to not need the fallback panel.
        if (hasLegislative || hasCounty || hasLocalRaces) {
          setHidden(fallbackPanel, true);
          return;
        }

        const countyName  = data.localMeta?.county || '';
        const countyLabel = countyName
          ? `${countyName.charAt(0).toUpperCase()}${countyName.slice(1).toLowerCase()} County`
          : '';
        const browseSlug  = countyName ? countyName.toLowerCase().replace(/\s+/g, '-') : '';
        const browseLink  = browseSlug
          ? `<li><a href="/races#county-${escapeHtml(browseSlug)}">Browse all ${escapeHtml(countyLabel)} races →</a></li>`
          : '';

        fallbackPanel.innerHTML = `
          <div class="fallback-panel__body">
            <p class="fallback-panel__heading">Address not found in our voter records</p>
            <p class="fallback-panel__text">Rural, highway, and newly built addresses may not appear in our current data. The statewide and federal races above apply to all Wyoming voters.</p>
            <ul class="fallback-panel__links">
              <li><a href="https://sos.wyo.gov/Elections/" target="_blank" rel="noopener">Wyoming Secretary of State — Elections &amp; Voter Information ↗</a></li>
              ${browseLink}
            </ul>
            <p class="fallback-panel__contact">Contact your county clerk to confirm your polling place and exact ballot before election day.</p>
          </div>
        `;
        setHidden(fallbackPanel, false);
      }

      function renderDistricts(districts, resolvedPolling) {
        if (!districtBadges) return;
        const pollingPrecinct = resolvedPolling?.source !== 'city_d1' ? resolvedPolling?.precinct : null;
        const chips = [
          districts?.wyHouse   ? { label: 'House',    value: districts.wyHouse }   : null,
          districts?.wySenate  ? { label: 'Senate',   value: districts.wySenate }  : null,
          districts?.county    ? { label: 'County',   value: toTitleCase(districts.county) } : null,
          pollingPrecinct      ? { label: 'Precinct', value: pollingPrecinct } : null,
        ].filter(Boolean);

        if (chips.length === 0) {
          districtBadges.innerHTML = '<span class="district-badge--pending">District information not found for this address. Try adding a unit number or check the street name.</span>';
        } else {
          districtBadges.innerHTML = chips
            .map((chip) => `<span class="district-badge"><span class="district-badge__label">${chip.label}:</span> ${escapeHtml(chip.value)}</span>`)
            .join('');
        }
        setHidden(districtBadges, false);
      }

      function toTitleCase(str) {
        return str.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
      }

      lookupForm?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const { payload, fieldErrors, warnings } = validateAndNormalizePayload();
        const missing = Object.entries(payload)
          .filter(([, value]) => !value)
          .map(([key]) => key);

        setHidden(districtBadges, true);
        setHidden(lookupResults, true);
        setHidden(localResults, true);
        setHidden(pollingSection, true);
        setHidden(fallbackPanel, true);

        if (missing.length > 0) {
          markFieldErrors(Object.fromEntries(missing.map((key) => [key, true])));
          setLookupStatus('Please complete house number, street name, city, and ZIP Code.', 'error');
          return;
        }

        if (Object.keys(fieldErrors).length > 0) {
          markFieldErrors(fieldErrors);
          setLookupStatus(Object.values(fieldErrors).join(' '), 'error');
          const firstError = Object.keys(fieldErrors)[0];
          getField(firstError)?.focus();
          return;
        }

        if (lookupButton instanceof HTMLButtonElement) {
          lookupButton.disabled = true;
          lookupButton.textContent = 'Looking up...';
        }
        setLookupStatus('Looking up ballot information...', 'loading');

        try {
          const cfToken = await getTurnstileToken();
          const enrichedPayload = {
            ...(storedGpsLat != null ? { ...payload, gpsLat: storedGpsLat, gpsLon: storedGpsLon } : payload),
            ...(cfToken ? { cf_turnstile_response: cfToken } : {}),
          };
          const response = await fetch('/api/ballot-lookup', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(enrichedPayload),
          });
          const data = await response.json();

          if (!response.ok || !data.success) {
            if (data.fieldErrors) {
              markFieldErrors(data.fieldErrors);
              const firstError = Object.keys(data.fieldErrors)[0];
              if (data.suggestedFix?.houseNumber && getField('houseNumber')) {
                getField('houseNumber').value = data.suggestedFix.houseNumber;
              }
              if (data.suggestedFix?.street && getField('street')) {
                getField('street').value = data.suggestedFix.street;
              }
              getField(firstError)?.focus();
            }
            setLookupStatus(data.message || 'Lookup failed. Please check the address fields.', 'error');
            return;
          }

          if (data.address?.standardizedFields?.houseNumber && getField('houseNumber')) {
            getField('houseNumber').value = data.address.standardizedFields.houseNumber;
          }
          if (data.address?.standardizedFields?.street && getField('street')) {
            getField('street').value = data.address.standardizedFields.street;
          }
          const standardizationNote = [
            ...warnings,
            ...(Array.isArray(data.inputWarnings) ? data.inputWarnings.map((warning) => warning.message).filter(Boolean) : []),
          ].filter(Boolean);
          const resolvedLabel = gpsTriggeredLookup ? 'Near your location:' : 'Resolved address:';
          gpsTriggeredLookup = false;
          setLookupStatus(
            `${standardizationNote.length > 0 ? `${standardizationNote.join(' ')} ` : ''}${data.message} ${resolvedLabel} ${data.address.combined}`,
            'success'
          );
          renderDistricts(data.districts, data.resolvedPollingPlace);
          renderRaces(data.races);
          renderLocalRaces(data.localRaces, data.localMeta);
          renderPollingDetails(data.pollingDetails, data.resolvedPollingPlace);
          renderFallback(data);
        } catch {
          setLookupStatus('Lookup route could not be reached. Please try again later.', 'error');
        } finally {
          storedGpsLat = null;
          storedGpsLon = null;
          if (lookupButton instanceof HTMLButtonElement) {
            lookupButton.disabled = false;
            lookupButton.textContent = 'Find My Ballot';
          }
        }
      });

      // GPS "Use my location" handler
      const gpsBtn = document.getElementById('gps-btn');
      if (gpsBtn) {
        const GPS_ORIGINAL_HTML = gpsBtn.innerHTML;

        async function reverseGeocodeGoogle(lat, lon) {
          const key = window.__GOOGLE_GEOCODE_KEY__;
          if (!key) return null;
          const resp = await fetch(
            `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lon}&result_type=street_address&key=${key}`
          );
          if (!resp.ok) return null;
          const data = await resp.json();
          if (data.status !== 'OK' || !data.results?.[0]) return null;
          const components = data.results[0].address_components;
          const get = (type) => components.find((c) => c.types.includes(type))?.short_name ?? '';
          return {
            number:     get('street_number'),
            street:     get('route'),
            city:       get('locality') || get('sublocality') || get('postal_town'),
            postalCode: get('postal_code'),
          };
        }

        async function reverseGeocodeNominatim(lat, lon) {
          const la = lat.toFixed(4);
          const lo = lon.toFixed(4);
          const resp = await fetch(
            `https://nominatim.openstreetmap.org/reverse?lat=${la}&lon=${lo}&format=json&addressdetails=1&zoom=17`,
            { headers: { 'User-Agent': 'skovgard2026-ballot-lookup/1.0 (guide.skovgard2026.org)' } }
          );
          return resp.ok ? resp.json() : null;
        }

        async function reverseGeocodeCensus(lat, lon) {
          const resp = await fetch(
            `https://geocoding.geo.census.gov/geocoder/locations/coordinates?x=${lon}&y=${lat}&benchmark=Public_AR_Current&format=json`
          );
          if (!resp.ok) return null;
          const data = await resp.json();
          return data?.result?.addressMatches?.[0] ?? null;
        }

        gpsBtn.addEventListener('click', () => {
          if (!navigator.geolocation) {
            setLookupStatus('Location is not supported in this browser. Please enter your address manually.', 'error');
            return;
          }

          gpsBtn.disabled = true;
          gpsBtn.textContent = 'Finding location…';
          setLookupStatus('Requesting your location…', 'loading');

          navigator.geolocation.getCurrentPosition(
            async (position) => {
              const { latitude: lat, longitude: lon, accuracy } = position.coords;
              storedGpsLat = lat;
              storedGpsLon = lon;
              try {
                setLookupStatus('Finding your address…', 'loading');

                let houseNumber = '', street = '', city = '', zip = '';
                let weakSignal = false;

                if (accuracy > 500) {
                  // Signal too weak to reverse-geocode reliably — skip geocoders
                  weakSignal = true;
                } else {
                  if (accuracy > 200) weakSignal = true;

                  // 1. Google Geocoding API — best rural US coverage
                  const google = await reverseGeocodeGoogle(lat, lon);
                  if (google) {
                    houseNumber = google.number ?? '';
                    street      = google.street ?? '';
                    city        = google.city ?? '';
                    zip         = google.postalCode ?? '';
                  }

                  // 2. Nominatim fallback
                  if (!houseNumber || !street || !city || !zip) {
                    const nom = await reverseGeocodeNominatim(lat, lon);
                    if (nom?.address) {
                      const a = nom.address;
                      if (!houseNumber) houseNumber = a.house_number ?? '';
                      if (!street)      street      = a.road ?? '';
                      if (!city)        city        = a.city ?? a.town ?? a.village ?? a.hamlet ?? '';
                      if (!zip)         zip         = (a.postcode ?? '').replace(/\D/g, '').slice(0, 5);
                    }
                  }

                  // 3. Census Bureau fallback
                  if (!houseNumber || !street || !city || !zip) {
                    const census = await reverseGeocodeCensus(lat, lon);
                    if (census?.addressComponents) {
                      const c = census.addressComponents;
                      if (!houseNumber) houseNumber = c.fromAddress ?? '';
                      if (!street) {
                        street = [c.preDirectional, c.streetName, c.suffixType, c.postDirectional].filter(Boolean).join(' ');
                      }
                      if (!city) city = c.city ?? '';
                      if (!zip)  zip  = c.zip ?? '';
                    }
                  }
                }

                const setField = (name, val) => {
                  const f = lookupForm?.querySelector(`[name="${name}"]`);
                  if (f instanceof HTMLInputElement) f.value = val;
                };
                setField('houseNumber', houseNumber);
                setField('street', street);
                setField('city', city);
                setField('zip', zip);

                // Build a human-readable address label for confirmation
                let displayAddress = null;
                if (street && city) {
                  displayAddress = [houseNumber, street].filter(Boolean).join(' ') + ', ' + city + (zip ? ', WY ' + zip : ', WY');
                } else if (city) {
                  displayAddress = city + (zip ? ', WY ' + zip : ', WY');
                }

                const accuracyNote = weakSignal
                  ? ` <span class="gps-accuracy-note">(GPS accuracy ±${Math.round(accuracy)}m — signal is weak)</span>`
                  : '';

                const confirmPanel = document.getElementById('gps-confirm');
                const confirmAddressEl = document.getElementById('gps-confirm-address');
                if (confirmPanel && confirmAddressEl) {
                  confirmAddressEl.innerHTML = displayAddress
                    ? `You are near <strong>${displayAddress}</strong>. Use this address for your ballot lookup?${accuracyNote}`
                    : `Your GPS location was found but a street address could not be determined. Coordinates will be used to match your ballot districts.${accuracyNote}`;
                  confirmPanel.hidden = false;
                  setLookupStatus('', '');
                } else {
                  // Fallback: no confirm panel, just submit
                  gpsTriggeredLookup = true;
                  lookupForm?.requestSubmit();
                }
              } catch {
                setLookupStatus('Could not determine your address. Please enter it manually.', 'error');
              } finally {
                gpsBtn.disabled = false;
                gpsBtn.innerHTML = GPS_ORIGINAL_HTML;
              }
            },
            (err) => {
              gpsBtn.disabled = false;
              gpsBtn.innerHTML = GPS_ORIGINAL_HTML;
              const msgs = {
                1: 'Location access was denied. Please allow location in your browser settings and try again.',
                2: 'Your location could not be determined. Please enter your address manually.',
                3: 'Location request timed out. Please enter your address manually.',
              };
              setLookupStatus(msgs[err.code] || 'Could not access your location.', 'error');
            },
            { timeout: 15000, enableHighAccuracy: true }
          );
        });

        // GPS confirmation panel handlers
        document.getElementById('gps-confirm-proceed')?.addEventListener('click', () => {
          document.getElementById('gps-confirm').hidden = true;
          gpsTriggeredLookup = true;
          lookupForm?.requestSubmit();
        });

        document.getElementById('gps-confirm-manual')?.addEventListener('click', () => {
          document.getElementById('gps-confirm').hidden = true;
          storedGpsLat = null;
          storedGpsLon = null;
          lookupForm?.querySelector('[name="houseNumber"]')?.focus();
        });
      }

    </script>
  </body>
</html>

