---
// Candidates/src/pages/index.astro
import '../styles/global.css';
import { env } from 'cloudflare:workers';

const electionDate = 'August 18, 2026';

let guideStats = [
  { value: '325', label: 'races tracked' },
  { value: '595', label: 'filed candidates' },
  { value: '4', label: 'of 23 counties' },
];

if (env?.WY_DB) {
  try {
    const { results } = await env.WY_DB.prepare(`
      SELECT
        COUNT(DISTINCT o.id)                                          AS total_races,
        COUNT(DISTINCT CASE WHEN c.withdrawn_at IS NULL THEN c.id END) AS active_candidates,
        COUNT(DISTINCT o.county)                                      AS county_count
      FROM offices o
      LEFT JOIN candidates c ON c.office_id = o.id
    `).all();
    const row = results[0] as any;
    if (row) {
      guideStats = [
        { value: String(row.total_races),       label: 'races tracked' },
        { value: String(row.active_candidates), label: 'filed candidates' },
        { value: String(row.county_count),      label: 'of 23 counties' },
      ];
    }
  } catch { /* fall through to static defaults */ }
}

const keyDates = [
  { date: 'July 2', label: 'Primary ballots posted in clerk offices' },
  { date: 'July 21', label: 'Regular absentee voting begins' },
  { date: 'Early August', label: 'Sample ballots expected from county clerks' },
  { date: 'August 18', label: 'Primary election day' },
];


const addressFields = [
  {
    id: 'house-number',
    name: 'houseNumber',
    label: 'House / Unit Number',
    autocomplete: 'address-line2',
    placeholder: '123',
  },
  {
    id: 'street-name',
    name: 'street',
    label: 'Street Name',
    autocomplete: 'address-line1',
    placeholder: 'Main St',
  },
  {
    id: 'city',
    name: 'city',
    label: 'City',
    autocomplete: 'address-level2',
    placeholder: 'Cheyenne',
  },
  {
    id: 'zip-code',
    name: 'zip',
    label: 'ZIP Code',
    autocomplete: 'postal-code',
    placeholder: '82001',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Wyoming 2026 primary voter guide and candidate lookup for candidates.skovgard2026.org."
    />
    <meta name="generator" content={Astro.generator} />
    <title>Wyoming 2026 Voter Guide | Candidates</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header" aria-label="Candidates voter guide">
        <a class="brand-mark" href="/" aria-label="Candidates home">
          <span class="brand-mark__rule"></span>
          <span>
            <span class="brand-mark__project">The Integrity Project</span>
            <strong>Wyoming 2026</strong>
            <small>Primary Voter Guide</small>
          </span>
        </a>
        <nav class="top-nav" aria-label="Guide sections">
          <a href="#address-form-section">Find ballot</a>
          <a href="/races">Browse races</a>
        </nav>
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Nonpartisan Primary Voter Guide</p>
          <h1 id="hero-title">Know who is on your Wyoming ballot before primary day.</h1>
          <p class="lede">
            This guide turns the 2026 candidate roster into a practical ballot lookup: start with where
            you vote, see the races that apply to you, and compare candidates from the same source set.
          </p>
          <div class="hero__actions" aria-label="Primary actions">
            <a class="button button--primary" href="#address-form-section">Find my ballot</a>
            <a class="button button--secondary" href="/races">Browse all races</a>
          </div>
        </div>

        <aside class="election-card" aria-label="Election snapshot">
          <p class="election-card__label">Primary election</p>
          <strong>{electionDate}</strong>
          <dl class="key-dates">
            {keyDates.map((item) => (
              <div class="key-dates__row">
                <dt>{item.date}</dt>
                <dd>{item.label}</dd>
              </div>
            ))}
          </dl>
          <dl class="stats-grid">
            {guideStats.map((stat) => (
              <div>
                <dt>{stat.value}</dt>
                <dd>{stat.label}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </section>

      <section id="address-form-section" class="lookup-panel" aria-labelledby="lookup-title">
        <div>
          <p class="eyebrow">Ballot lookup</p>
          <h2 id="lookup-title">Enter a Wyoming voting address.</h2>
          <p>
            The lookup matches your address to your legislative district, county, and precinct using
            the Wyoming voter file and Census geocoding, then returns the races on your ballot.
          </p>
        </div>
        <form class="address-form" method="get" action="#lookup-status" aria-label="Address lookup preview">
          <div class="address-form__grid">
            {addressFields.map((field) => (
              <label for={field.id}>
                <span>{field.label}</span>
                <input
                  id={field.id}
                  name={field.name}
                  type="text"
                  autocomplete={field.autocomplete}
                  placeholder={field.placeholder}
                />
              </label>
            ))}
          </div>
          <button type="submit">Find My Ballot</button>
          <div id="lookup-status" class="lookup-status" role="status" aria-live="polite" hidden></div>
          <div id="district-badges" class="district-badges" hidden></div>
          <div id="results" class="lookup-results" hidden></div>
          <div id="polling-section" class="polling-section" hidden></div>
          <p class="form-note">Address data is sent only to this lookup request and is not stored.</p>
        </form>
      </section>

    </main>
    <footer class="site-footer" aria-label="Campaign disclaimer">
      <span class="site-footer__rule"></span>
      <p>Paid for by Skovgard for Senate</p>
    </footer>
    <script>
      const lookupForm = document.querySelector('.address-form');
      const lookupStatus = document.querySelector('#lookup-status');
      const lookupButton = lookupForm?.querySelector('button[type="submit"]');
      const districtBadges = document.querySelector('#district-badges');
      const lookupResults = document.querySelector('#results');
      const pollingSection = document.querySelector('#polling-section');

      function getFieldValue(name) {
        const field = lookupForm?.querySelector(`[name="${name}"]`);
        return field instanceof HTMLInputElement ? field.value.trim() : '';
      }

      function setLookupStatus(message, tone = 'neutral') {
        if (!lookupStatus) return;
        lookupStatus.textContent = message;
        lookupStatus.dataset.tone = tone;
        lookupStatus.removeAttribute('hidden');
      }

      function setHidden(element, hidden) {
        if (!element) return;
        if (hidden) {
          element.setAttribute('hidden', '');
        } else {
          element.removeAttribute('hidden');
        }
      }

      function renderRaces(races) {
        if (!lookupResults) return;
        if (!Array.isArray(races) || races.length === 0) {
          setHidden(lookupResults, true);
          lookupResults.innerHTML = '';
          return;
        }

        lookupResults.innerHTML = `
          <h3>Races on your ballot</h3>
          <ul class="race-result-list">
            ${races.map((race) => {
              const count = Number(race.candidateCount);
              const countText = Number.isFinite(count)
                ? `${count} filed ${count === 1 ? 'candidate' : 'candidates'}`
                : race.status;
              return `<li>
                <a class="race-result-card" href="/race/${escapeHtml(String(race.id))}">
                  <span class="race-result-card__body">
                    <span class="race-result-card__name">${escapeHtml(race.name)}</span>
                    <span class="race-result-card__count">${escapeHtml(countText)}</span>
                  </span>
                  <span class="race-result-card__cta" aria-hidden="true">View candidates →</span>
                </a>
              </li>`;
            }).join('')}
          </ul>
        `;
        setHidden(lookupResults, false);
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function formatCivicAddress(address) {
        if (!address) return '';
        return [address.locationName, address.line1, address.line2, address.line3, [address.city, address.state, address.zip].filter(Boolean).join(', ')]
          .filter(Boolean)
          .join('<br />');
      }

      function renderLocationList(title, locations) {
        if (!Array.isArray(locations) || locations.length === 0) return '';
        return `
          <section class="polling-subsection">
            <h4>${escapeHtml(title)}</h4>
            <ul>
              ${locations.map((location) => `
                <li>
                  ${location.name ? `<strong>${escapeHtml(location.name)}</strong>` : ''}
                  ${location.address ? `<p>${formatCivicAddress(location.address)}</p>` : ''}
                  ${location.pollingHours ? `<p><span>Hours:</span> ${escapeHtml(location.pollingHours)}</p>` : ''}
                  ${location.startDate || location.endDate ? `<p><span>Dates:</span> ${escapeHtml([location.startDate, location.endDate].filter(Boolean).join(' - '))}</p>` : ''}
                  ${location.notes ? `<p>${escapeHtml(location.notes)}</p>` : ''}
                </li>
              `).join('')}
            </ul>
          </section>
        `;
      }

      function renderElectionOffice(body) {
        if (!body) return '';
        const officials = Array.isArray(body.electionOfficials) ? body.electionOfficials : [];
        return `
          <section class="polling-subsection">
            <h4>Election office</h4>
            ${body.name ? `<strong>${escapeHtml(body.name)}</strong>` : ''}
            ${body.correspondenceAddress ? `<p>${formatCivicAddress(body.correspondenceAddress)}</p>` : ''}
            ${officials.map((official) => `
              <p>
                ${escapeHtml([official.title, official.name].filter(Boolean).join(': '))}
                ${official.officePhoneNumber ? `<br />${escapeHtml(official.officePhoneNumber)}` : ''}
                ${official.emailAddress ? `<br />${escapeHtml(official.emailAddress)}` : ''}
              </p>
            `).join('')}
            ${body.electionInfoUrl ? `<p><a href="${escapeHtml(body.electionInfoUrl)}" rel="noopener noreferrer">Election information</a></p>` : ''}
            ${body.votingLocationFinderUrl ? `<p><a href="${escapeHtml(body.votingLocationFinderUrl)}" rel="noopener noreferrer">Voting location finder</a></p>` : ''}
          </section>
        `;
      }

      function renderPollingDetails(details) {
        if (!pollingSection) return;
        const status = details?.status || 'not_available';

        // api_not_configured is an ops issue, not a user-facing message
        if (status === 'api_not_configured') {
          setHidden(pollingSection, true);
          return;
        }

        const polling  = Array.isArray(details?.pollingLocations)  ? details.pollingLocations  : [];
        const early    = Array.isArray(details?.earlyVoteSites)     ? details.earlyVoteSites    : [];
        const dropOff  = Array.isArray(details?.dropOffLocations)   ? details.dropOffLocations  : [];
        const officeHtml = renderElectionOffice(details?.electionAdministrationBody);

        const parts = [];

        if (polling.length > 0) {
          parts.push(renderLocationList('Election Day voting locations for this address', polling));
        }
        if (early.length > 0) {
          parts.push(renderLocationList('Early voting sites', early));
        }
        if (dropOff.length > 0) {
          parts.push(renderLocationList('Ballot drop-off locations', dropOff));
        }

        // No location arrays returned — show a contextual message
        if (parts.length === 0) {
          const note = status === 'error'
            ? 'Polling-place lookup could not be completed. Please try again or contact your county clerk.'
            : 'Election Day polling locations for this address are not yet available from Google Civic. Check back closer to the primary, or contact your county clerk.';
          parts.push(`<p class="polling-note">${note}</p>`);
        }

        // Always append election office contact if returned, regardless of polling data
        if (officeHtml) parts.push(officeHtml);

        pollingSection.innerHTML = `<strong>Polling details</strong>${parts.join('')}`;
        setHidden(pollingSection, false);
      }

      function renderDistricts(districts) {
        if (!districtBadges) return;
        const chips = [
          districts?.wyHouse   ? { label: 'House',    value: districts.wyHouse }   : null,
          districts?.wySenate  ? { label: 'Senate',   value: districts.wySenate }  : null,
          districts?.county    ? { label: 'County',   value: toTitleCase(districts.county) } : null,
          districts?.precinct  ? { label: 'Precinct', value: districts.precinct }  : null,
        ].filter(Boolean);

        if (chips.length === 0) {
          districtBadges.innerHTML = '<span class="district-badge--pending">District information not found for this address. Try adding a unit number or check the street name.</span>';
        } else {
          districtBadges.innerHTML = chips
            .map((chip) => `<span class="district-badge"><span class="district-badge__label">${chip.label}:</span> ${escapeHtml(chip.value)}</span>`)
            .join('');
        }
        setHidden(districtBadges, false);
      }

      function toTitleCase(str) {
        return str.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
      }

      lookupForm?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const payload = {
          houseNumber: getFieldValue('houseNumber'),
          street: getFieldValue('street'),
          city: getFieldValue('city'),
          zip: getFieldValue('zip'),
        };
        const missing = Object.entries(payload)
          .filter(([, value]) => !value)
          .map(([key]) => key);

        setHidden(districtBadges, true);
        setHidden(lookupResults, true);
        setHidden(pollingSection, true);

        if (missing.length > 0) {
          setLookupStatus('Please complete house number, street name, city, and ZIP Code.', 'error');
          return;
        }

        if (lookupButton instanceof HTMLButtonElement) {
          lookupButton.disabled = true;
          lookupButton.textContent = 'Looking up...';
        }
        setLookupStatus('Looking up ballot information...', 'loading');

        try {
          const response = await fetch('/api/ballot-lookup', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await response.json();

          if (!response.ok || !data.success) {
            setLookupStatus(data.message || 'Lookup failed. Please check the address fields.', 'error');
            return;
          }

          setLookupStatus(
            `${data.message} Resolved address: ${data.address.combined}`,
            'success'
          );
          renderDistricts(data.districts);
          renderRaces(data.races);
          renderPollingDetails(data.pollingDetails);
        } catch {
          setLookupStatus('Lookup route could not be reached. Please try again later.', 'error');
        } finally {
          if (lookupButton instanceof HTMLButtonElement) {
            lookupButton.disabled = false;
            lookupButton.textContent = 'Find My Ballot';
          }
        }
      });

    </script>
  </body>
</html>

<style>
  :root {
    --charcoal: #2B2B2B;
    --ember: #B22234;
    --ember-dark: #8B1A26;
    --sandstone: #C68A4A;
    --sage: #7A8A6B;
    --bone: #F1ECE1;
    --rust: #8A3D23;
    --dust: #B7A88A;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--charcoal);
    font-family: 'Source Sans 3', 'Inter', system-ui, sans-serif;
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .page-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 22px 0 56px;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark__rule {
    display: block;
    width: 10px;
    height: 42px;
    background: var(--ember);
    border-right: 4px solid var(--sandstone);
  }

  .brand-mark strong,
  h1,
  h2,
  h3 {
    font-family: 'Bitter', 'Merriweather', Georgia, serif;
    letter-spacing: -0.01em;
  }

  .brand-mark strong {
    display: block;
    font-size: 1.1rem;
    line-height: 1.05;
  }

  .brand-mark__project {
    display: block;
    color: var(--charcoal);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.05;
  }

  .brand-mark small {
    display: block;
    color: var(--rust);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    font-weight: 700;
  }

  .top-nav a {
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
  }

  .top-nav a:hover,
  .top-nav a:focus-visible {
    color: var(--ember);
    text-decoration-color: var(--ember);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
    gap: 36px;
    align-items: stretch;
    padding: 68px 0 40px;
  }

  .hero__copy {
    padding: 18px 0;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--rust);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 6.8rem);
    line-height: 0.93;
  }

  .lede {
    max-width: 660px;
    margin: 24px 0 0;
    color: var(--charcoal);
    font-size: clamp(1.1rem, 2vw, 1.32rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button,
  .address-form button,
  .flow-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.7rem 1.1rem;
    border: 2px solid var(--charcoal);
    border-radius: 4px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }

  .button--primary,
  .address-form button {
    border-color: var(--ember);
    background: var(--ember);
    color: var(--bone);
  }

  .button--primary:hover,
  .button--primary:focus-visible,
  .address-form button:hover,
  .address-form button:focus-visible {
    border-color: var(--ember-dark);
    background: var(--ember-dark);
  }

  .button--secondary {
    background: transparent;
    color: var(--charcoal);
  }

  .button--secondary:hover,
  .button--secondary:focus-visible {
    border-color: var(--rust);
    color: var(--rust);
  }

  .election-card,
  .lookup-panel,
  .flow-grid article,
  .race-list article,
  .status-board article {
    border: 1px solid var(--dust);
    background: var(--bone);
    box-shadow: 0 10px 0 var(--dust);
  }

  .election-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    min-height: 420px;
    border-top: 8px solid var(--charcoal);
  }

  .election-card__label {
    margin: 0;
    color: var(--rust);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .election-card strong {
    display: block;
    margin-top: 10px;
    font-family: 'Bitter', 'Merriweather', Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 0.98;
  }

  .election-card p:not(.election-card__label) {
    margin: 18px 0 0;
    font-size: 1.05rem;
  }

  .key-dates {
    display: grid;
    gap: 0;
    margin: 20px 0 0;
    border-top: 1px solid var(--dust);
  }

  .key-dates__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 8px;
    align-items: baseline;
    padding: 8px 0;
    border-bottom: 1px solid var(--dust);
    font-size: 0.92rem;
  }

  .key-dates dt {
    font-weight: 800;
    color: var(--rust);
  }

  .key-dates dd {
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 26px 0 0;
    background: var(--dust);
    border: 1px solid var(--dust);
  }

  .stats-grid div {
    padding: 14px 10px;
    background: var(--bone);
  }

  .stats-grid dt {
    font-family: 'Bitter', 'Merriweather', Georgia, serif;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }

  .stats-grid dd {
    margin: 6px 0 0;
    color: var(--rust);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .lookup-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 28px;
    align-items: center;
    margin-top: 28px;
    padding: 30px;
    border-left: 8px solid var(--sandstone);
  }

  .lookup-panel h2,
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
  }

  .lookup-panel p,
  .section-heading p + h2 + p {
    margin: 14px 0 0;
  }

  .address-form {
    display: grid;
    gap: 14px;
  }

  .address-form label {
    display: grid;
    gap: 6px;
    font-weight: 800;
  }

  .address-form label span {
    display: block;
  }

  .address-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .address-form input {
    width: 100%;
    min-height: 48px;
    border: 2px solid var(--dust);
    border-radius: 4px;
    background: var(--bone);
    color: var(--charcoal);
    padding: 0 0.9rem;
  }

  .address-form input:focus {
    border-color: var(--ember);
    outline: 3px solid var(--dust);
  }

  .form-note {
    margin: 0;
    color: var(--rust);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .lookup-status,
  .district-badges,
  .lookup-results,
  .polling-section {
    border: 1px solid var(--dust);
    padding: 12px;
    color: var(--charcoal);
    font-weight: 700;
  }

  .district-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .district-badge,
  .district-badge--pending {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    border: 1px solid var(--sage);
    padding: 4px 10px;
    background: var(--bone);
    gap: 6px;
  }

  .district-badge--pending {
    border-color: var(--dust);
    color: var(--rust);
    font-size: 0.92rem;
  }

  .district-badge__label {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust);
  }

  .lookup-status[data-tone='error'] {
    border-color: var(--ember);
    color: var(--ember-dark);
  }

  .lookup-status[data-tone='success'] {
    border-color: var(--sage);
  }

  .lookup-results h3,
  .polling-section strong {
