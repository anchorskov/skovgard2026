    text-decoration: none;
  }

  .race-progress__next:hover,
  .race-progress__next:focus-visible {
    background: var(--ember-dark);
    border-color: var(--ember-dark);
  }

  .race-progress__next[hidden],
  .race-progress__jump[hidden] {
    display: none;
  }

  .race-progress__jump {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(220px, 1fr) auto;
    gap: 8px;
    align-items: center;
  }

  .race-progress__jump label {
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--rust);
  }

  .race-progress__jump select,
  .race-progress__jump button {
    min-height: 40px;
    border: 1px solid var(--charcoal);
    border-radius: 3px;
    font: inherit;
  }

  .race-progress__jump select {
    width: 100%;
    padding: 7px 10px;
    background: var(--bone);
    color: var(--charcoal);
  }

  .race-progress__jump button {
    padding: 7px 16px;
    background: var(--charcoal);
    color: var(--bone);
    font-weight: 800;
    cursor: pointer;
  }

  .race-footer a {
    font-weight: 700;
    color: var(--ember);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 620px) {
    .race-header {
      padding-top: 24px;
    }

    .candidate-grid {
      grid-template-columns: 1fr;
    }

    .race-progress {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .race-progress__jump {
      grid-template-columns: 1fr auto;
    }

    .race-progress__jump label {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { rankMapFromOrder, sortByRankMap } from '../../lib/race-order';
  import { validateSelectionWrite } from '../../lib/selection-limit';

  const STORAGE_KEY = 'wyoming-2026-my-candidate-list-v1';
  const AVAILABLE_RACES_STORAGE_KEY = 'wyoming-2026-my-available-races-v1';
  const choiceList = document.querySelector<HTMLElement>('#my-choice-list');
  const candidateGrid = document.querySelector<HTMLElement>('.candidate-grid');

  if (choiceList) {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choice-button]'));
    const itemsRoot = document.querySelector<HTMLElement>('#choice-list-items');
    const countRoot = document.querySelector<HTMLElement>('#choice-list-count');
    const summary = document.querySelector<HTMLElement>('#choice-list-summary');
    const actions = document.querySelector<HTMLElement>('#choice-list-actions');
    const status = document.querySelector<HTMLElement>('#choice-list-status');
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-choice-list');
    const emailLink = document.querySelector<HTMLAnchorElement>('#email-choice-list');
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-choice-list');
    const syncButton = document.querySelector<HTMLButtonElement>('#sync-list-remote');
    const syncForm = document.querySelector<HTMLFormElement>('#sync-list-form');
    const syncStatus = document.querySelector<HTMLElement>('#sync-list-status');
    const choiceListDetails = document.querySelector<HTMLDetailsElement>('#choice-list-details');
    const progressNote = document.querySelector<HTMLElement>('#race-progress-note');
    const nextRaceLink = document.querySelector<HTMLAnchorElement>('#next-race-link');
    const raceJump = document.querySelector<HTMLElement>('#race-progress-jump');
    const raceJumpSelect = document.querySelector<HTMLSelectElement>('#race-jump-select');
    const raceJumpButton = document.querySelector<HTMLButtonElement>('#race-jump-button');
    const seatsAvailable = Math.max(1, Number(choiceList.dataset.seatsAvailable || 1));
    const currentOfficeId = buttons[0]?.dataset.officeId || '';
    const selectionCount = document.querySelector<HTMLElement>('#race-selection-count');

    type Choice = {
      candidateId: string;
      candidateName: string;
      candidateParty: string;
      officeId: string;
      officeName: string;
    };

    type AvailableRace = {
      id: string;
      name: string;
      level?: string;
    };

    function loadChoices(): Choice[] {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((choice) => choice && choice.candidateId && choice.officeId);
      } catch {
        return [];
      }
    }

    // §11: enforce the limit at the actual persistence point, not just in the
    // UI that normally leads here — a single choke point that a devtools
    // edit, a future code path, or corrupted state can't bypass the way a
    // button-level guard alone could. Reject over-limit writes with a clear
    // error; never truncate silently. validateSelectionWrite is the same
    // function a future server/API write path would call, so both paths
    // enforce identically rather than duplicating the rule.
    function saveChoices(choices: Choice[]): boolean {
      const officeCount = choices.filter((choice) => choice.officeId === currentOfficeId).length;
      const contestLabel = buttons[0]?.dataset.officeName || 'this contest';
      const { valid, error } = validateSelectionWrite(officeCount, seatsAvailable, contestLabel);
      if (!valid) {
        setStatus(error || 'Could not save your selection — the limit was exceeded.');
        return false;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(choices));
      return true;
    }

    function loadAvailableRaces(): AvailableRace[] {
      try {
        const parsed = JSON.parse(localStorage.getItem(AVAILABLE_RACES_STORAGE_KEY) || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((race) => race && race.id && race.name);
      } catch {
        return [];
      }
    }

    function choiceFromButton(button: HTMLButtonElement): Choice {
      return {
        candidateId: button.dataset.candidateId || '',
        candidateName: button.dataset.candidateName || '',
        candidateParty: button.dataset.candidateParty || '',
        officeId: button.dataset.officeId || '',
        officeName: button.dataset.officeName || '',
      };
    }

    // The saved list is appended in pick order, which can jump around the
    // ballot (races can be reached via the jump-select or Browse races in any
    // sequence). loadAvailableRaces() already reflects the canonical ballot
    // order established on the homepage (see sortRaces in src/lib/race-order),
    // so project that same order onto the saved choices rather than deriving
    // a second ordering here — this keeps the list, "Jump to a race", and the
    // homepage ballot panel from ever drifting apart.
    function canonicalOrder(choices: Choice[]): Choice[] {
      const rank = rankMapFromOrder(loadAvailableRaces(), (race) => race.id);
      return sortByRankMap(choices, rank, (choice) => choice.officeId, (choice) => choice.officeName);
    }

    function formatChoices(choices: Choice[]) {
      const sorted = canonicalOrder(choices);
      return [
        'My Wyoming 2026 candidate choices',
        '',
        ...sorted.map((choice) =>
          `${choice.officeName}: ${choice.candidateName}${choice.candidateParty ? ` (${choice.candidateParty})` : ''}`
        ),
        '',
        'This is a personal planning list, not a cast ballot.',
      ].join('\n');
    }

    function setStatus(message: string) {
      if (status) status.textContent = message;
    }

    function renderRaceProgress(choices: Choice[]) {
      if (!progressNote || !nextRaceLink || !raceJump || !raceJumpSelect) return;
      const availableRaces = loadAvailableRaces();
      const otherRaces = availableRaces.filter((race) => race.id !== currentOfficeId);

      if (availableRaces.length === 0) {
        progressNote.textContent = 'Complete one ballot lookup to load the races available for your address.';
        nextRaceLink.href = '/#address-form-section';
        nextRaceLink.textContent = 'Find my races →';
        nextRaceLink.hidden = false;
        raceJump.hidden = true;
        return;
      }

      const decidedOfficeIds = new Set(choices.map((choice) => choice.officeId));
      const allUndecidedRaces = availableRaces.filter((race) => !decidedOfficeIds.has(race.id));
      const undecidedRaces = otherRaces.filter((race) => !decidedOfficeIds.has(race.id));
      const currentHasChoice = decidedOfficeIds.has(currentOfficeId);

      if (undecidedRaces.length > 0) {
        const nextRace = undecidedRaces[0];
        progressNote.textContent = `${allUndecidedRaces.length} ${allUndecidedRaces.length === 1 ? 'race still needs' : 'races still need'} a choice.`;
        nextRaceLink.href = `/race/${encodeURIComponent(nextRace.id)}`;
        nextRaceLink.textContent = `Next: ${nextRace.name} →`;
        nextRaceLink.hidden = false;
      } else {
        progressNote.textContent = currentHasChoice
          ? 'You have a choice recorded for every available race.'
          : 'This is the last race without a choice.';
        nextRaceLink.hidden = true;
      }

      raceJumpSelect.replaceChildren();
      for (const race of otherRaces) {
        const option = document.createElement('option');
        option.value = race.id;
        option.textContent = `${decidedOfficeIds.has(race.id) ? '✓ ' : ''}${race.name}`;
        raceJumpSelect.append(option);
      }
      raceJump.hidden = otherRaces.length === 0;
    }

    function render() {
      const choices = loadChoices();
      const selectedIds = new Set(choices.map((choice) => choice.candidateId));
      const officeChoiceCount = choices.filter((choice) => choice.officeId === currentOfficeId).length;
      const atMax = seatsAvailable > 1 && officeChoiceCount >= seatsAvailable;

      for (const button of buttons) {
        const selected = selectedIds.has(button.dataset.candidateId || '');
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
        button.textContent = selected ? '✓ My choice' : 'My choice';
        // §9: at the maximum, disable unselected options rather than letting a
        // click silently drop or replace an earlier choice. Already-selected
        // pills stay enabled so they can be deselected to free a slot.
        button.disabled = atMax && !selected;
      }

      if (selectionCount) {
        selectionCount.textContent = atMax
          ? `${officeChoiceCount} of ${seatsAvailable} selected — remove one to choose someone else.`
          : `${officeChoiceCount} of ${seatsAvailable} selected`;
      }

      if (countRoot) {
        countRoot.textContent = `${choices.length} ${choices.length === 1 ? 'choice' : 'choices'}`;
      }
      if (summary) {
        summary.textContent = choices.length === 0
          ? 'Review saved choices'
          : `${choices.length} ${choices.length === 1 ? 'choice' : 'choices'} — review list`;
      }
      if (actions) actions.hidden = choices.length === 0;

      if (emailLink) {
        const subject = encodeURIComponent('My Wyoming 2026 candidate choices');
        const body = encodeURIComponent(formatChoices(choices));
        emailLink.href = `mailto:?subject=${subject}&body=${body}`;
      }

      renderRaceProgress(choices);

      if (!itemsRoot) return;
      if (choices.length === 0) {
        itemsRoot.innerHTML = '<p class="choice-list__empty">Select “My choice” on any candidate card to start your list.</p>';
        return;
      }

      const list = document.createElement('ul');
      list.className = 'choice-list__items';
      // §9: multiple candidates for one contest group under a single office
      // heading, in ballot order. canonicalOrder() already keeps same-office
      // choices adjacent (they share one rank), so a linear scan is enough.
      for (const group of groupByOffice(canonicalOrder(choices))) {
        const item = document.createElement('li');
        item.className = 'choice-list__item';

        const office = document.createElement('span');
        office.className = 'choice-list__office';
        office.textContent = group.officeName;
        item.append(office);

        const candidateList = document.createElement('ul');
        candidateList.className = 'choice-list__candidates';
        for (const choice of group.choices) {
          const row = document.createElement('li');
          row.className = 'choice-list__candidate-row';

          const details = document.createElement('div');
          const candidate = document.createElement('span');
          candidate.className = 'choice-list__candidate';
          candidate.textContent = choice.candidateName;
          const party = document.createElement('span');
          party.className = 'choice-list__party';
          party.textContent = choice.candidateParty;
          details.append(candidate, party);

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'choice-list__remove';
          remove.dataset.removeChoice = choice.candidateId;
          remove.setAttribute('aria-label', `Remove ${choice.candidateName} from my list`);
          remove.textContent = 'Remove';

          row.append(details, remove);
          candidateList.append(row);
        }
        item.append(candidateList);
        list.append(item);
      }
      itemsRoot.replaceChildren(list);
    }

    function groupByOffice(orderedChoices: Choice[]): { officeId: string; officeName: string; choices: Choice[] }[] {
      const groups: { officeId: string; officeName: string; choices: Choice[] }[] = [];
      const byOffice = new Map<string, { officeId: string; officeName: string; choices: Choice[] }>();
      for (const choice of orderedChoices) {
        let group = byOffice.get(choice.officeId);
        if (!group) {
          group = { officeId: choice.officeId, officeName: choice.officeName, choices: [] };
          byOffice.set(choice.officeId, group);
          groups.push(group);
        }
        group.choices.push(choice);
      }
      return groups;
    }

    function clearInlineNextHints() {
      document.querySelectorAll('.candidate-card__next-hint').forEach((el) => el.remove());
    }

    // Surfaces "Next: <race> →" right on the card the user just selected, so
    // advancing never requires scrolling past the (unbounded-height) saved
    // list to reach the "Continue through your ballot" section.
    function showInlineNextHint(card: HTMLElement) {
      clearInlineNextHints();
      const availableRaces = loadAvailableRaces();
      const decidedOfficeIds = new Set(loadChoices().map((choice) => choice.officeId));
      const nextRace = availableRaces.find(
        (race) => race.id !== currentOfficeId && !decidedOfficeIds.has(race.id)
      );
      if (!nextRace) return;

      const hint = document.createElement('p');
      hint.className = 'candidate-card__next-hint';
      const link = document.createElement('a');
      link.href = `/race/${encodeURIComponent(nextRace.id)}`;
      link.textContent = `Next: ${nextRace.name} →`;
      hint.append('Saved. ', link);

      const links = card.querySelector('.candidate-card__links');
      if (links) links.before(hint);
      else card.append(hint);
    }

    function toggleChoice(button: HTMLButtonElement, card: HTMLElement | null) {
      // Single guard point regardless of entry path (pill click, whole-card
      // click delegation, or keyboard) — a disabled pill must never toggle.
      if (button.disabled) return;

      const clicked = choiceFromButton(button);
      let choices = loadChoices();
      const isSelected = choices.some((choice) => choice.candidateId === clicked.candidateId);
      let nowSelected = false;

      if (isSelected) {
        choices = choices.filter((choice) => choice.candidateId !== clicked.candidateId);
        setStatus(`${clicked.candidateName} removed from your list.`);
      } else {
        const officeChoices = choices.filter((choice) => choice.officeId === clicked.officeId);
        if (seatsAvailable === 1) {
          choices = choices.filter((choice) => choice.officeId !== clicked.officeId);
        } else if (officeChoices.length >= seatsAvailable) {
          setStatus(`You can select up to ${seatsAvailable} candidates for this office.`);
          return;
        }
        choices.push(clicked);
        setStatus(`${clicked.candidateName} added to your list.`);
        nowSelected = true;
      }

      // render() always refreshes from whatever is actually in localStorage,
      // so a rejected save (saveChoices returns false and never writes)
      // still leaves the UI showing the real, persisted state rather than
      // the attempted one.
      const saved = saveChoices(choices);
      render();

      if (saved && nowSelected && card) {
        showInlineNextHint(card);
      } else {
        clearInlineNextHints();
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        toggleChoice(button, button.closest<HTMLElement>('.candidate-card'));
      });
    }

    // Make the whole card a selection target (BUG 4a) — the pill stays the
    // visible affordance and the only element with real button semantics.
    // Links and the pill itself handle their own clicks, so any click that
    // targets one must not also toggle the card here.
    candidateGrid?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a, button')) return;
      const card = target.closest<HTMLElement>('.candidate-card');
      const button = card?.querySelector<HTMLButtonElement>('[data-choice-button]');
      if (card && button) toggleChoice(button, card);
    });

    itemsRoot?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const remove = target.closest<HTMLButtonElement>('[data-remove-choice]');
      if (!remove) return;
      const choices = loadChoices().filter((choice) => choice.candidateId !== remove.dataset.removeChoice);
      saveChoices(choices);
      setStatus('Choice removed from your list.');
      render();
    });

    copyButton?.addEventListener('click', async () => {
      const text = formatChoices(loadChoices());
      try {
        await navigator.clipboard.writeText(text);
        setStatus('Candidate list copied.');
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        setStatus(copied ? 'Candidate list copied.' : 'Copy failed. Please try again.');
      }
    });

    clearButton?.addEventListener('click', () => {
      saveChoices([]);
      setStatus('Candidate list cleared.');
      render();
    });

    raceJumpButton?.addEventListener('click', () => {
      const raceId = raceJumpSelect?.value;
      if (raceId) window.location.href = `/race/${encodeURIComponent(raceId)}`;
    });

    syncButton?.addEventListener('click', () => {
      if (syncForm) syncForm.hidden = !syncForm.hidden;
    });

    syncForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitButton = syncForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true;
      if (syncStatus) { syncStatus.textContent = ''; syncStatus.className = ''; }

      const email = (syncForm.querySelector<HTMLInputElement>('#sync-list-email'))?.value?.trim();
      const cfTurnstileResponse = window.turnstile
        ? window.turnstile.getResponse('#sync-ts-widget')
        : undefined;

      try {
        const res = await fetch('/api/ballot-recovery/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            availableRaces: loadAvailableRaces(),
            choices: loadChoices(),
            cf_turnstile_response: cfTurnstileResponse,
          }),
        });
        const data = await res.json();
        if (syncStatus) {
          syncStatus.textContent = data.message || 'Something went wrong.';
          syncStatus.className = data.success ? 'sync-list-status--ok' : 'sync-list-status--error';
        }
      } catch {
        if (syncStatus) {
          syncStatus.textContent = 'Network error — please try again.';
          syncStatus.className = 'sync-list-status--error';
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (window.turnstile) window.turnstile.reset('#sync-ts-widget');
      }
    });

    render();

    // Consume a ballot-recovery redemption: strip the marker so a refresh
    // doesn't re-show the message, and surface confirmation via the same
    // status line/details element the rest of this panel already uses.
    if (new URLSearchParams(location.search).get('restored') === '1') {
      setStatus('Your saved list was restored on this device.');
      if (choiceListDetails) choiceListDetails.open = true;
      history.replaceState(null, '', location.pathname);
    }
  }
</script>
