---
// Candidates/src/pages/race/[id].astro
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { isGuideEnabled } from '../../lib/guide-host';

const { id } = Astro.params;
const guideEnabled = isGuideEnabled(Astro.url.hostname);

const office = await env.WY_DB.prepare(
  'SELECT id, title, level, district, seats_available FROM offices WHERE id = ?1'
).bind(id).first();

if (!office) {
  return Astro.redirect('/races');
}

const { results: candidates } = await env.WY_DB.prepare(`
  SELECT id, slug, full_name, party, summary,
         website_url, photo_url, email, phone,
         facebook_url, instagram_url, twitter_url, campaign_finance_url, ballotpedia_url,
         incumbency_status, data_confidence
    FROM candidates
   WHERE office_id = ?1 AND withdrawn_at IS NULL
   ORDER BY CASE WHEN incumbency_status = 'Incumbent' THEN 0 ELSE 1 END, full_name
`).bind(id).all();

const officeName = office.district
  ? `${office.title} — District ${office.district}`
  : office.title;

const LEVEL_LABELS: Record<string, string> = {
  federal: 'Federal',
  statewide: 'Statewide',
  wy_senate: 'Wyoming Senate',
  wy_house: 'Wyoming House',
  county: 'County & Local',
  city: 'Municipal',
};

function partyBadgeClass(party: string | null): string {
  if (!party) return 'badge--party-other';
  const p = party.toUpperCase();
  if (p.startsWith('R')) return 'badge--party-r';
  if (p.startsWith('D')) return 'badge--party-d';
  if (p.startsWith('L')) return 'badge--party-l';
  return 'badge--party-other';
}

function partyLabel(party: string | null): string {
  if (!party) return 'No party';
  const map: Record<string, string> = {
    REP: 'Republican', R: 'Republican',
    DEM: 'Democrat', D: 'Democrat',
    LIB: 'Libertarian', L: 'Libertarian',
    IND: 'Independent', I: 'Independent',
    NP: 'No party',
  };
  return map[party.toUpperCase()] ?? party;
}

function isAbsoluteUrl(url: string | null): boolean {
  return typeof url === 'string' && (url.startsWith('http://') || url.startsWith('https://'));
}
---

<Base title={String(officeName)} currentPath={`/race/${id}`}>
  <div class="race-header">
    <a href="/races" class="back-link">← All races</a>
    <p class="eyebrow">{LEVEL_LABELS[String(office.level)] ?? String(office.level)}</p>
    <h1>{officeName}</h1>
    <p class="candidate-count">
      {candidates.length} filed {candidates.length === 1 ? 'candidate' : 'candidates'}
    </p>
  </div>

  {candidates.length === 0 ? (
    <p class="empty-note">No candidates on file for this race yet.</p>
  ) : (
    <ul class="candidate-grid" role="list">
      {candidates.map((c) => (
        <li class="candidate-card" data-candidate-card={String(c.id)}>
          <div class="candidate-card__header">
            <div class="candidate-card__badges">
              {String(c.incumbency_status).toLowerCase() === 'incumbent' ? <span class="badge badge--incumbent">Incumbent</span> : null}
              {c.party ? <span class={`badge ${partyBadgeClass(String(c.party))}`}>{partyLabel(String(c.party))}</span> : null}
            </div>
            <h2 class="candidate-card__name">{c.full_name}</h2>
          </div>

          {c.summary ? (
            <p class="candidate-card__summary">{c.summary}</p>
          ) : null}

          <button
            type="button"
            class="choice-pill"
            data-choice-button
            data-candidate-id={String(c.id)}
            data-candidate-name={String(c.full_name)}
            data-candidate-party={partyLabel(c.party ? String(c.party) : null)}
            data-office-id={String(office.id)}
            data-office-name={String(officeName)}
            aria-pressed="false"
          >
            My choice
          </button>

          <div class="candidate-card__links">
            {guideEnabled && c.slug ? (
              <a href={`/candidate/${String(c.slug)}`} class="cand-link cand-link--profile">Research profile</a>
            ) : null}
            {isAbsoluteUrl(String(c.website_url)) ? (
              <a href={String(c.website_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Website</a>
            ) : null}
            {isAbsoluteUrl(String(c.campaign_finance_url)) ? (
              <a href={String(c.campaign_finance_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Finance</a>
            ) : null}
            {isAbsoluteUrl(String(c.facebook_url)) ? (
              <a href={String(c.facebook_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Facebook</a>
            ) : null}
            {isAbsoluteUrl(String(c.instagram_url)) ? (
              <a href={String(c.instagram_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Instagram</a>
            ) : null}
            {isAbsoluteUrl(String(c.twitter_url)) ? (
              <a href={String(c.twitter_url)} target="_blank" rel="noopener noreferrer" class="cand-link cand-link--x">X / Twitter</a>
            ) : null}
            {isAbsoluteUrl(String(c.ballotpedia_url)) ? (
              <a href={String(c.ballotpedia_url)} target="_blank" rel="noopener noreferrer" class="cand-link cand-link--bp">Ballotpedia</a>
            ) : null}
            {c.email ? (
              <a href={`mailto:${String(c.email)}`} class="cand-link cand-link--contact">Email: {c.email}</a>
            ) : null}
            {c.phone ? (
              <a href={`tel:${String(c.phone).replace(/[^\d+]/g, '')}`} class="cand-link cand-link--contact">Phone: {c.phone}</a>
            ) : null}
          </div>
        </li>
      ))}
    </ul>
  )}

  {candidates.length > 0 && (
    <section
      class="choice-list"
      id="my-choice-list"
      data-seats-available={String(office.seats_available ?? 1)}
      aria-labelledby="choice-list-title"
    >
      <div class="choice-list__heading">
        <div>
          <p class="eyebrow">Optional planning tool</p>
          <h2 id="choice-list-title">My candidate list</h2>
        </div>
        <span class="choice-list__count" id="choice-list-count">0 choices</span>
      </div>
      <p class="choice-list__intro">
        Your choices stay in this browser. They are not votes and are not sent to us.
      </p>
      <div id="choice-list-items"></div>
      <div class="choice-list__actions" id="choice-list-actions" hidden>
        <button type="button" id="copy-choice-list">Copy list</button>
        <a id="email-choice-list" href="#">Email to myself</a>
        <button type="button" class="choice-list__clear" id="clear-choice-list">Clear list</button>
      </div>
      <p class="choice-list__status" id="choice-list-status" aria-live="polite"></p>
      <div class="race-progress" id="race-progress">
        <div>
          <p class="race-progress__label">Continue through your ballot</p>
          <p class="race-progress__note" id="race-progress-note"></p>
        </div>
        <a class="race-progress__next" id="next-race-link" href="/" hidden>Next undecided race →</a>
        <div class="race-progress__jump" id="race-progress-jump" hidden>
          <label for="race-jump-select">Jump to a race</label>
          <select id="race-jump-select"></select>
          <button type="button" id="race-jump-button">Go</button>
        </div>
      </div>
    </section>
  )}

  <div class="race-footer">
    <p>
      Data sourced from Wyoming Secretary of State filings and public research.
      <a href="/">Look up your ballot by address →</a>
    </p>
  </div>
</Base>

<style>
  .race-header {
    padding: 44px 0 32px;
    border-bottom: 2px solid var(--dust);
    margin-bottom: 36px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--rust);
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .back-link:hover {
    text-decoration-color: var(--rust);
  }

  h1 {
    margin: 4px 0 0;
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1;
  }

  .candidate-count {
    margin: 12px 0 0;
    font-size: 1rem;
    color: var(--rust);
    font-weight: 700;
  }

  .empty-note {
    padding: 32px;
    border: 1px solid var(--dust);
    color: var(--rust);
    text-align: center;
  }

  .candidate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .candidate-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px;
    border: 1px solid var(--dust);
    border-top: 4px solid var(--ember);
    background: var(--bone);
    box-shadow: 0 6px 0 var(--dust);
  }

  .candidate-card__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: 118px;
  }

  .candidate-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 22px;
  }

  .candidate-card__name {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.1;
  }

  .candidate-card__summary {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #444;
    flex: 1;
  }

  .choice-pill {
    position: absolute;
    top: 20px;
    right: 20px;
    min-height: 34px;
    padding: 6px 14px;
    border: 1.5px solid var(--ember);
    border-radius: 999px;
    background: transparent;
    color: var(--ember-dark);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
  }

  .choice-pill:hover,
  .choice-pill:focus-visible {
    background: var(--ember);
    color: var(--bone);
  }

  .choice-pill[aria-pressed="true"] {
    background: var(--ember);
    color: var(--bone);
  }

  .candidate-card:has(.choice-pill[aria-pressed="true"]) {
    border-color: var(--ember);
  }

  .candidate-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .cand-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border: 1.5px solid var(--charcoal);
    background: transparent;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--charcoal);
    border-radius: 3px;
  }

  .cand-link:hover,
  .cand-link:focus-visible {
    border-color: var(--ember);
    color: var(--ember);
  }

  .cand-link--bp {
    border-color: #3a7ebf;
    color: #3a7ebf;
  }

  .cand-link--bp:hover,
  .cand-link--bp:focus-visible {
    border-color: #1a5a9a;
    color: #1a5a9a;
  }

  .cand-link--contact {
    border-color: var(--sage);
    color: var(--sage);
  }

  .cand-link--contact:hover,
  .cand-link--contact:focus-visible {
    border-color: var(--charcoal);
    color: var(--charcoal);
  }

  .race-footer {
    margin-top: 52px;
    padding-top: 20px;
    border-top: 1px solid var(--dust);
    font-size: 0.9rem;
    color: var(--rust);
  }

  .choice-list {
    margin-top: 48px;
    padding: 24px;
    border: 1px solid var(--dust);
    border-top: 4px solid var(--sandstone);
    background: var(--bone);
  }

  .choice-list__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .choice-list__heading .eyebrow {
    margin: 0 0 4px;
  }

  .choice-list__heading h2 {
    margin: 0;
    font-size: 1.65rem;
  }

  .choice-list__count {
    flex: 0 0 auto;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--charcoal);
    color: var(--bone);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .choice-list__intro {
    margin: 10px 0 20px;
    color: var(--rust);
    line-height: 1.5;
  }

  :global(.choice-list__empty) {
    margin: 0;
    padding: 16px;
    border: 1px dashed var(--dust);
    color: var(--rust);
  }

  :global(.choice-list__items) {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.choice-list__item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: center;
    padding: 12px 14px;
    border-left: 4px solid var(--ember);
    background: color-mix(in srgb, var(--dust) 20%, var(--bone));
  }

  :global(.choice-list__office) {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--rust);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.choice-list__candidate) {
    display: block;
    margin-top: 2px;
    font-weight: 800;
  }

  :global(.choice-list__party) {
    font-size: 0.85rem;
    color: var(--rust);
  }

  :global(.choice-list__remove) {
    padding: 5px 8px;
    border: 1px solid var(--dust);
    background: transparent;
    color: var(--ember-dark);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .choice-list__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .choice-list__actions[hidden] {
    display: none;
  }

  .choice-list__actions button,
  .choice-list__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 7px 14px;
    border: 1px solid var(--charcoal);
    border-radius: 3px;
    background: var(--charcoal);
    color: var(--bone);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }

  .choice-list__actions button:hover,
  .choice-list__actions button:focus-visible,
  .choice-list__actions a:hover,
  .choice-list__actions a:focus-visible {
    border-color: var(--ember);
    background: var(--ember);
  }

  .choice-list__actions .choice-list__clear {
    background: transparent;
    color: var(--ember-dark);
    border-color: var(--ember-dark);
  }

  .choice-list__status {
    min-height: 1.3em;
    margin: 10px 0 0;
    color: var(--rust);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .race-progress {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px 24px;
    align-items: end;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--dust);
  }

  .race-progress__label {
    margin: 0;
    color: var(--charcoal);
    font-weight: 800;
  }

  .race-progress__note {
    margin: 3px 0 0;
    color: var(--rust);
    font-size: 0.88rem;
  }

  .race-progress__note a {
    color: var(--ember);
    font-weight: 800;
  }

  .race-progress__next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 8px 16px;
    border: 1px solid var(--ember);
    border-radius: 3px;
    background: var(--ember);
    color: var(--bone);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
  }

  .race-progress__next:hover,
  .race-progress__next:focus-visible {
    background: var(--ember-dark);
    border-color: var(--ember-dark);
  }

  .race-progress__next[hidden],
  .race-progress__jump[hidden] {
    display: none;
  }

  .race-progress__jump {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: auto minmax(220px, 1fr) auto;
    gap: 8px;
    align-items: center;
  }

  .race-progress__jump label {
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--rust);
  }

  .race-progress__jump select,
  .race-progress__jump button {
    min-height: 40px;
    border: 1px solid var(--charcoal);
    border-radius: 3px;
    font: inherit;
  }

  .race-progress__jump select {
    width: 100%;
    padding: 7px 10px;
    background: var(--bone);
    color: var(--charcoal);
  }

  .race-progress__jump button {
    padding: 7px 16px;
    background: var(--charcoal);
    color: var(--bone);
    font-weight: 800;
    cursor: pointer;
  }

  .race-footer a {
    font-weight: 700;
    color: var(--ember);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 620px) {
    .race-header {
      padding-top: 24px;
    }

    .candidate-grid {
      grid-template-columns: 1fr;
    }

    .race-progress {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .race-progress__jump {
      grid-template-columns: 1fr auto;
    }

    .race-progress__jump label {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'wyoming-2026-my-candidate-list-v1';
  const AVAILABLE_RACES_STORAGE_KEY = 'wyoming-2026-my-available-races-v1';
  const choiceList = document.querySelector<HTMLElement>('#my-choice-list');

  if (choiceList) {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choice-button]'));
    const itemsRoot = document.querySelector<HTMLElement>('#choice-list-items');
    const countRoot = document.querySelector<HTMLElement>('#choice-list-count');
    const actions = document.querySelector<HTMLElement>('#choice-list-actions');
    const status = document.querySelector<HTMLElement>('#choice-list-status');
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-choice-list');
    const emailLink = document.querySelector<HTMLAnchorElement>('#email-choice-list');
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-choice-list');
    const progressNote = document.querySelector<HTMLElement>('#race-progress-note');
    const nextRaceLink = document.querySelector<HTMLAnchorElement>('#next-race-link');
    const raceJump = document.querySelector<HTMLElement>('#race-progress-jump');
    const raceJumpSelect = document.querySelector<HTMLSelectElement>('#race-jump-select');
    const raceJumpButton = document.querySelector<HTMLButtonElement>('#race-jump-button');
    const seatsAvailable = Math.max(1, Number(choiceList.dataset.seatsAvailable || 1));
    const currentOfficeId = buttons[0]?.dataset.officeId || '';

    type Choice = {
      candidateId: string;
      candidateName: string;
      candidateParty: string;
      officeId: string;
      officeName: string;
    };

    type AvailableRace = {
      id: string;
      name: string;
      level?: string;
    };

    function loadChoices(): Choice[] {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((choice) => choice && choice.candidateId && choice.officeId);
      } catch {
        return [];
      }
    }

    function saveChoices(choices: Choice[]) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(choices));
    }

    function loadAvailableRaces(): AvailableRace[] {
      try {
        const parsed = JSON.parse(localStorage.getItem(AVAILABLE_RACES_STORAGE_KEY) || '[]');
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((race) => race && race.id && race.name);
      } catch {
        return [];
      }
    }

    function choiceFromButton(button: HTMLButtonElement): Choice {
      return {
        candidateId: button.dataset.candidateId || '',
        candidateName: button.dataset.candidateName || '',
        candidateParty: button.dataset.candidateParty || '',
        officeId: button.dataset.officeId || '',
        officeName: button.dataset.officeName || '',
      };
    }

    function formatChoices(choices: Choice[]) {
      const sorted = [...choices].sort((a, b) =>
        a.officeName.localeCompare(b.officeName) || a.candidateName.localeCompare(b.candidateName)
      );
      return [
        'My Wyoming 2026 candidate choices',
        '',
        ...sorted.map((choice) =>
          `${choice.officeName}: ${choice.candidateName}${choice.candidateParty ? ` (${choice.candidateParty})` : ''}`
        ),
        '',
        'This is a personal planning list, not a cast ballot.',
      ].join('\n');
    }

    function setStatus(message: string) {
      if (status) status.textContent = message;
    }

    function renderRaceProgress(choices: Choice[]) {
      if (!progressNote || !nextRaceLink || !raceJump || !raceJumpSelect) return;
      const availableRaces = loadAvailableRaces();
      const otherRaces = availableRaces.filter((race) => race.id !== currentOfficeId);

      if (availableRaces.length === 0) {
        progressNote.textContent = 'Complete one ballot lookup to load the races available for your address.';
        nextRaceLink.href = '/#address-form-section';
        nextRaceLink.textContent = 'Find my races →';
        nextRaceLink.hidden = false;
        raceJump.hidden = true;
        return;
      }

      const decidedOfficeIds = new Set(choices.map((choice) => choice.officeId));
      const allUndecidedRaces = availableRaces.filter((race) => !decidedOfficeIds.has(race.id));
      const undecidedRaces = otherRaces.filter((race) => !decidedOfficeIds.has(race.id));
      const currentHasChoice = decidedOfficeIds.has(currentOfficeId);

      if (undecidedRaces.length > 0) {
        const nextRace = undecidedRaces[0];
        progressNote.textContent = `${allUndecidedRaces.length} ${allUndecidedRaces.length === 1 ? 'race still needs' : 'races still need'} a choice.`;
        nextRaceLink.href = `/race/${encodeURIComponent(nextRace.id)}`;
        nextRaceLink.textContent = `Next: ${nextRace.name} →`;
        nextRaceLink.hidden = false;
      } else {
        progressNote.textContent = currentHasChoice
          ? 'You have a choice recorded for every available race.'
          : 'This is the last race without a choice.';
        nextRaceLink.hidden = true;
      }

      raceJumpSelect.replaceChildren();
      for (const race of otherRaces) {
        const option = document.createElement('option');
        option.value = race.id;
        option.textContent = `${decidedOfficeIds.has(race.id) ? '✓ ' : ''}${race.name}`;
        raceJumpSelect.append(option);
      }
      raceJump.hidden = otherRaces.length === 0;
    }

    function render() {
      const choices = loadChoices();
      const selectedIds = new Set(choices.map((choice) => choice.candidateId));

      for (const button of buttons) {
        const selected = selectedIds.has(button.dataset.candidateId || '');
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
        button.textContent = selected ? '✓ My choice' : 'My choice';
      }

      if (countRoot) {
        countRoot.textContent = `${choices.length} ${choices.length === 1 ? 'choice' : 'choices'}`;
      }
      if (actions) actions.hidden = choices.length === 0;

      if (emailLink) {
        const subject = encodeURIComponent('My Wyoming 2026 candidate choices');
        const body = encodeURIComponent(formatChoices(choices));
        emailLink.href = `mailto:?subject=${subject}&body=${body}`;
      }

      renderRaceProgress(choices);

      if (!itemsRoot) return;
      if (choices.length === 0) {
        itemsRoot.innerHTML = '<p class="choice-list__empty">Select “My choice” on any candidate card to start your list.</p>';
        return;
      }

      const list = document.createElement('ul');
      list.className = 'choice-list__items';
      for (const choice of choices) {
        const item = document.createElement('li');
        item.className = 'choice-list__item';

        const details = document.createElement('div');
        const office = document.createElement('span');
        office.className = 'choice-list__office';
        office.textContent = choice.officeName;
        const candidate = document.createElement('span');
        candidate.className = 'choice-list__candidate';
        candidate.textContent = choice.candidateName;
        const party = document.createElement('span');
        party.className = 'choice-list__party';
        party.textContent = choice.candidateParty;
        details.append(office, candidate, party);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'choice-list__remove';
        remove.dataset.removeChoice = choice.candidateId;
        remove.setAttribute('aria-label', `Remove ${choice.candidateName} from my list`);
        remove.textContent = 'Remove';
        item.append(details, remove);
        list.append(item);
      }
      itemsRoot.replaceChildren(list);
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const clicked = choiceFromButton(button);
        let choices = loadChoices();
        const isSelected = choices.some((choice) => choice.candidateId === clicked.candidateId);

        if (isSelected) {
          choices = choices.filter((choice) => choice.candidateId !== clicked.candidateId);
          setStatus(`${clicked.candidateName} removed from your list.`);
        } else {
          const officeChoices = choices.filter((choice) => choice.officeId === clicked.officeId);
          if (seatsAvailable === 1) {
            choices = choices.filter((choice) => choice.officeId !== clicked.officeId);
          } else if (officeChoices.length >= seatsAvailable) {
            setStatus(`You can select up to ${seatsAvailable} candidates for this office.`);
            return;
          }
          choices.push(clicked);
          setStatus(`${clicked.candidateName} added to your list.`);
        }

        saveChoices(choices);
        render();
      });
    }

    itemsRoot?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const remove = target.closest<HTMLButtonElement>('[data-remove-choice]');
      if (!remove) return;
      const choices = loadChoices().filter((choice) => choice.candidateId !== remove.dataset.removeChoice);
      saveChoices(choices);
      setStatus('Choice removed from your list.');
      render();
    });

    copyButton?.addEventListener('click', async () => {
      const text = formatChoices(loadChoices());
      try {
        await navigator.clipboard.writeText(text);
        setStatus('Candidate list copied.');
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        setStatus(copied ? 'Candidate list copied.' : 'Copy failed. Please try again.');
      }
    });

    clearButton?.addEventListener('click', () => {
      saveChoices([]);
      setStatus('Candidate list cleared.');
      render();
    });

    raceJumpButton?.addEventListener('click', () => {
      const raceId = raceJumpSelect?.value;
      if (raceId) window.location.href = `/race/${encodeURIComponent(raceId)}`;
    });

    render();
  }
</script>
