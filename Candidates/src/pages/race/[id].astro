  }

  .sync-list-form {
    margin-top: 14px;
    padding: 14px 16px;
    border: 1px solid var(--dust);
    border-left: 4px solid var(--sandstone);
    background: var(--bone);
  }

  .sync-list-form[hidden] {
    display: none;
  }

  .sync-list-form__intro {
    margin: 0 0 10px;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .sync-list-row {
    display: flex;
