  .sync-list-row button[type="submit"]:hover { background: #8b1a26; }
  .sync-list-row button[type="submit"]:disabled { opacity: 0.6; cursor: not-allowed; }

  #sync-list-status { margin: 10px 0 0; font-weight: 700; font-size: 0.85rem; }
  #sync-list-status.sync-list-status--ok { color: var(--sage); }
  #sync-list-status.sync-list-status--error { color: var(--ember); }

  .race-progress {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px 24px;
    align-items: end;
