  .race-progress__label {
    margin: 0;
    color: var(--charcoal);
    font-weight: 800;
  }

  .race-progress__note {
    margin: 3px 0 0;
    color: var(--rust);
    font-size: 0.88rem;
  }

  .race-progress__note a {
    color: var(--ember);
    font-weight: 800;
  }

  .race-progress__next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 8px 16px;
    border: 1px solid var(--ember);
    border-radius: 3px;
    background: var(--ember);
    color: var(--bone);
    font-size: 0.88rem;
