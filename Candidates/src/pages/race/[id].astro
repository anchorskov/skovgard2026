---
// Candidates/src/pages/race/[id].astro
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { isGuideEnabled } from '../../lib/guide-host';

const { id } = Astro.params;
const guideEnabled = isGuideEnabled(Astro.url.hostname);

const turnstileSiteKey = (env as any)?.TURNSTILE_SITE_KEY || '';
const isLocalReview = import.meta.env.DEV;
const turnstileEnabled = Boolean(turnstileSiteKey && !isLocalReview);

const office = await env.WY_DB.prepare(
  'SELECT id, title, level, district, county, seats_available FROM offices WHERE id = ?1'
).bind(id).first();

if (!office) {
  return Astro.redirect('/races');
}

// 2026 results, matched structurally against election_contests. office_id
// there is unpopulated until a real candidate/office matching pass runs,
// so this is a Phase 1 runtime match, not a stored FK join.
//
// level + district + county alone is NOT sufficient to disambiguate every
// office shape, confirmed by a real QA test, not assumed: Wyoming's
// federal offices (US Senate, US House) and statewide offices (Governor,
// Secretary of State, etc.) all share level='federal'/'statewide' with
// district=NULL and county=NULL, so that trio alone matched candidates
// from multiple different offices into one contest. The same collision
// applies to county offices sharing one county (Commissioner, Assessor,
// Clerk, ...) with no other office in that county to disambiguate against.
// Fixed with a level-dependent third condition:
//   - wy_senate/wy_house: district alone is already unique, no title
//     check needed (two different districts always have different
//     numbers).
//   - federal/statewide: contest_name_normalized must equal office.title
//     exactly (both literally say "United States Senator", "Governor",
//     etc. in both this table and the ingestion pipelines).
//   - county/city: office.title includes the county name as a prefix
//     ("Natrona County Commissioner") while contest_name_normalized does
//     not ("County Commissioner"), so this is a suffix match, not
//     equality.
const { results: matchedContests } = await env.WY_DB.prepare(
  `SELECT ec.id AS contest_id
     FROM election_contests ec
     JOIN election_events ee ON ee.id = ec.election_id
    WHERE ee.election_key = 'wy-2026-primary'
      AND ec.level = ?1
      AND (ec.district = ?2 OR (ec.district IS NULL AND ?2 IS NULL))
      AND (ec.county = ?3 OR (ec.county IS NULL AND ?3 IS NULL))
      AND (
        ec.level IN ('wy_senate', 'wy_house')
        OR ec.contest_name_normalized = ?4
        OR (ec.level IN ('county', 'city') AND ?4 LIKE '%' || ec.contest_name_normalized)
      )`
).bind(office.level, office.district ?? null, office.county ?? null, office.title).all();

type CandidateResult = { votes: number; pct: number; isLeading: boolean; isUnofficial: boolean };
const resultsByName = new Map<string, CandidateResult>();

if (matchedContests.length > 0) {
  const contestIds = matchedContests.map((c) => c.contest_id);
  const placeholders = contestIds.map((_, i) => `?${i + 1}`).join(', ');
  const { results: rows } = await env.WY_DB.prepare(
    `SELECT contest_id, candidate_name_raw, SUM(votes) AS votes, MAX(is_unofficial) AS is_unofficial
       FROM v_election_current_results
      WHERE contest_id IN (${placeholders})
        AND row_type = 'candidate'
        AND precinct_code IS NULL
      GROUP BY contest_id, candidate_name_raw`
  ).bind(...contestIds).all();

  const byContest = new Map<number, { name: string; votes: number; isUnofficial: boolean }[]>();
  for (const r of rows as any[]) {
    const list = byContest.get(r.contest_id) || [];
    list.push({ name: String(r.candidate_name_raw), votes: Number(r.votes), isUnofficial: Boolean(r.is_unofficial) });
    byContest.set(r.contest_id, list);
  }

  for (const [, candidatesInContest] of byContest) {
    const total = candidatesInContest.reduce((sum, c) => sum + c.votes, 0);
    const maxVotes = Math.max(...candidatesInContest.map((c) => c.votes));
    for (const c of candidatesInContest) {
      resultsByName.set(c.name.trim().toUpperCase(), {
        votes: c.votes,
        pct: total > 0 ? (c.votes / total) * 100 : 0,
        isLeading: c.votes === maxVotes && candidatesInContest.length > 1,
        isUnofficial: c.isUnofficial,
      });
    }
  }
}

const seatsAvailable = Math.max(1, Number(office.seats_available ?? 1));

// §9 UI contract: a verified verbatim ballot instruction must be shown as-is
// instead of a generated "Select up to N" string. offices.seats_available is
// the resolved numeric cap only — the instruction text itself lives in
// multi_seat_race_sources (see docs/multi_selection.md §10/Step B), reached
// here by office_id. Only queried when it could matter (seats_available > 1)
// — single-choice races render no limit text either way (§9 table).
let instructionText: string | null = null;
if (seatsAvailable > 1) {
  const instructionRow = await env.WY_DB.prepare(
    `SELECT ui_instruction FROM multi_seat_race_sources
      WHERE office_id = ?1 AND source_status = 'verified'
        AND ui_instruction IS NOT NULL AND TRIM(ui_instruction) != ''
      LIMIT 1`
  ).bind(id).first();
  instructionText = instructionRow?.ui_instruction ? String(instructionRow.ui_instruction).trim() : null;
}

const { results: candidates } = await env.WY_DB.prepare(`
  SELECT id, slug, full_name, party, summary,
         website_url, photo_url, email, phone,
         facebook_url, instagram_url, twitter_url, campaign_finance_url, ballotpedia_url,
         incumbency_status, data_confidence
    FROM candidates
   WHERE office_id = ?1 AND withdrawn_at IS NULL
   ORDER BY CASE WHEN incumbency_status = 'Incumbent' THEN 0 ELSE 1 END, full_name
`).bind(id).all();

const officeName = office.district
  ? `${office.title} — District ${office.district}`
  : office.title;

const LEVEL_LABELS: Record<string, string> = {
  federal: 'Federal',
  statewide: 'Statewide',
  wy_senate: 'Wyoming Senate',
  wy_house: 'Wyoming House',
  county: 'County & Local',
  city: 'Municipal',
};

function partyBadgeClass(party: string | null): string {
  if (!party) return 'badge--party-other';
  const p = party.toUpperCase();
  if (p.startsWith('R')) return 'badge--party-r';
  if (p.startsWith('D')) return 'badge--party-d';
  if (p.startsWith('L')) return 'badge--party-l';
  return 'badge--party-other';
}

function partyLabel(party: string | null): string {
  if (!party) return 'No party';
  const map: Record<string, string> = {
    REP: 'Republican', R: 'Republican',
    DEM: 'Democrat', D: 'Democrat',
    LIB: 'Libertarian', L: 'Libertarian',
    IND: 'Independent', I: 'Independent',
    NP: 'No party',
  };
  return map[party.toUpperCase()] ?? party;
}

function isAbsoluteUrl(url: string | null): boolean {
  return typeof url === 'string' && (url.startsWith('http://') || url.startsWith('https://'));
}
---

<Base title={String(officeName)} currentPath={`/race/${id}`}>
  <div class="race-header">
    <a href="/races" class="back-link">← All races</a>
    <p class="eyebrow">{LEVEL_LABELS[String(office.level)] ?? String(office.level)}</p>
    <h1>{officeName}</h1>
    <p class="candidate-count">
      {candidates.length} filed {candidates.length === 1 ? 'candidate' : 'candidates'}
    </p>
    {seatsAvailable > 1 && (
      <div
        class="race-selection-status"
        id="race-selection-status"
        role="status"
        aria-live="polite"
      >
        <p class="race-selection-status__instruction" id="race-selection-instruction">
          {instructionText || `Select up to ${seatsAvailable} candidates.`}
        </p>
        <p class="race-selection-status__count" id="race-selection-count">
          0 of {seatsAvailable} selected
        </p>
      </div>
    )}
  </div>

  {candidates.length === 0 ? (
    <p class="empty-note">No candidates on file for this race yet.</p>
  ) : (
    <ul class="candidate-grid" role="list">
      {candidates.map((c) => {
        const result = resultsByName.get(String(c.full_name).trim().toUpperCase());
        return (
        <li class={`candidate-card${result?.isLeading ? ' candidate-card--leading' : ''}`} data-candidate-card={String(c.id)} data-voice-item>
          <div class="candidate-card__header">
            <div class="candidate-card__badges">
              {String(c.incumbency_status).toLowerCase() === 'incumbent' ? <span class="badge badge--incumbent">Incumbent</span> : null}
              {c.party ? <span class={`badge ${partyBadgeClass(String(c.party))}`}>{partyLabel(String(c.party))}</span> : null}
              {result?.isLeading ? <span class="badge badge--leading">Leading</span> : null}
            </div>
            <h3 class="candidate-card__name">{c.full_name}</h3>
          </div>

          {result ? (
            <p class="candidate-card__results">
              {result.votes.toLocaleString()} votes, {result.pct.toFixed(1)}%
              <span class="candidate-card__results-label">{result.isUnofficial ? 'Unofficial' : 'Certified'}</span>
            </p>
          ) : null}

          {c.summary ? (
            <p class="candidate-card__summary">{c.summary}</p>
          ) : null}

          <button
            type="button"
            class="choice-pill"
            data-choice-button
            data-candidate-id={String(c.id)}
            data-candidate-name={String(c.full_name)}
            data-candidate-party={partyLabel(c.party ? String(c.party) : null)}
            data-office-id={String(office.id)}
            data-office-name={String(officeName)}
            aria-pressed="false"
          >
            My choice
          </button>

          <div class="candidate-card__links">
            {guideEnabled && c.slug ? (
              <a href={`/candidate/${String(c.slug)}`} class="cand-link cand-link--profile">Research profile</a>
            ) : null}
            {isAbsoluteUrl(String(c.website_url)) ? (
              <a href={String(c.website_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Website</a>
            ) : null}
            {isAbsoluteUrl(String(c.campaign_finance_url)) ? (
              <a href={String(c.campaign_finance_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Finance</a>
            ) : null}
            {isAbsoluteUrl(String(c.facebook_url)) ? (
              <a href={String(c.facebook_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Facebook</a>
            ) : null}
            {isAbsoluteUrl(String(c.instagram_url)) ? (
              <a href={String(c.instagram_url)} target="_blank" rel="noopener noreferrer" class="cand-link">Instagram</a>
            ) : null}
            {isAbsoluteUrl(String(c.twitter_url)) ? (
              <a href={String(c.twitter_url)} target="_blank" rel="noopener noreferrer" class="cand-link cand-link--x">X / Twitter</a>
            ) : null}
            {isAbsoluteUrl(String(c.ballotpedia_url)) ? (
              <a href={String(c.ballotpedia_url)} target="_blank" rel="noopener noreferrer" class="cand-link cand-link--bp">Ballotpedia</a>
            ) : null}
            {c.email ? (
              <a href={`mailto:${String(c.email)}`} class="cand-link cand-link--contact">Email: {c.email}</a>
            ) : null}
            {c.phone ? (
              <a href={`tel:${String(c.phone).replace(/[^\d+]/g, '')}`} class="cand-link cand-link--contact">Phone: {c.phone}</a>
            ) : null}
          </div>
        </li>
        );
      })}
    </ul>
  )}

  {candidates.length > 0 && (
    <section class="race-progress-section" id="race-progress-section" aria-labelledby="race-progress-label">
      <div class="race-progress" id="race-progress">
        <div>
          <p class="race-progress__label" id="race-progress-label">Continue through your ballot</p>
          <p class="race-progress__note" id="race-progress-note"></p>
        </div>
        <a class="race-progress__next" id="next-race-link" href="/" hidden>Next undecided race →</a>
        <div class="race-progress__jump" id="race-progress-jump" hidden>
          <label for="race-jump-select">Jump to a race</label>
          <select id="race-jump-select"></select>
          <button type="button" id="race-jump-button">Go</button>
        </div>
      </div>
    </section>
  )}

  {candidates.length > 0 && (
    <section
      class="choice-list"
      id="my-choice-list"
      data-seats-available={String(seatsAvailable)}
      aria-labelledby="choice-list-title"
    >
      <div class="choice-list__heading">
        <div>
          <p class="eyebrow">Optional planning tool</p>
          <h2 id="choice-list-title">My candidate list</h2>
        </div>
        <span class="choice-list__count" id="choice-list-count">0 choices</span>
      </div>
      <p class="choice-list__intro">
        Your choices stay in this browser unless you choose to email yourself a device-sync link below.
        They are not votes. Saving again later — after you change a pick — updates the same saved list
        under that email; it doesn't create a second copy.
      </p>
      <details class="choice-list__details" id="choice-list-details">
        <summary class="choice-list__summary" id="choice-list-summary">Review saved choices</summary>
        <div id="choice-list-items"></div>
        <div class="choice-list__actions" id="choice-list-actions" hidden>
          <button type="button" id="copy-choice-list">Copy list</button>
          <a id="email-choice-list" href="#">Email to myself</a>
          <button type="button" id="sync-list-remote">Sync to another device</button>
          <button type="button" class="choice-list__clear" id="clear-choice-list">Clear list</button>
        </div>
        <form id="sync-list-form" class="sync-list-form" hidden>
          <label for="sync-list-email" class="sr-only">Email address to send the recovery link to</label>
          <p class="sync-list-form__intro">
            Email yourself a link to restore this saved list on another device. The link expires in 24
            hours, but your saved list itself stays available — if you forget or lose that link, use
            <a href="/ballot-recovery/">Recover my ballot</a> with the same email any time before the
            election.
          </p>
          <div class="sync-list-row">
            <input id="sync-list-email" name="email" type="email" placeholder="you@example.com" required />
            <button type="submit">Send my link</button>
          </div>
          {turnstileEnabled && (
            <div
              id="sync-ts-widget"
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-size="normal"
              data-appearance="interaction-only"
            ></div>
          )}
          <p id="sync-list-status" role="status"></p>
        </form>
      </details>
      <p class="choice-list__status" id="choice-list-status" aria-live="polite"></p>
    </section>
  )}

  <div class="race-footer">
    <p>
      Data sourced from Wyoming Secretary of State filings and public research.
      <a href="/">Look up your ballot by address →</a>
    </p>
  </div>
</Base>

{turnstileEnabled && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .race-header {
    padding: 44px 0 32px;
    border-bottom: 2px solid var(--dust);
    margin-bottom: 36px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--rust);
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .back-link:hover {
    text-decoration-color: var(--rust);
  }

  h1 {
    margin: 4px 0 0;
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1;
  }

  .candidate-count {
    margin: 12px 0 0;
    font-size: 1rem;
    color: var(--rust);
    font-weight: 700;
  }

  .race-selection-status {
    margin: 14px 0 0;
    padding: 12px 16px;
    border: 1.5px solid var(--sandstone);
    border-left: 4px solid var(--sandstone);
    background: color-mix(in srgb, var(--sandstone) 8%, var(--bone));
  }

  .race-selection-status__instruction {
    margin: 0;
    color: var(--charcoal);
    font-weight: 800;
  }

  .race-selection-status__count {
    margin: 4px 0 0;
    color: var(--rust);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .empty-note {
    padding: 32px;
    border: 1px solid var(--dust);
    color: var(--rust);
    text-align: center;
  }

  .candidate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .candidate-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px;
    border: 1px solid var(--dust);
    border-top: 4px solid var(--ember);
    background: var(--bone);
    box-shadow: 0 6px 0 var(--dust);
    cursor: pointer;
  }

  .candidate-card__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: 132px;
  }

  .candidate-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 22px;
  }

  .candidate-card__name {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.1;
  }

  .candidate-card__summary {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #444;
    flex: 1;
  }

  .choice-pill {
    position: absolute;
    top: 16px;
    right: 16px;
    min-height: 44px;
    padding: 10px 22px;
    border: 1.5px solid var(--ember);
    border-radius: 999px;
    background: transparent;
    color: var(--ember-dark);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
  }

  .choice-pill:hover {
    background: var(--ember);
    color: var(--bone);
  }

  .choice-pill:focus-visible {
    background: var(--ember);
    color: var(--bone);
    outline: 3px solid var(--charcoal);
    outline-offset: 2px;
  }

  .choice-pill[aria-pressed="true"] {
    background: var(--ember);
    color: var(--bone);
  }

  /* At the selection limit: unselected pills disable rather than silently
     drop or replace an earlier choice (§9). Comes after :hover/:focus-visible
     so it wins the cascade even when a disabled pill is still under the
     pointer. */
  .choice-pill:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    background: transparent;
    border-color: var(--dust);
    color: var(--rust);
  }

  .choice-pill:disabled:hover {
    background: transparent;
    color: var(--rust);
  }

  .candidate-card:has(.choice-pill[aria-pressed="true"]) {
    border-color: var(--ember);
    background: color-mix(in srgb, var(--ember) 7%, var(--bone));
    box-shadow: 0 6px 0 var(--ember-dark);
  }

  /* Winner/leading highlight, sage per brand-lock (no true green in
     brand/palette.json, see palette "new-colors" rule). Kept as a
     border + tinted background, not a full-color fill, so it stays a
     highlight rather than overriding the party-accent top border. */
  .candidate-card--leading {
    border-color: var(--sage);
    background: color-mix(in srgb, var(--sage) 12%, var(--bone));
    box-shadow: 0 6px 0 var(--sage);
  }

  .candidate-card__results {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--charcoal);
  }

  .candidate-card__results-label {
    padding: 1px 7px;
    border-radius: 3px;
    background: var(--dust);
    color: var(--charcoal);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  :global(.candidate-card__next-hint) {
    margin: 0;
    padding: 8px 10px;
    border-left: 3px solid var(--ember);
    background: color-mix(in srgb, var(--ember) 10%, var(--bone));
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--charcoal);
  }

  :global(.candidate-card__next-hint a) {
    font-weight: 800;
    color: var(--ember-dark);
  }

  .candidate-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 4px;
  }

  .cand-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border: 1.5px solid var(--charcoal);
    background: transparent;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--charcoal);
    border-radius: 3px;
  }

  .cand-link:hover,
  .cand-link:focus-visible {
    border-color: var(--ember);
    color: var(--ember);
  }

  .cand-link--bp {
    border-color: #3a7ebf;
    color: #3a7ebf;
  }

  .cand-link--bp:hover,
  .cand-link--bp:focus-visible {
    border-color: #1a5a9a;
    color: #1a5a9a;
  }

  .cand-link--contact {
    border-color: var(--sage);
    color: var(--sage);
  }

  .cand-link--contact:hover,
  .cand-link--contact:focus-visible {
    border-color: var(--charcoal);
    color: var(--charcoal);
  }

  .race-footer {
    margin-top: 52px;
    padding-top: 20px;
    border-top: 1px solid var(--dust);
    font-size: 0.9rem;
    color: var(--rust);
  }

  .race-progress-section {
    margin-top: 48px;
    padding: 24px;
    border: 1px solid var(--dust);
    border-top: 4px solid var(--ember);
    background: var(--bone);
  }

  .choice-list {
    margin-top: 24px;
    padding: 24px;
    border: 1px solid var(--dust);
    border-top: 4px solid var(--sandstone);
    background: var(--bone);
  }

  .choice-list__details {
    margin-top: 16px;
  }

  .choice-list__summary {
    cursor: pointer;
    padding: 10px 4px;
    color: var(--charcoal);
    font-weight: 800;
    list-style-position: outside;
  }

  .choice-list__summary:hover,
  .choice-list__summary:focus-visible {
    color: var(--ember);
  }

  .choice-list__details[open] .choice-list__summary {
    margin-bottom: 6px;
  }

  .choice-list__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .choice-list__heading .eyebrow {
    margin: 0 0 4px;
  }

  .choice-list__heading h2 {
    margin: 0;
    font-size: 1.65rem;
  }

  .choice-list__count {
    flex: 0 0 auto;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--charcoal);
    color: var(--bone);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .choice-list__intro {
    margin: 10px 0 20px;
    color: var(--rust);
    line-height: 1.5;
  }

  :global(.choice-list__empty) {
    margin: 0;
    padding: 16px;
    border: 1px dashed var(--dust);
    color: var(--rust);
  }

  :global(.choice-list__items) {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One .choice-list__item per OFFICE, not per candidate — §9 requires
     multiple candidates for one contest to group under a single office
     heading rather than repeating it once per pick. */
  :global(.choice-list__item) {
    padding: 12px 14px;
    border-left: 4px solid var(--ember);
