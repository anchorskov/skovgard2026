---
// Candidates/src/pages/races/index.astro
import Base from '../../layouts/Base.astro';
import { env } from 'cloudflare:workers';

const STATE_LEVEL_ORDER = ['federal', 'statewide', 'wy_senate', 'wy_house'];
const STATE_LEVEL_LABELS: Record<string, string> = {
  federal: 'Federal',
  statewide: 'Statewide',
  wy_senate: 'Wyoming Senate',
  wy_house: 'Wyoming House',
};

type RaceRow = {
  id: number;
  title: string;
  level: string;
  district: string | null;
  county: string | null;
  sort_order: number;
  candidate_count: number;
};

let stateGroups: Record<string, RaceRow[]> = {};
let countyGroups: Record<string, { county: RaceRow[]; city: RaceRow[] }> = {};
let dbError = false;
let totalRaces = 0;

type LeadingResult = { name: string; pct: number; party: string | null; partyShortLabel: string | null };
// Structural match against election_contests, same rule as race/[id].astro
// (see that file's card-scoped resolution comment for the full rationale):
// wy_senate/wy_house disambiguated by district alone; federal/statewide by
// exact title match; county/city by matching candidate names against each
// contest's own roster instead of a title match, since office.title carries
// the county name prefix in at least three different conventions across
// counties that contest_name_normalized never shares. Computed once for all
// offices here rather than per-office, to avoid one query per race on a page
// listing hundreds.
const leadingByOffice = new Map<number, LeadingResult[]>();

// Same election_key this page's own results query already hardcodes below
// (and race/[id].astro's does too). An is_active_cycle flag on
// election_events would let this generalize to future cycles without a
// code change, but that's a real follow-up, not needed to ship this banner.
let pollsCloseAt: Date | null = null;
if (env.WY_DB) {
  const cycle = await env.WY_DB.prepare(
    `SELECT polls_close_at FROM election_events WHERE election_key = 'wy-2026-primary'`
  ).first<{ polls_close_at: string }>();
  if (cycle?.polls_close_at) pollsCloseAt = new Date(cycle.polls_close_at);
}
const pollsHaveClosed = pollsCloseAt ? new Date() >= pollsCloseAt : false;

if (env.WY_DB) {
  try {
    const { results } = await env.WY_DB.prepare(`
      SELECT o.id, o.title, o.level, o.district, o.county, o.sort_order,
             COUNT(c.id) AS candidate_count
        FROM offices o
        LEFT JOIN candidates c ON c.office_id = o.id AND c.withdrawn_at IS NULL
       GROUP BY o.id
       ORDER BY o.county NULLS FIRST, o.level, o.sort_order, o.title
    `).all();

    for (const row of results as RaceRow[]) {
      totalRaces++;
      if (row.county) {
        if (!countyGroups[row.county]) countyGroups[row.county] = { county: [], city: [] };
        if (row.level === 'city') {
          countyGroups[row.county].city.push(row);
        } else {
          countyGroups[row.county].county.push(row);
        }
      } else {
        const key = row.level;
        if (!stateGroups[key]) stateGroups[key] = [];
        stateGroups[key].push(row);
      }
    }

    const { results: contestRows } = await env.WY_DB.prepare(`
      SELECT ec.id AS contest_id, ec.level, ec.district, ec.county, ec.contest_name_normalized, ec.ballot_party,
             p.short_label AS party_short_label,
             vcr.candidate_name_raw, SUM(vcr.votes) AS votes
        FROM election_contests ec
        JOIN election_events ee ON ee.id = ec.election_id
        JOIN v_election_current_results vcr ON vcr.contest_id = ec.id
        LEFT JOIN party_aliases pa ON pa.raw_value = ec.ballot_party
        LEFT JOIN parties p ON p.code = pa.party_code
       WHERE ee.election_key = 'wy-2026-primary'
         AND vcr.row_type = 'candidate'
         AND vcr.precinct_code IS NULL
       GROUP BY ec.id, vcr.candidate_name_raw
    `).all();

    // Card-scoped resolution's roster half (docs/current_status_candidates_page.md
    // §3; full rationale and the residual same-name-collision case are
    // documented in race/[id].astro, which resolves this per-card instead of
    // in bulk). Scoped to (county, party) rather than county alone so a
    // Republican and a Democratic candidate who happen to share a name in
    // the same county never collide.
    const { results: rosterRows } = await env.WY_DB.prepare(`
      SELECT c.office_id, c.full_name, o.county,
             p.code AS party_code
        FROM candidates c
        JOIN offices o ON o.id = c.office_id
        LEFT JOIN party_aliases pa ON pa.raw_value = c.party
        LEFT JOIN parties p ON p.code = pa.party_code
       WHERE c.withdrawn_at IS NULL AND o.level IN ('county', 'city')
    `).all();

    function normalizeName(s: string): string {
      // See race/[id].astro's normalizeName comment: periods are
      // inconsistent between sources for the same person and must be
      // stripped, confirmed on real 2026 Sublette data during testing.
      return s.trim().toUpperCase().replace(/\./g, '').replace(/\s+/g, ' ');
    }

    // See race/[id].astro's partyKey comment: candidates.party normalizes
    // to the literal code 'NP' for nonpartisan municipal races, but
    // election_contests.ballot_party is NULL for the same races. Folding
    // both into '' is required for any city race to resolve at all.
    function partyKey(raw: string | null | undefined): string {
      const v = String(raw || '').toUpperCase();
      return v === 'NP' ? '' : v;
    }

    type RosterRow = { office_id: number; full_name: string; county: string | null; party_code: string | null };
    const officeByCountyPartyName = new Map<string, Map<string, number>>();
    for (const r of rosterRows as RosterRow[]) {
      const key = `${r.county || ''}|${partyKey(r.party_code)}`;
      let names = officeByCountyPartyName.get(key);
      if (!names) {
        names = new Map();
        officeByCountyPartyName.set(key, names);
      }
      const norm = normalizeName(r.full_name);
      if (!names.has(norm)) names.set(norm, r.office_id);
    }

    type ContestRow = { contest_id: number; level: string; district: number | null; county: string | null; contest_name_normalized: string; ballot_party: string | null; party_short_label: string | null; candidate_name_raw: string; votes: number };
    // Merged by normalized name within each contest, same fix as
    // race/[id].astro's byContest: different sources track case
    // differently, and picking a "top" candidate without merging first
    // can pick the wrong winner (or the wrong pct) whenever a real
    // candidate's votes are split across two differently-cased rows.
    const byContest = new Map<number, { level: string; district: number | null; county: string | null; name: string; party: string | null; partyShortLabel: string | null; candidates: Map<string, { name: string; votes: number }> }>();
    for (const r of contestRows as ContestRow[]) {
      let entry = byContest.get(r.contest_id);
      if (!entry) {
        entry = { level: r.level, district: r.district, county: r.county, name: r.contest_name_normalized, party: r.ballot_party, partyShortLabel: r.party_short_label, candidates: new Map() };
        byContest.set(r.contest_id, entry);
      }
      const rawName = String(r.candidate_name_raw);
      const key = normalizeName(rawName);
      const existing = entry.candidates.get(key);
      const preferNewDisplay = !existing || (existing.name === existing.name.toUpperCase() && rawName !== rawName.toUpperCase());
      entry.candidates.set(key, {
        name: preferNewDisplay ? rawName : existing!.name,
        votes: (existing?.votes || 0) + Number(r.votes),
      });
    }

    // A primary has one contest PER PARTY for the same office. US Senate
    // REP and US Senate DEM are different contests that never compete head
    // to head, so an office can have more than one "leading" result (one
    // per party). Confirmed as a real bug during QA, not hypothetical: an
    // earlier single-result-per-office version let the DEM contest's
    // leader silently overwrite the REP contest's leader for the same key.
    const leadingByDistrict = new Map<string, LeadingResult[]>(); // wy_senate/wy_house: "level|district"
    const leadingByTitle = new Map<string, LeadingResult[]>();    // federal/statewide: "level|title"
    const leadingByOfficeId = new Map<number, LeadingResult[]>(); // county/city: office id

    function pushTo<K>(map: Map<K, LeadingResult[]>, key: K, value: LeadingResult) {
      const list = map.get(key) || [];
      list.push(value);
      map.set(key, list);
    }

    for (const { level, district, county, name, party, partyShortLabel, candidates: candidatesByName } of byContest.values()) {
      const candidates = [...candidatesByName.values()];
      if (candidates.length === 0) continue;
      const total = candidates.reduce((sum, c) => sum + c.votes, 0);
      const top = candidates.reduce((a, b) => (b.votes > a.votes ? b : a));
      const leading: LeadingResult = { name: top.name, pct: total > 0 ? (top.votes / total) * 100 : 0, party, partyShortLabel };

      if (level === 'wy_senate' || level === 'wy_house') {
        pushTo(leadingByDistrict, `${level}|${district}`, leading);
      } else if (level === 'county' || level === 'city') {
        if (!county) continue;
        const roster = officeByCountyPartyName.get(`${county}|${partyKey(party)}`);
        if (!roster) continue;
        // Majority name-overlap identifies which office this contest
        // belongs to. A coincidental single-name collision with an
        // unrelated contest loses to the real one whenever the race has
        // more than one candidate; see race/[id].astro for the full
        // rationale and the same residual single-candidate edge case.
        const officeHits = new Map<number, number>();
        for (const c of candidates) {
          if (!c.name) continue; // a handful of legacy result rows carry no name
          const officeId = roster.get(normalizeName(c.name));
          if (officeId != null) officeHits.set(officeId, (officeHits.get(officeId) || 0) + 1);
        }
        let bestOfficeId: number | null = null;
        let bestScore = 0;
        for (const [officeId, score] of officeHits) {
          if (score > bestScore) {
            bestScore = score;
            bestOfficeId = officeId;
          }
        }
        if (bestOfficeId != null) pushTo(leadingByOfficeId, bestOfficeId, leading);
      } else {
        pushTo(leadingByTitle, `${level}|${name}`, leading);
      }
    }

    for (const groups of [...Object.values(stateGroups), ...Object.values(countyGroups).flatMap((g) => [g.county, g.city])]) {
      for (const office of groups) {
        let leading: LeadingResult[] | undefined;
        if (office.level === 'wy_senate' || office.level === 'wy_house') {
          leading = leadingByDistrict.get(`${office.level}|${office.district}`);
        } else if (office.level === 'county' || office.level === 'city') {
          leading = leadingByOfficeId.get(office.id);
        } else {
          leading = leadingByTitle.get(`${office.level}|${office.title}`);
        }
        if (leading && leading.length > 0) leadingByOffice.set(office.id, leading);
      }
    }
  } catch {
    dbError = true;
  }
}

const sortedCounties = Object.keys(countyGroups).sort();

function officeName(row: RaceRow): string {
  return row.district ? `${row.title} — District ${row.district}` : row.title;
}

function leadingLabel(results: LeadingResult[], r: LeadingResult): string {
  // Only prefix with a party abbreviation when the office actually has more
  // than one party's contest to distinguish. An uncontested or
  // single-party office doesn't need "R:" cluttering its one result.
  const prefix = results.length > 1 && r.party ? `${r.partyShortLabel || r.party}: ` : '';
  return `${prefix}${r.name} (${r.pct.toFixed(1)}%)`;
}

function candidateLabel(n: number): string {
  return `${n} filed ${n === 1 ? 'candidate' : 'candidates'}`;
}
---

<Base title="Browse Races" currentPath="/races">
  <section class="races-hero">
    <p class="eyebrow">Wyoming 2026 Primary</p>
    <h1>Browse all races.</h1>
    <p class="lede">
      {totalRaces > 0 ? `${totalRaces} offices` : 'Offices'} on the 2026 primary ballot. Select a race to see filed candidates.
      Or <a href="/">enter your address</a> to see only the races on your specific ballot.
    </p>
  </section>

  {dbError && (
    <p class="error-note">Race data could not be loaded. Please try again.</p>
  )}

  {leadingByOffice.size === 0 && (
    <p class="results-note" role="status">
      {pollsHaveClosed
        ? 'Polls have closed. Results will appear on each race below as county data is collected, this can take time on election night.'
        : `Results will appear on each race below after polls close${pollsCloseAt ? ` at ${pollsCloseAt.toLocaleString('en-US', { timeZone: 'America/Denver', dateStyle: 'long', timeStyle: 'short' })} Mountain Time` : ''}, and will keep updating as county data is collected.`}
    </p>
  )}

  {STATE_LEVEL_ORDER.filter((level) => stateGroups[level]?.length > 0).map((level) => (
    <section class="level-group" aria-labelledby={`level-${level}`}>
      <h2 id={`level-${level}`} class="level-heading">{STATE_LEVEL_LABELS[level]}</h2>
      <ul class="race-grid" role="list">
        {stateGroups[level].map((office) => (
          <li>
            <a href={`/race/${office.id}`} class="race-card">
              <span class="race-card__name">{officeName(office)}</span>
              <span class="race-card__count">{candidateLabel(Number(office.candidate_count))}</span>
              {leadingByOffice.get(office.id)?.map((r) => (
                <span class="race-card__leading">Leading: {leadingLabel(leadingByOffice.get(office.id)!, r)}</span>
              ))}
              <span class="race-card__cta" aria-hidden="true">View candidates →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {sortedCounties.map((county) => {
    const groups = countyGroups[county];
    const hasBoth = groups.county.length > 0 && groups.city.length > 0;
    const totalInCounty = groups.county.length + groups.city.length;
    const countyId = `county-${county.toLowerCase().replace(/\s+/g, '-')}`;
    return (
      <section class="level-group" aria-labelledby={countyId}>
        <h2 id={countyId} class="level-heading county-heading">
          {county} County
          <span class="level-heading__meta">{totalInCounty} {totalInCounty === 1 ? 'race' : 'races'}</span>
        </h2>

        {hasBoth && <h3 class="sublevel-heading">County offices</h3>}
        {groups.county.length > 0 && (
          <ul class="race-grid" role="list">
            {groups.county.map((office) => (
              <li>
                <a href={`/race/${office.id}`} class="race-card">
                  <span class="race-card__name">{officeName(office)}</span>
                  <span class="race-card__count">{candidateLabel(Number(office.candidate_count))}</span>
                  {leadingByOffice.get(office.id)?.map((r) => (
                    <span class="race-card__leading">Leading: {leadingLabel(leadingByOffice.get(office.id)!, r)}</span>
                  ))}
                  <span class="race-card__cta" aria-hidden="true">View candidates →</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {hasBoth && <h3 class="sublevel-heading">Municipal offices</h3>}
        {groups.city.length > 0 && (
          <ul class="race-grid" role="list">
            {groups.city.map((office) => (
              <li>
                <a href={`/race/${office.id}`} class="race-card race-card--municipal">
                  <span class="race-card__name">{officeName(office)}</span>
                  <span class="race-card__count">{candidateLabel(Number(office.candidate_count))}</span>
                  {leadingByOffice.get(office.id)?.map((r) => (
                    <span class="race-card__leading">Leading: {leadingLabel(leadingByOffice.get(office.id)!, r)}</span>
                  ))}
                  <span class="race-card__cta" aria-hidden="true">View candidates →</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</Base>

<style>
  .races-hero {
    padding: 52px 0 36px;
    max-width: 680px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.95;
  }

  .lede {
    margin: 20px 0 0;
    font-size: 1.1rem;
    max-width: 560px;
  }

  .lede a {
    color: var(--ember);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .error-note {
    padding: 16px;
    border: 1px solid var(--ember);
    color: var(--ember-dark);
    font-weight: 700;
  }

  .results-note {
    margin: 0 0 32px;
    padding: 16px 20px;
    border: 2px solid var(--ember);
    border-left: 8px solid var(--ember);
    background: color-mix(in srgb, var(--ember) 10%, var(--bone));
    color: var(--charcoal);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .level-group {
    margin-top: 48px;
  }

  .level-heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 16px;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rust);
    border-bottom: 2px solid var(--dust);
    padding-bottom: 8px;
  }

  .county-heading {
    color: var(--charcoal);
    border-bottom-color: var(--sandstone);
    border-bottom-width: 3px;
  }

  .level-heading__meta {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--dust);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .sublevel-heading {
    margin: 20px 0 10px;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--rust);
  }

  .race-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .race-card {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--dust);
    border-left: 4px solid var(--ember);
    background: var(--bone);
    text-decoration: none;
    transition: border-color 0.1s, box-shadow 0.1s;
  }

  .race-card:hover,
  .race-card:focus-visible {
    border-color: var(--ember);
    box-shadow: 0 4px 0 var(--sandstone);
    outline: none;
  }

  .race-card--municipal {
    border-left-color: var(--sandstone);
  }

  .race-card--municipal:hover,
  .race-card--municipal:focus-visible {
    border-color: var(--sandstone);
    box-shadow: 0 4px 0 var(--dust);
  }

  .race-card__name {
    font-family: 'Bitter', 'Merriweather', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .race-card__count {
    font-size: 0.85rem;
    color: var(--rust);
    font-weight: 700;
  }

  .race-card__leading {
    display: inline-block;
    width: fit-content;
    margin-top: 2px;
    padding: 2px 8px;
    border-radius: 3px;
    background: var(--sage);
    color: var(--bone);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .race-card__cta {
    margin-top: 6px;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--ember);
  }

  @media (max-width: 620px) {
    .races-hero {
      padding-top: 28px;
    }

    .race-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
