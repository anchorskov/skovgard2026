{
  "name": "skovgard-candidates",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "rubric:build": "node scripts/build-rubric.mjs",
    "rubric:check": "node scripts/build-rubric.mjs --check",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name=skovgard-candidates",
    "db:migrate:local": "wrangler d1 execute wy --file=db/migrations/0001_candidates_schema.sql",
    "db:migrate:prod": "wrangler d1 execute wy --remote --file=db/migrations/0001_candidates_schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "tailwindcss": "^4.3.1",
    "wrangler": "^4.106.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
