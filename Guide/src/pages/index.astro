---
// Guide/src/pages/index.astro
import Base from '../layouts/Base.astro';
---

<Base title="Wyoming 2026 Candidate Guide" currentPath="/">
  <div class="py-12 text-center">
    <h1 class="text-3xl font-bold text-wy-charcoal mb-4">Wyoming 2026 Candidate Guide</h1>
    <p class="text-lg text-wy-dust max-w-xl mx-auto">
      Independent candidate evaluations and endorsements for the Wyoming 2026 primary.
      Profiles and endorsements coming soon.
    </p>
    <a
      href="https://candidates.skovgard2026.org"
      class="inline-block mt-8 px-6 py-3 bg-wy-ember text-white rounded font-medium hover:bg-wy-ember-dark transition-colors"
    >
      Browse all candidates →
    </a>
  </div>
</Base>
